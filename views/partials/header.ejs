<!DOCTYPE html>
<html lang="en" class="h-full">
<head>
<meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1.0">
<title><%= typeof title !== 'undefined' ? title + ' - ' : '' %>RoleNova ATS</title>
<script src="https://cdn.tailwindcss.com"></script><script src="/js/rolenova-theme.js"></script>
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css"><script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
<script>window.clerkPublishableKey="<%= CLERK_PUBLISHABLE_KEY %>";</script>
<script async crossorigin="anonymous" data-clerk-publishable-key="<%= CLERK_PUBLISHABLE_KEY %>" src="https://cdn.jsdelivr.net/npm/@clerk/clerk-js@5/dist/clerk.browser.js" type="text/javascript"></script>
<script>
async function initClerk(){if(!window.Clerk){setTimeout(initClerk,50);return;}try{if(typeof window.Clerk.load==='function')await window.Clerk.load();const userButton=document.getElementById('user-button');if(userButton&&window.Clerk.user&&typeof window.Clerk.mountUserButton==='function')window.Clerk.mountUserButton(userButton);}catch(error){console.error('Clerk init failed',error);}finally{window.clerkReady=true;window.dispatchEvent(new Event('clerk-ready'));}}initClerk();
function toggleSidebar(){const sidebar=document.getElementById('sidebar'),overlay=document.getElementById('sidebarOverlay');if(!sidebar||!overlay)return;const isOpen=sidebar.classList.contains('translate-x-0');if(isOpen){sidebar.classList.remove('translate-x-0');sidebar.classList.add('-translate-x-full');overlay.classList.add('opacity-0');setTimeout(()=>overlay.classList.add('hidden'),300);}else{sidebar.classList.remove('-translate-x-full');sidebar.classList.add('translate-x-0');overlay.classList.remove('hidden');setTimeout(()=>overlay.classList.remove('opacity-0'),10);}}
document.addEventListener('keydown',e=>{if(e.key==='Escape'){const sidebar=document.getElementById('sidebar');if(sidebar&&sidebar.classList.contains('translate-x-0')&&window.innerWidth<1024)toggleSidebar();}});
</script>
<script src="/js/main.js"></script><link rel="stylesheet" href="/css/rolenova-theme.css">
</head>
<body class="h-full flex overflow-hidden font-sans text-text antialiased bg-bg relative">
<div id="sidebarOverlay" class="fixed inset-0 bg-gray-900/50 z-20 hidden lg:hidden transition-opacity duration-300 opacity-0" onclick="toggleSidebar()"></div>
<%- include('sidebar') %><%- include('llmTesterModal') %>
<div class="flex-1 flex flex-col w-0 overflow-hidden relative z-0">
<header class="bg-surface shadow-sm border-b border-border h-16 flex items-center px-4 lg:px-6 justify-between flex-shrink-0 z-10 w-full">
<div class="flex items-center gap-3"><button onclick="toggleSidebar()" class="lg:hidden text-textMuted hover:text-text focus:outline-none p-2 rounded-md hover:bg-secondary transition min-h-[44px] min-w-[44px] flex items-center justify-center" aria-label="Toggle Sidebar"><i class="fas fa-bars text-lg"></i></button><div class="lg:hidden font-bold text-xl text-primary flex items-center gap-2"><i class="fas fa-layer-group"></i>RoleNova</div><h1 class="hidden lg:block text-xl font-semibold text-text"><%= typeof title !== 'undefined' ? title : 'Dashboard' %></h1></div>
<div class="flex items-center space-x-3 lg:space-x-4"><button class="text-textMuted hover:text-text p-2 rounded-full hover:bg-secondary transition min-h-[44px] min-w-[44px] flex items-center justify-center" aria-label="Notifications"><i class="fas fa-bell"></i></button><div id="user-button"></div></div>
</header>
<main class="flex-1 overflow-y-auto bg-bg p-4 md:p-6"><div class="max-w-7xl mx-auto space-y-6 fade-in">
