<%- include('partials/header') %>

<div class="mb-6 flex flex-col md:flex-row md:items-center justify-between gap-4">
    <div>
        <h2 class="text-2xl font-bold text-gray-900"><%= title %></h2>
        <p class="text-gray-500 text-sm mt-1">Review AI-matched jobs. Only roles scoring above threshold are shown.</p>
    </div>
    
    <!-- Controls -->
    <div class="flex gap-2">
        <div class="relative">
            <i class="fas fa-search absolute left-3 top-3 text-gray-400"></i>
            <input type="text" id="searchInput" onkeyup="filterJobs()" placeholder="Search roles or companies..." class="pl-10 pr-4 py-2 border border-gray-300 rounded-md text-sm focus:ring-primary focus:border-primary w-64">
        </div>
    </div>
</div>

<div class="bg-white rounded-xl shadow-sm border border-gray-100 overflow-hidden">
    <% if (jobs.length === 0) { %>
        <div class="p-12 text-center text-gray-500 flex flex-col items-center">
            <i class="fas fa-folder-open text-5xl mb-4 text-gray-300"></i>
            <p class="text-lg font-medium text-gray-900">No jobs found</p>
            <p>Try running the job search pipeline or checking back later.</p>
        </div>
    <% } else { %>
        <div class="overflow-x-auto">
            <table class="min-w-full divide-y divide-gray-200">
                <thead class="bg-gray-50">
                    <tr>
                        <th scope="col" class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Role & Company</th>
                        <th scope="col" class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Score</th>
                        <th scope="col" class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Location</th>
                        <th scope="col" class="px-6 py-3 text-right text-xs font-medium text-gray-500 uppercase tracking-wider">Actions</th>
                    </tr>
                </thead>
                <tbody class="bg-white divide-y divide-gray-100" id="jobsTableBody">
                    <% jobs.forEach(function(job) { %>
                        <tr class="hover:bg-gray-50 transition job-row">
                            <td class="px-6 py-4 whitespace-nowrap">
                                <div class="flex items-center">
                                    <% 
                                        let domain = 'example.com';
                                        if (job.company && job.company.careerUrl) {
                                            try {
                                                const url = new URL(job.company.careerUrl);
                                                domain = url.hostname.replace('www.', '');
                                            } catch(e) {}
                                        }
                                    %>
                                    <div class="flex-shrink-0 h-10 w-10 bg-white rounded-md flex items-center justify-center border border-gray-200 overflow-hidden">
                                        <img src="https://logo.clearbit.com/<%= domain %>" 
                                             onerror="this.onerror=null; this.src='data:image/svg+xml;utf8,<svg xmlns=\'http://www.w3.org/2000/svg\' fill=\'%236b7280\' viewBox=\'0 0 24 24\'><path d=\'M12 2L2 7l10 5 10-5-10-5zm0 7.5l-10-5V17l10 5 10-5V4.5l-10 5z\'/></svg>';" 
                                             class="h-6 w-6 object-contain" alt="Logo">
                                    </div>
                                    <div class="ml-4">
                                        <div class="text-sm font-medium text-gray-900 job-title"><%= job.role %></div>
                                        <div class="text-sm text-gray-500 job-company"><%= (job.company && job.company.name) ? job.company.name : 'Unknown' %></div>
                                    </div>
                                </div>
                            </td>
                            <td class="px-6 py-4 whitespace-nowrap">
                                <div class="flex items-center">
                                    <% 
                                        let scoreColor = "bg-green-100 text-green-800";
                                        if (job.score < 70) scoreColor = "bg-yellow-100 text-yellow-800";
                                        if (job.score < 40) scoreColor = "bg-red-100 text-red-800";
                                    %>
                                    <span class="px-2.5 py-0.5 inline-flex text-xs leading-5 font-semibold rounded-full <%= scoreColor %>">
                                        <%= job.score %>/100
                                    </span>
                                </div>
                            </td>
                            <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500">
                                <%= job.location || 'Remote' %>
                            </td>
                            <td class="px-6 py-4 whitespace-nowrap text-right text-sm font-medium space-x-2">
                                <a href="/job/<%= job._id %>" class="text-primary hover:text-primaryHover bg-blue-50 px-3 py-1 rounded-md transition">Details</a>
                                
                                <% if(job.status !== 'saved') { %>
                                    <button onclick="updateStatus('<%= job._id %>', 'saved')" class="text-gray-600 hover:text-gray-900 bg-gray-100 px-3 py-1 rounded-md transition" title="Save for later">
                                        <i class="far fa-bookmark"></i>
                                    </button>
                                <% } %>
                                
                                <% if(job.status !== 'applied') { %>
                                    <button onclick="updateStatus('<%= job._id %>', 'applied')" class="text-green-600 hover:text-green-900 bg-green-50 px-3 py-1 rounded-md transition" title="Mark as applied">
                                        <i class="fas fa-check"></i>
                                    </button>
                                <% } %>
                                
                                <% if(job.status !== 'rejected') { %>
                                    <button onclick="updateStatus('<%= job._id %>', 'rejected')" class="text-red-600 hover:text-red-900 bg-red-50 px-3 py-1 rounded-md transition" title="Reject">
                                        <i class="fas fa-times"></i>
                                    </button>
                                <% } %>
                            </td>
                        </tr>
                    <% }); %>
                </tbody>
            </table>
        </div>
    <% } %>
</div>

<script>
    function filterJobs() {
        const input = document.getElementById('searchInput').value.toLowerCase();
        const rows = document.querySelectorAll('.job-row');
        
        rows.forEach(row => {
            const title = row.querySelector('.job-title').textContent.toLowerCase();
            const company = row.querySelector('.job-company').textContent.toLowerCase();
            
            if (title.includes(input) || company.includes(input)) {
                row.style.display = '';
            } else {
                row.style.display = 'none';
            }
        });
    }

    async function updateStatus(id, status) {
        try {
            const res = await fetch(`/api/jobs/${id}/status`, {
                method: "PATCH",
                headers: { "Content-Type": "application/json" },
                body: JSON.stringify({ status })
            });
            const data = await res.json();
            if (data.success) {
                // simple reload to refresh list based on current active tab
                window.location.reload();
            } else {
                alert("Failed to update status");
            }
        } catch (e) {
            alert("Error updating status");
        }
    }
</script>

<%- include('partials/footer') %>
