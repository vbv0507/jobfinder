<%- include('partials/header') %>

<div class="mb-6 flex flex-col md:flex-row md:items-center justify-between gap-4">
    <div>
        <h2 class="text-2xl font-bold text-gray-900"><%= title %></h2>
        <p class="text-gray-500 text-sm mt-1">Review AI-matched jobs. Only roles scoring above threshold are shown.</p>
    </div>
    
    <!-- Controls -->
    <div class="flex gap-2">
        <div class="relative">
            <i class="fas fa-search absolute left-3 top-3 text-gray-400 mt-0.5"></i>
            <input type="text" id="searchInput" onkeyup="filterJobs()" placeholder="Search roles or companies..." class="pl-10 pr-4 py-2 border border-gray-300 rounded-md text-sm focus:ring-primary focus:border-primary w-full md:w-64 min-h-[44px]">
        </div>
    </div>
</div>

<div class="bg-white rounded-xl shadow-sm border border-gray-100 overflow-hidden">
    <% if (jobs.length === 0) { %>
        <div class="p-12 text-center text-gray-500 flex flex-col items-center">
            <i class="fas fa-folder-open text-5xl mb-4 text-gray-300"></i>
            <p class="text-lg font-medium text-gray-900">No jobs found</p>
            <p>Try running the job search pipeline or checking back later.</p>
        </div>
    <% } else { %>
        <div class="overflow-hidden sm:overflow-x-auto">
            <table class="min-w-full divide-y divide-gray-200">
                <thead class="bg-gray-50 hidden md:table-header-group">
                    <tr>
                        <th scope="col" class="px-4 md:px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Role & Company</th>
                        <th scope="col" class="px-4 md:px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Score</th>
                        <th scope="col" class="px-4 md:px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Location</th>
                        <th scope="col" class="px-4 md:px-6 py-3 text-right text-xs font-medium text-gray-500 uppercase tracking-wider">Actions</th>
                    </tr>
                </thead>
                <tbody class="bg-white divide-y divide-gray-100" id="jobsTableBody">
                    <% jobs.forEach(function(job) { %>
                        <tr class="hover:bg-gray-50 transition job-row flex flex-col md:table-row border-b md:border-b-0 border-gray-100 p-4 md:p-0">
                            <td class="md:px-6 md:py-4 md:whitespace-nowrap flex items-center justify-between md:table-cell mb-2 md:mb-0">
                                <div class="flex items-center">
                                    <div class="flex-shrink-0 h-10 w-10 bg-white rounded-md flex items-center justify-center border border-gray-200 overflow-hidden">
                                        <img src="<%= getCompanyLogo(job.company && job.company.name ? job.company.name : 'Unknown') %>" 
                                             class="h-6 w-6 object-contain" alt="Logo" loading="lazy" width="40" height="40">
                                    </div>
                                    <div class="ml-4">
                                        <div class="text-sm font-medium text-gray-900 job-title"><%= job.role %></div>
                                        <div class="text-sm text-gray-500 job-company"><%= (job.company && job.company.name) ? job.company.name : 'Unknown' %></div>
                                    </div>
                                </div>
                            </td>
                            <td class="md:px-6 md:py-4 md:whitespace-nowrap flex items-center justify-between md:table-cell mb-2 md:mb-0">
                                <span class="md:hidden text-xs font-medium text-gray-500 uppercase">Score</span>
                                <div class="flex items-center">
                                    <% 
                                        let scoreColor = "bg-green-100 text-green-800";
                                        if (job.score < 70) scoreColor = "bg-yellow-100 text-yellow-800";
                                        if (job.score < 40) scoreColor = "bg-red-100 text-red-800";
                                    %>
                                    <span class="px-2.5 py-0.5 inline-flex text-xs leading-5 font-semibold rounded-full <%= scoreColor %>">
                                        <%= job.score %>/100
                                    </span>
                                    <% 
                                        let aiColor = "bg-green-100 text-green-800";
                                        let aiIcon = "🟢";
                                        let aiName = job.provider ? (job.provider.charAt(0).toUpperCase() + job.provider.slice(1)) : (job.evaluatedBy || 'Gemini');
                                        if (job.provider === 'groq' || job.evaluatedBy === 'Groq') { aiColor = "bg-orange-100 text-orange-800"; aiIcon = "🟠"; }
                                        if (job.provider === 'local' || job.provider === 'unknown' || job.evaluatedBy === 'Local') { aiColor = "bg-gray-100 text-gray-800"; aiIcon = "⚪"; }
                                    %>
                                    <span class="ml-2 px-2 py-0.5 inline-flex text-[10px] leading-4 font-semibold rounded-full <%= aiColor %> whitespace-nowrap" title="Evaluated by <%= aiName %>">
                                        <%= aiIcon %> <%= aiName %>
                                    </span>
                                </div>
                            </td>
                            <td class="md:px-6 md:py-4 md:whitespace-nowrap text-sm text-gray-500 flex items-center justify-between md:table-cell mb-4 md:mb-0">
                                <span class="md:hidden text-xs font-medium text-gray-500 uppercase">Location</span>
                                <span><%= job.location || 'Remote' %></span>
                            </td>
                            <td class="md:px-6 md:py-4 md:whitespace-nowrap text-right text-sm font-medium flex items-center justify-end gap-2 md:table-cell">
                                <a href="/job/<%= job._id %>" class="text-primary hover:text-primaryHover bg-blue-50 px-3 py-2 md:py-1 rounded-md transition min-h-[36px] md:min-h-0 flex items-center">Details</a>
                                
                                <% if(job.status !== 'saved') { %>
                                    <button onclick="updateStatus('<%= job._id %>', 'saved')" class="text-gray-600 hover:text-gray-900 bg-gray-100 px-3 py-2 md:py-1 rounded-md transition min-h-[36px] md:min-h-0 flex items-center" title="Save for later">
                                        <i class="far fa-bookmark"></i>
                                    </button>
                                <% } %>
                                
                                <% if(job.status !== 'applied') { %>
                                    <button onclick="updateStatus('<%= job._id %>', 'applied')" class="text-green-600 hover:text-green-900 bg-green-50 px-3 py-2 md:py-1 rounded-md transition min-h-[36px] md:min-h-0 flex items-center" title="Mark as applied">
                                        <i class="fas fa-check"></i>
                                    </button>
                                <% } %>
                                
                                <% if(job.status !== 'rejected') { %>
                                    <button onclick="updateStatus('<%= job._id %>', 'rejected')" class="text-red-600 hover:text-red-900 bg-red-50 px-3 py-2 md:py-1 rounded-md transition min-h-[36px] md:min-h-0 flex items-center" title="Reject">
                                        <i class="fas fa-times"></i>
                                    </button>
                                <% } %>
                            </td>
                        </tr>
                    <% }); %>
                </tbody>
            </table>
        </div>
    <% } %>
</div>

<script>
    function filterJobs() {
        const input = document.getElementById('searchInput').value.toLowerCase();
        const rows = document.querySelectorAll('.job-row');
        
        rows.forEach(row => {
            const title = row.querySelector('.job-title').textContent.toLowerCase();
            const company = row.querySelector('.job-company').textContent.toLowerCase();
            
            if (title.includes(input) || company.includes(input)) {
                row.style.display = '';
            } else {
                row.style.display = 'none';
            }
        });
    }

    async function updateStatus(id, status) {
        try {
            const res = await fetch(`/api/jobs/${id}/status`, {
                method: "PATCH",
                headers: { "Content-Type": "application/json" },
                body: JSON.stringify({ status })
            });
            const data = await res.json();
            if (data.success) {
                // simple reload to refresh list based on current active tab
                window.location.reload();
            } else {
                alert("Failed to update status");
            }
        } catch (e) {
            alert("Error updating status");
        }
    }
</script>

<%- include('partials/footer') %>
