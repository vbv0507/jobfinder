<%- include('../partials/header', { title: 'Pipeline Timeline' }) %>

<div class="mb-6">
    <h2 class="text-2xl font-bold text-gray-900">Pipeline Timeline</h2>
    <p class="text-gray-500 text-sm mt-1">Recent 50 pipeline executions.</p>
</div>

<div class="bg-white rounded-xl shadow-sm border border-gray-100 overflow-hidden">
    <table class="min-w-full divide-y divide-gray-200">
        <thead class="bg-gray-50">
            <tr>
                <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">Started</th>
                <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">Duration (s)</th>
                <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">Status</th>
                <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">Jobs Found</th>
                <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">Evaluations</th>
                <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">Matches</th>
                <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">Provider</th>
            </tr>
        </thead>
        <tbody id="timelineBody" class="bg-white divide-y divide-gray-200">
            <!-- Populated via JS -->
        </tbody>
    </table>
</div>

<script>
    async function loadTimeline() {
        try {
            const res = await fetch('/api/system/timeline');
            const logs = await res.json();
            const tbody = document.getElementById('timelineBody');
            tbody.innerHTML = logs.map(log => `
                <tr>
                    <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-900">${new Date(log.createdAt).toLocaleString()}</td>
                    <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500">${log.durationMs ? (log.durationMs/1000).toFixed(1) : '-'}</td>
                    <td class="px-6 py-4 whitespace-nowrap">
                        <span class="px-2 inline-flex text-xs leading-5 font-semibold rounded-full ${log.status === 'Success' ? 'bg-green-100 text-green-800' : 'bg-red-100 text-red-800'}">
                            ${log.status || 'Unknown'}
                        </span>
                    </td>
                    <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500">${log.jobsFound || 0}</td>
                    <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500">${log.aiEvaluations || 0}</td>
                    <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500">${log.jobsMatched || 0}</td>
                    <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500">${log.aiProviderUsed || 'N/A'}</td>
                </tr>
            `).join('');
        } catch (e) {
            console.error(e);
        }
    }
    loadTimeline();
    setInterval(loadTimeline, 30000);
</script>
<%- include('../partials/footer') %>
