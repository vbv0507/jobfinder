                let color = 'gray';
                if (p.status === 'Ready' || p.status === 'Working') color = 'green';
                if (p.status === 'Rate Limited') color = 'yellow';
                if (p.status === 'Unavailable' || p.status === 'Down') color = 'red';

                return `
