<%- include('../partials/header', { title: 'Configuration Dashboard' }) %>

<div class="mb-6">
    <h2 class="text-2xl font-bold text-gray-900 dark:text-gray-100">System Configuration</h2>
    <p class="text-gray-500 dark:text-gray-400 text-sm mt-1">Environment and runtime variables.</p>
</div>

<div class="bg-white dark:bg-gray-800 rounded-xl shadow-sm border border-gray-100 dark:border-gray-700 p-6">
    <dl class="grid grid-cols-1 md:grid-cols-2 gap-x-4 gap-y-6" id="configList">
        <!-- Populated via JS -->
    </dl>
</div>

<script>
    async function loadConfig() {
        if (!window.Clerk) {
            setTimeout(loadConfig, 100);
            return;
        }

        if (typeof window.Clerk.addListener === 'function' && typeof window.Clerk.session === 'undefined') {
            let fired = false;
            window.Clerk.addListener((state) => {
                if (fired) return;
                if (state.session !== undefined) {
                    fired = true;
                    executeLoadConfig();
                }
            });
            return;
        }

        executeLoadConfig();
    }

    async function executeLoadConfig() {
        try {
            const config = await apiCall('/admin/api/config');
            document.getElementById('MATCH_THRESHOLD').value = config.MATCH_THRESHOLD || 65;
            document.getElementById('MAX_JOBS_PER_COMPANY').value = config.MAX_JOBS_PER_COMPANY || 100;
            document.getElementById('MAX_AI_EVALUATIONS_PER_RUN').value = config.MAX_AI_EVALUATIONS_PER_RUN || 10;
        } catch (error) {
            console.error('Failed to load config:', error);
        }
    }
    
    loadConfig();
</script>
<%- include('../partials/footer') %>
