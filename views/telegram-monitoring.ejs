<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %></title>
    <!-- Use standard bootstrap for quick dashboard styling -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css" rel="stylesheet">
    <style>
        body { background-color: #f8f9fa; }
        .card { border: none; border-radius: 10px; box-shadow: 0 4px 6px rgba(0,0,0,0.05); margin-bottom: 20px; }
        .stat-card { text-align: center; padding: 20px; }
        .stat-value { font-size: 2rem; font-weight: bold; color: #0d6efd; }
        .stat-label { font-size: 0.9rem; color: #6c757d; text-transform: uppercase; letter-spacing: 1px; }
        .status-badge { font-size: 0.9rem; padding: 5px 10px; border-radius: 20px; }
        .status-connected { background-color: #d1e7dd; color: #0f5132; }
        .status-disconnected { background-color: #f8d7da; color: #842029; }
        .status-connecting { background-color: #fff3cd; color: #664d03; }
        
        .table th { background-color: #f1f3f5; font-weight: 600; }
    </style>
    <script src="/js/main.js"></script>
</head>
<body>

<nav class="navbar navbar-expand-lg navbar-dark bg-dark mb-4">
    <div class="container-fluid">
        <a class="navbar-brand" href="/">RoleNova</a>
        <div class="collapse navbar-collapse">
            <ul class="navbar-nav me-auto">
                <li class="nav-item"><a class="nav-link" href="/jobs">Jobs</a></li>
                <li class="nav-item"><a class="nav-link" href="/analytics">Analytics</a></li>
                <li class="nav-item"><a class="nav-link" href="/telegram">Channels</a></li>
                <li class="nav-item"><a class="nav-link active" href="/telegram-monitoring">Monitoring</a></li>
            </ul>
        </div>
    </div>
</nav>

<div class="container">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2>Telegram Listener Health</h2>
        <div>
            <button class="btn btn-outline-primary me-2" onclick="reloadChannels()"><i class="fas fa-sync"></i> Reload Channels</button>
            <button class="btn btn-outline-danger" onclick="reconnectListener()"><i class="fas fa-plug"></i> Force Reconnect</button>
        </div>
    </div>

    <!-- Listener Status Cards -->
    <div class="row">
        <div class="col-md-3">
            <div class="card stat-card">
                <div class="stat-label mb-2">Connection Status</div>
                <div id="connStatusBadge" class="status-badge d-inline-block">Loading...</div>
                <div class="mt-3 small text-muted" id="connDetails">Layer: -- | DC: --</div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card stat-card">
                <div class="stat-label mb-2">Uptime</div>
                <div id="uptimeVal" class="stat-value">--</div>
                <div class="mt-2 small text-muted" id="lastConnectedTime">Since: --</div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card stat-card">
                <div class="stat-label mb-2">Messages Today</div>
                <div id="messagesTodayVal" class="stat-value">--</div>
                <div class="mt-2 small text-muted">Total processed today</div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card stat-card">
                <div class="stat-label mb-2">Jobs Extracted</div>
                <div id="jobsParsedVal" class="stat-value text-success">--</div>
                <div class="mt-2 small text-muted">Matches Today: <span id="matchesTodayVal">--</span></div>
            </div>
        </div>
    </div>

    <!-- System Telemetry from Health API -->
    <div class="row mb-4" id="telemetryCards">
        <!-- Populated via JS -->
    </div>

    <!-- Channels Table -->
    <div class="card p-3">
        <h5 class="mb-3">Active Channels Matrix</h5>
        <div class="bg-white rounded-xl shadow-sm border border-gray-100 overflow-x-auto w-full">
            <table class="table table-hover align-middle min-w-full">
                <thead>
                    <tr>
                        <th>Channel</th>
                        <th>Status</th>
                        <th>Processed</th>
                        <th>Jobs</th>
                        <th>Matches</th>
                        <th>Ignored</th>
                        <th>Errors</th>
                        <th>Last Message</th>
                    </tr>
                </thead>
                <tbody id="channelsTableBody">
                    <tr><td colspan="8" class="text-center">Loading...</td></tr>
                </tbody>
            </table>
        </div>
    </div>
</div>

<script>
    async function fetchData() {
        try {
            const [statusRes, statsRes, channelsRes] = await Promise.all([
                apiCall('/api/telegram/status'),
                apiCall('/api/telegram/statistics'),
                apiCall('/api/telegram/channels')
            ]);
            
            const statusData = statusRes;
            const statsData = statsRes;
            const channelsData = channelsRes;

            updateStatus(statusData.status);
            updateStats(statsData.statistics);
            
            // Fetch new telemetry
            const healthRes = await apiCall('/api/system/health');
            const metricsRes = await apiCall('/api/system/metrics');
            if(healthRes && metricsRes) {
                const h = healthRes;
                const m = metricsRes;
                document.getElementById('telemetryCards').innerHTML = `
                    <div class="col-md-3"><div class="card stat-card"><div class="stat-label">Listener Registered</div><div class="stat-value text-primary">${h.telegram.listenerRegistered ? 'Yes' : 'No'}</div></div></div>
                    <div class="col-md-3"><div class="card stat-card"><div class="stat-label">Last Message</div><div class="stat-value text-primary" style="font-size:1.2rem">${h.telegram.lastMessageAt ? new Date(h.telegram.lastMessageAt).toLocaleTimeString() : 'N/A'}</div></div></div>
                    <div class="col-md-3"><div class="card stat-card"><div class="stat-label">Last Health Check</div><div class="stat-value text-primary" style="font-size:1.2rem">${h.telegram.lastHealthCheck ? new Date(h.telegram.lastHealthCheck).toLocaleTimeString() : 'N/A'}</div></div></div>
                    <div class="col-md-3"><div class="card stat-card"><div class="stat-label">Validation Failures</div><div class="stat-value text-danger">${m['Validation Failures'] || 0}</div></div></div>
                `;
            }
            updateChannels(channelsData.channels);
        } catch (e) {
            console.error("Failed to fetch monitoring data", e);
        }
    }

    function updateStatus(status) {
        const badge = document.getElementById('connStatusBadge');
        badge.innerText = status.status;
        badge.className = 'status-badge d-inline-block ' + 
            (status.status === 'Connected' ? 'status-connected' : 
            (status.status === 'Disconnected' || status.status === 'Error' ? 'status-disconnected' : 'status-connecting'));
        
        document.getElementById('connDetails').innerText = `Layer: ${status.layer} | DC: ${status.dc} | v${status.version}`;
        
        if (status.uptimeStart) {
            const start = new Date(status.uptimeStart);
            const diff = Math.floor((new Date() - start) / 1000);
            const hrs = Math.floor(diff / 3600);
            const mins = Math.floor((diff % 3600) / 60);
            document.getElementById('uptimeVal').innerText = `${hrs}h ${mins}m`;
            document.getElementById('lastConnectedTime').innerText = `Since: ${start.toLocaleTimeString()}`;
        }
    }

    function updateStats(stats) {
        document.getElementById('messagesTodayVal').innerText = stats.messagesToday || 0;
        document.getElementById('jobsParsedVal').innerText = stats.jobsParsedToday || 0;
        document.getElementById('matchesTodayVal').innerText = stats.matchedJobsToday || 0;
    }

    function updateChannels(channels) {
        const tbody = document.getElementById('channelsTableBody');
        tbody.innerHTML = '';
        
        if (!channels || channels.length === 0) {
            tbody.innerHTML = '<tr><td colspan="8" class="text-center">No channels configured.</td></tr>';
            return;
        }

        channels.forEach(ch => {
            const tr = document.createElement('tr');
            
            let statusHtml = `<span class="badge bg-secondary">Idle</span>`;
            if (ch.status === 'Online') statusHtml = `<span class="badge bg-success">Online</span>`;
            if (ch.status === 'Error') statusHtml = `<span class="badge bg-danger" title="${ch.lastError || ''}">Error</span>`;
            if (!ch.enabled) statusHtml = `<span class="badge bg-dark">Disabled</span>`;

            tr.innerHTML = `
                <td><strong>@${ch.username}</strong></td>
                <td>${statusHtml}</td>
                <td>${ch.messagesProcessed || 0}</td>
                <td>${ch.jobsFound || 0}</td>
                <td>${ch.matchedJobs || 0}</td>
                <td><span class="text-muted">${ch.ignoredMessages || 0}</span></td>
                <td>
                    <span class="${ch.parsingFailures > 0 || ch.errorCount > 0 ? 'text-danger fw-bold' : ''}">
                        ${ch.parsingFailures || 0} / ${ch.errorCount || 0}
                    </span>
                </td>
                <td>
                    <div class="small">
                        ${ch.lastMessageAt ? new Date(ch.lastMessageAt).toLocaleString() : 'Never'}
                    </div>
                </td>
            `;
            tbody.appendChild(tr);
        });
    }

    async function reloadChannels() {
        if(!confirm("Reload active channels from database?")) return;
        await apiCall('/api/telegram/reload', { method: 'POST' });
        fetchData();
    }

    async function reconnectListener() {
        if(!confirm("Force disconnect and reconnect Telegram client? This will reset uptime.")) return;
        document.getElementById('connStatusBadge').innerText = "Reconnecting...";
        document.getElementById('connStatusBadge').className = "status-badge status-connecting d-inline-block";
        await apiCall('/api/telegram/reconnect', { method: 'POST' });
        setTimeout(fetchData, 2000);
    }

    // Initial load and polling every 5 seconds
    fetchData();
    setInterval(fetchData, 5000);
</script>

</body>
</html>
