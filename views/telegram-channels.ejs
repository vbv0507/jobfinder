<%- include('partials/header', { title: 'Telegram Channels' }) %>

<div class="mb-6 flex flex-col md:flex-row justify-between md:items-end gap-4">
    <div>
        <h2 class="text-2xl font-bold text-gray-900">Telegram Channels</h2>
        <p class="text-gray-500 text-sm mt-1">Manage ingestion sources and monitor activity.</p>
    </div>
    <button onclick="document.getElementById('addChannelModal').classList.remove('hidden')" class="bg-primary hover:bg-primaryHover text-white px-4 py-2 rounded-lg font-medium transition shadow-sm flex items-center">
        <i class="fas fa-plus mr-2"></i> Add Channel
    </button>
</div>

<!-- Channels List -->
<div class="bg-white rounded-xl shadow-sm border border-gray-100 overflow-hidden">
    <div class="overflow-x-auto">
        <table class="w-full text-left text-sm text-gray-500">
            <thead class="bg-gray-50 text-gray-700 uppercase font-semibold border-b border-gray-100">
                <tr>
                    <th class="px-6 py-4">Channel</th>
                    <th class="px-6 py-4">Status</th>
                    <th class="px-6 py-4 text-center">Processed</th>
                    <th class="px-6 py-4 text-center">Jobs Found</th>
                    <th class="px-6 py-4 text-center">Matched</th>
                    <th class="px-6 py-4">Last Activity</th>
                    <th class="px-6 py-4 text-right">Actions</th>
                </tr>
            </thead>
            <tbody id="channelsTableBody" class="divide-y divide-gray-100">
                <tr>
                    <td colspan="7" class="px-6 py-8 text-center text-gray-500">Loading channels...</td>
                </tr>
            </tbody>
        </table>
    </div>
</div>

<!-- Add Channel Modal -->
<div id="addChannelModal" class="hidden fixed inset-0 bg-gray-900 bg-opacity-50 z-50 flex items-center justify-center">
    <div class="bg-white rounded-xl shadow-lg w-full max-w-md overflow-hidden">
        <div class="px-6 py-4 border-b border-gray-100 flex justify-between items-center">
            <h3 class="font-bold text-lg text-gray-900">Add Telegram Channel</h3>
            <button onclick="document.getElementById('addChannelModal').classList.add('hidden')" class="text-gray-400 hover:text-gray-600 transition">
                <i class="fas fa-times"></i>
            </button>
        </div>
        <form id="addChannelForm" class="p-6">
            <div class="mb-4">
                <label class="block text-sm font-medium text-gray-700 mb-1">Channel Name</label>
                <input type="text" id="chName" required class="w-full border border-gray-300 rounded-lg px-3 py-2 focus:ring-primary focus:border-primary">
            </div>
            <div class="mb-4">
                <label class="block text-sm font-medium text-gray-700 mb-1">Username / ID</label>
                <input type="text" id="chUsername" placeholder="e.g. OffCampusJobs" required class="w-full border border-gray-300 rounded-lg px-3 py-2 focus:ring-primary focus:border-primary">
            </div>
            <div class="mb-4">
                <label class="block text-sm font-medium text-gray-700 mb-1">Category</label>
                <select id="chCategory" class="w-full border border-gray-300 rounded-lg px-3 py-2 focus:ring-primary focus:border-primary">
                    <option value="General">General</option>
                    <option value="Software Engineering">Software Engineering</option>
                    <option value="Data Science">Data Science</option>
                    <option value="Remote">Remote</option>
                </select>
            </div>
            <div class="flex justify-end gap-3 mt-6">
                <button type="button" onclick="document.getElementById('addChannelModal').classList.add('hidden')" class="px-4 py-2 text-gray-600 bg-gray-100 hover:bg-gray-200 rounded-lg font-medium transition">Cancel</button>
                <button type="submit" class="px-4 py-2 bg-primary hover:bg-primaryHover text-white rounded-lg font-medium transition">Add Channel</button>
            </div>
        </form>
    </div>
</div>

<script>
    async function loadChannels() {
        try {
            const res = await fetch("/api/telegram/channels");
            const data = await res.json();
            const tbody = document.getElementById('channelsTableBody');
            
            if (data.success) {
                if (data.channels.length === 0) {
                    tbody.innerHTML = `<tr><td colspan="7" class="px-6 py-8 text-center text-gray-500">No Telegram channels configured.</td></tr>`;
                    return;
                }
                
                tbody.innerHTML = data.channels.map(c => `
                    <tr class="hover:bg-gray-50 transition">
                        <td class="px-6 py-4">
                            <div class="font-medium text-gray-900">${c.name}</div>
                            <div class="text-xs text-gray-500 mt-1">@${c.username}</div>
                        </td>
                        <td class="px-6 py-4">
                            <label class="relative inline-flex items-center cursor-pointer">
                                <input type="checkbox" onchange="toggleChannel('${c._id}', this.checked)" class="sr-only peer" ${c.enabled ? 'checked' : ''}>
                                <div class="w-9 h-5 bg-gray-200 peer-focus:outline-none rounded-full peer peer-checked:after:translate-x-full peer-checked:after:border-white after:content-[''] after:absolute after:top-[2px] after:left-[2px] after:bg-white after:border-gray-300 after:border after:rounded-full after:h-4 after:w-4 after:transition-all peer-checked:bg-green-500"></div>
                            </label>
                        </td>
                        <td class="px-6 py-4 text-center font-medium">${c.messagesProcessed}</td>
                        <td class="px-6 py-4 text-center text-blue-600 font-medium">${c.jobsFound}</td>
                        <td class="px-6 py-4 text-center text-green-600 font-bold">${c.matchedJobs}</td>
                        <td class="px-6 py-4 text-xs text-gray-500">
                            ${c.lastActivity ? new Date(c.lastActivity).toLocaleString() : 'Never'}
                        </td>
                        <td class="px-6 py-4 text-right">
                            <button onclick="deleteChannel('${c._id}')" class="text-red-500 hover:text-red-700 transition" title="Delete Channel">
                                <i class="fas fa-trash-alt"></i>
                            </button>
                        </td>
                    </tr>
                `).join('');
            }
        } catch (e) {
            document.getElementById('channelsTableBody').innerHTML = `<tr><td colspan="7" class="px-6 py-8 text-center text-red-500">Error loading channels.</td></tr>`;
        }
    }

    async function toggleChannel(id, enabled) {
        try {
            await fetch(`/api/telegram/channels/${id}/toggle`, {
                method: 'PATCH',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ enabled })
            });
        } catch(e) {
            alert('Failed to toggle channel status');
            loadChannels();
        }
    }

    async function deleteChannel(id) {
        if (!confirm('Are you sure you want to delete this channel?')) return;
        try {
            const res = await fetch(`/api/telegram/channels/${id}`, { method: 'DELETE' });
            if (res.ok) loadChannels();
        } catch(e) {
            alert('Failed to delete channel');
        }
    }

    document.getElementById('addChannelForm').addEventListener('submit', async (e) => {
        e.preventDefault();
        const payload = {
            name: document.getElementById('chName').value,
            username: document.getElementById('chUsername').value.replace('@', ''),
            category: document.getElementById('chCategory').value
        };
        try {
            const res = await fetch('/api/telegram/channels', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify(payload)
            });
            const data = await res.json();
            if (data.success) {
                document.getElementById('addChannelModal').classList.add('hidden');
                e.target.reset();
                loadChannels();
            } else {
                alert(data.message);
            }
        } catch (err) {
            alert('Failed to add channel');
        }
    });

    document.addEventListener("DOMContentLoaded", loadChannels);
</script>

<%- include('partials/footer') %>
