<!-- Sidebar -->
<%
    const isSuperAdmin = locals.user && locals.user.email && (locals.user.email.toLowerCase().includes('vbvrai1407') || locals.user.email.toLowerCase() === 'vbvrai1407@gmail.com');
    const sidebarIsAdmin = true;
    const sidebarHasExtendedAccess = true;
%>
<aside id="sidebar" class="fixed inset-y-0 left-0 z-50 w-[260px] bg-background border-r border-border transform -translate-x-full lg:translate-x-0 lg:static transition-transform duration-300 ease-[cubic-bezier(0.4,0,0.2,1)] flex flex-col h-screen">
    
    <!-- Logo Area -->
    <div class="h-14 flex items-center px-5 border-b border-border shrink-0">
        <div class="flex items-center gap-3 text-textMain font-bold text-lg tracking-tight">
            <div class="w-7 h-7 rounded-md bg-gradient-to-br from-primary to-primaryHover flex items-center justify-center shadow-lg shadow-primary/20">
                <i class="fa-solid fa-bolt text-white text-[10px]"></i>
            </div>
            RoleNova
        </div>
    </div>
    
    <!-- User / Workspace Info -->
    <div class="px-5 py-4 border-b border-border bg-surface/30 shrink-0">
        <div class="flex items-center gap-3">
            <div class="w-8 h-8 rounded-full <%= isSuperAdmin ? 'bg-purple-900/40 border-purple-500/40 text-purple-300' : 'bg-surface border-border text-primary' %> border flex items-center justify-center text-xs font-bold">
                <%= locals.user ? (locals.user.fullName?.[0] || locals.user.email?.[0] || 'U').toUpperCase() : 'U' %>
            </div>
            <div class="flex-1 min-w-0">
                <p class="text-sm font-medium text-textMain truncate"><%= locals.user ? (locals.user.fullName || locals.user.email) : 'User' %></p>
                <p class="text-[10px] <%= isSuperAdmin ? 'text-purple-400 font-bold' : 'text-cyan-400 font-semibold' %> uppercase tracking-wider flex items-center gap-1.5 mt-0.5">
                    <span class="w-1.5 h-1.5 rounded-full <%= isSuperAdmin ? 'bg-purple-400 animate-pulse' : 'bg-cyan-400' %>"></span>
                    <%= isSuperAdmin ? '👑 SUPER ADMIN' : 'ADMIN (1 RUN/DAY)' %>
                </p>
            </div>
        </div>
    </div>

    <!-- Navigation Area -->
    <div class="flex-1 overflow-y-auto py-4 custom-scrollbar">
        <nav class="space-y-6 px-3">
            
            <!-- Platform Section -->
            <div>
                <p class="px-3 mb-2 text-[10px] font-semibold text-textMuted uppercase tracking-widest">Platform</p>
                <div class="space-y-0.5">
                    <a href="/" class="nav-link flex items-center gap-3 px-3 py-2 rounded-md text-sm font-medium text-textMuted hover:text-textMain hover:bg-surface transition-colors">
                        <i class="fa-solid fa-chart-line w-4 text-center"></i>
                        Dashboard
                    </a>
                    <% if (sidebarIsAdmin) { %>
                    <a href="/pipeline" class="nav-link flex items-center gap-3 px-3 py-2 rounded-md text-sm font-medium text-textMuted hover:text-textMain hover:bg-surface transition-colors">
                        <i class="fa-solid fa-route w-4 text-center"></i>
                        Pipeline
                    </a>
                    <% } %>
                    <% if (sidebarHasExtendedAccess) { %>
                    <a href="/analytics" class="nav-link flex items-center gap-3 px-3 py-2 rounded-md text-sm font-medium text-textMuted hover:text-textMain hover:bg-surface transition-colors">
                        <i class="fa-solid fa-chart-pie w-4 text-center"></i>
                        Analytics
                    </a>
                    <% } %>
                </div>
            </div>

            <!-- Entities Section -->
            <% if (sidebarHasExtendedAccess) { %>
            <div>
                <p class="px-3 mb-2 text-[10px] font-semibold text-textMuted uppercase tracking-widest">Entities</p>
                <div class="space-y-0.5">
                    <a href="/companies" class="nav-link flex items-center gap-3 px-3 py-2 rounded-md text-sm font-medium text-textMuted hover:text-textMain hover:bg-surface transition-colors">
                        <i class="fa-regular fa-building w-4 text-center"></i>
                        Companies
                    </a>
                    <a href="/seed-companies" class="nav-link flex items-center gap-3 px-3 py-2 rounded-md text-sm font-medium text-textMuted hover:text-textMain hover:bg-surface transition-colors">
                        <i class="fa-solid fa-seedling w-4 text-center"></i>
                        Seed Companies
                    </a>
                    <a href="/jobs" class="nav-link flex items-center justify-between px-3 py-2 rounded-md text-sm font-medium text-textMuted hover:text-textMain hover:bg-surface transition-colors">
                        <div class="flex items-center gap-3">
                            <i class="fa-solid fa-briefcase w-4 text-center"></i>
                            Matched Jobs
                        </div>
                    </a>
                    <a href="/closed-jobs" class="nav-link flex items-center justify-between px-3 py-2 rounded-md text-sm font-medium text-textMuted hover:text-textMain hover:bg-surface transition-colors">
                        <div class="flex items-center gap-3">
                            <i class="fa-solid fa-clock-rotate-left w-4 text-center"></i>
                            Expired Jobs
                        </div>
                    </a>
                    <a href="/local-jobs" class="nav-link flex items-center justify-between px-3 py-2 rounded-md text-sm font-medium text-textMuted hover:text-textMain hover:bg-surface transition-colors">
                        <div class="flex items-center gap-3">
                            <i class="fa-solid fa-clock w-4 text-center"></i>
                            Local Pending
                        </div>
                    </a>
                    <a href="/saved" class="nav-link flex items-center gap-3 px-3 py-2 rounded-md text-sm font-medium text-textMuted hover:text-textMain hover:bg-surface transition-colors">
                        <i class="fa-solid fa-bookmark w-4 text-center"></i>
                        Saved Jobs
                    </a>
                    <a href="/applied" class="nav-link flex items-center gap-3 px-3 py-2 rounded-md text-sm font-medium text-textMuted hover:text-textMain hover:bg-surface transition-colors">
                        <i class="fa-solid fa-paper-plane w-4 text-center"></i>
                        Applied
                    </a>
                    <a href="/rejected" class="nav-link flex items-center gap-3 px-3 py-2 rounded-md text-sm font-medium text-textMuted hover:text-textMain hover:bg-surface transition-colors">
                        <i class="fa-solid fa-times-circle w-4 text-center"></i>
                        Rejected
                    </a>
                    <a href="/ai-rejected" class="nav-link flex items-center gap-3 px-3 py-2 rounded-md text-sm font-medium text-textMuted hover:text-textMain hover:bg-surface transition-colors text-error/80 hover:text-error">
                        <i class="fa-solid fa-robot w-4 text-center"></i>
                        AI Rejected
                    </a>
                    <button type="button" onclick="openExportModal('all', 'excel')" class="w-full nav-link flex items-center justify-between px-3 py-2 rounded-md text-sm font-medium text-emerald-400/90 hover:text-emerald-300 hover:bg-emerald-500/10 transition-colors text-left border border-emerald-500/20 mt-2">
                        <div class="flex items-center gap-3">
                            <i class="fa-solid fa-file-export w-4 text-center text-emerald-400"></i>
                            <span>Export Center</span>
                        </div>
                        <span class="text-[10px] font-bold px-1.5 py-0.5 rounded bg-emerald-500/20 text-emerald-300">XLSX / PDF</span>
                    </button>
                </div>
            </div>
            <% } %>

            <% if (sidebarHasExtendedAccess) { %>
            <!-- Telegram Monitoring Section -->
            <div>
                <p class="px-3 mb-2 text-[10px] font-semibold text-textMuted uppercase tracking-widest">Telegram</p>
                <div class="space-y-0.5">
                    <a href="/telegram-dashboard" class="nav-link flex items-center gap-3 px-3 py-2 rounded-md text-sm font-medium text-textMuted hover:text-textMain hover:bg-surface transition-colors">
                        <i class="fa-brands fa-telegram w-4 text-center text-[#229ED9]"></i>
                        Telegram Channels
                    </a>
                </div>
            </div>
            <% } %>

            <% if (sidebarIsAdmin) { %>
            <!-- Configuration Section -->
            <div>
                <p class="px-3 mb-2 text-[10px] font-semibold text-textMuted uppercase tracking-widest">Configuration</p>
                <div class="space-y-0.5">
                    <a href="/profile" class="nav-link flex items-center gap-3 px-3 py-2 rounded-md text-sm font-medium text-textMuted hover:text-textMain hover:bg-surface transition-colors">
                        <i class="fa-regular fa-user w-4 text-center"></i>
                        Candidate Profile
                    </a>
                </div>
            </div>
            <% } %>

        </nav>
    </div>
</aside>
