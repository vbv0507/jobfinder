<!-- Universal Export Jobs Modal -->
<div id="exportJobsModal" class="fixed inset-0 z-50 hidden overflow-y-auto" aria-labelledby="export-modal-title" role="dialog" aria-modal="true">
    <!-- Backdrop -->
    <div id="exportModalBackdrop" class="fixed inset-0 bg-black/80 backdrop-blur-md transition-opacity duration-300 opacity-0" onclick="closeExportModal()"></div>

    <!-- Modal Content -->
    <div class="flex min-h-screen items-center justify-center p-4 text-center sm:p-0">
        <div id="exportModalPanel" class="relative transform overflow-hidden rounded-2xl bg-surface border border-border text-left shadow-2xl transition-all duration-300 opacity-0 scale-95 sm:my-8 sm:w-full sm:max-w-2xl">
            
            <!-- Modal Header -->
            <div class="flex items-center justify-between px-6 py-5 border-b border-border bg-gradient-to-r from-surface to-surfaceHover/50">
                <div class="flex items-center gap-3">
                    <div class="w-10 h-10 rounded-xl bg-gradient-to-br from-primary/20 to-primary/5 border border-primary/30 flex items-center justify-center text-primary shadow-sm shadow-primary/20">
                        <i class="fa-solid fa-file-export text-lg"></i>
                    </div>
                    <div>
                        <h3 class="text-lg font-bold text-textMain flex items-center gap-2" id="export-modal-title">
                            Export Job Intelligence
                            <span class="text-[10px] uppercase font-bold tracking-wider px-2 py-0.5 rounded-full bg-primary/20 text-primary border border-primary/30">Excel & PDF</span>
                        </h3>
                        <p class="text-xs text-textMuted mt-0.5">Generate comprehensive audits with full JD requirements, AI scores & rejection/match reasons.</p>
                    </div>
                </div>
                <button type="button" onclick="closeExportModal()" class="text-textMuted hover:text-textMain p-2 rounded-lg hover:bg-surfaceHover transition-colors">
                    <i class="fa-solid fa-times text-base"></i>
                </button>
            </div>

            <!-- Modal Body -->
            <div class="px-6 py-5 space-y-6">
                
                <!-- Scope Selection -->
                <div>
                    <label class="block text-xs font-semibold uppercase tracking-wider text-textMuted mb-3">
                        <i class="fa-solid fa-layer-group text-primary mr-1"></i> 1. Select Export Scope
                    </label>
                    <div class="grid grid-cols-1 sm:grid-cols-2 gap-2.5">
                        
                        <!-- All Jobs -->
                        <label class="export-scope-card relative flex items-start gap-3 p-3 rounded-xl border border-border bg-background/50 hover:bg-surfaceHover/50 hover:border-primary/50 cursor-pointer transition-all">
                            <input type="radio" name="exportScope" value="all" checked class="mt-1 text-primary focus:ring-primary h-4 w-4 bg-surface border-border">
                            <div class="text-xs">
                                <div class="font-bold text-textMain flex items-center gap-1.5">
                                    <i class="fa-solid fa-globe text-cyan-400"></i> All Jobs (Universal)
                                </div>
                                <div class="text-[11px] text-textMuted mt-0.5">All matched, applied, saved, rejected & raw discovered jobs.</div>
                            </div>
                        </label>

                        <!-- Matched Jobs -->
                        <label class="export-scope-card relative flex items-start gap-3 p-3 rounded-xl border border-border bg-background/50 hover:bg-surfaceHover/50 hover:border-primary/50 cursor-pointer transition-all">
                            <input type="radio" name="exportScope" value="matched" class="mt-1 text-primary focus:ring-primary h-4 w-4 bg-surface border-border">
                            <div class="text-xs">
                                <div class="font-bold text-textMain flex items-center gap-1.5">
                                    <i class="fa-solid fa-check-circle text-success"></i> Matched Jobs Only
                                </div>
                                <div class="text-[11px] text-textMuted mt-0.5">High-scoring AI approved positions with match rationales.</div>
                            </div>
                        </label>

                        <!-- Applied Jobs -->
                        <label class="export-scope-card relative flex items-start gap-3 p-3 rounded-xl border border-border bg-background/50 hover:bg-surfaceHover/50 hover:border-primary/50 cursor-pointer transition-all">
                            <input type="radio" name="exportScope" value="applied" class="mt-1 text-primary focus:ring-primary h-4 w-4 bg-surface border-border">
                            <div class="text-xs">
                                <div class="font-bold text-textMain flex items-center gap-1.5">
                                    <i class="fa-solid fa-paper-plane text-sky-400"></i> Applied Jobs Only
                                </div>
                                <div class="text-[11px] text-textMuted mt-0.5">Positions you have applied for with timestamp & notes.</div>
                            </div>
                        </label>

                        <!-- Saved Jobs -->
                        <label class="export-scope-card relative flex items-start gap-3 p-3 rounded-xl border border-border bg-background/50 hover:bg-surfaceHover/50 hover:border-primary/50 cursor-pointer transition-all">
                            <input type="radio" name="exportScope" value="saved" class="mt-1 text-primary focus:ring-primary h-4 w-4 bg-surface border-border">
                            <div class="text-xs">
                                <div class="font-bold text-textMain flex items-center gap-1.5">
                                    <i class="fa-solid fa-bookmark text-purple-400"></i> Saved Bookmarks
                                </div>
                                <div class="text-[11px] text-textMuted mt-0.5">Roles bookmarked for later review and application.</div>
                            </div>
                        </label>

                        <!-- Rejected Jobs -->
                        <label class="export-scope-card relative flex items-start gap-3 p-3 rounded-xl border border-border bg-background/50 hover:bg-surfaceHover/50 hover:border-primary/50 cursor-pointer transition-all">
                            <input type="radio" name="exportScope" value="rejected" class="mt-1 text-primary focus:ring-primary h-4 w-4 bg-surface border-border">
                            <div class="text-xs">
                                <div class="font-bold text-textMain flex items-center gap-1.5">
                                    <i class="fa-solid fa-ban text-rose-400"></i> Rejected Jobs Only
                                </div>
                                <div class="text-[11px] text-textMuted mt-0.5">AI and user disqualified roles with missing skills & reasons.</div>
                            </div>
                        </label>

                        <!-- Local Pending -->
                        <label class="export-scope-card relative flex items-start gap-3 p-3 rounded-xl border border-border bg-background/50 hover:bg-surfaceHover/50 hover:border-primary/50 cursor-pointer transition-all">
                            <input type="radio" name="exportScope" value="local" class="mt-1 text-primary focus:ring-primary h-4 w-4 bg-surface border-border">
                            <div class="text-xs">
                                <div class="font-bold text-textMain flex items-center gap-1.5">
                                    <i class="fa-solid fa-clock text-amber-400"></i> Local Evaluation Queue
                                </div>
                                <div class="text-[11px] text-textMuted mt-0.5">Jobs evaluated locally pending cloud AI verification.</div>
                            </div>
                        </label>
                    </div>
                </div>

                <!-- Format Selection -->
                <div>
                    <label class="block text-xs font-semibold uppercase tracking-wider text-textMuted mb-3">
                        <i class="fa-solid fa-file-lines text-primary mr-1"></i> 2. Select File Format
                    </label>
                    <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
                        
                        <!-- Excel Card -->
                        <label class="export-format-card relative flex items-center gap-3.5 p-3.5 rounded-xl border-2 border-primary bg-primary/5 cursor-pointer transition-all">
                            <input type="radio" name="exportFormat" value="excel" checked class="text-primary focus:ring-primary h-4 w-4 bg-surface border-border">
                            <div class="w-9 h-9 rounded-lg bg-emerald-500/10 border border-emerald-500/20 text-emerald-400 flex items-center justify-center text-lg shrink-0">
                                <i class="fa-solid fa-file-excel"></i>
                            </div>
                            <div class="text-xs">
                                <div class="font-bold text-textMain">Microsoft Excel (.xlsx)</div>
                                <div class="text-[11px] text-textMuted mt-0.5">Full multi-column spreadsheet with frozen headers & styling.</div>
                            </div>
                        </label>

                        <!-- PDF Card -->
                        <label class="export-format-card relative flex items-center gap-3.5 p-3.5 rounded-xl border-2 border-border bg-background/50 hover:border-primary/50 cursor-pointer transition-all">
                            <input type="radio" name="exportFormat" value="pdf" class="text-primary focus:ring-primary h-4 w-4 bg-surface border-border">
                            <div class="w-9 h-9 rounded-lg bg-rose-500/10 border border-rose-500/20 text-rose-400 flex items-center justify-center text-lg shrink-0">
                                <i class="fa-solid fa-file-pdf"></i>
                            </div>
                            <div class="text-xs">
                                <div class="font-bold text-textMain">Adobe PDF (.pdf)</div>
                                <div class="text-[11px] text-textMuted mt-0.5">Print-ready executive report with analytics summary & badges.</div>
                            </div>
                        </label>
                    </div>
                </div>

                <!-- Included Data Details Notice -->
                <div class="p-3.5 rounded-xl bg-surfaceHover/60 border border-border text-[11px] text-textMuted space-y-1.5">
                    <div class="font-semibold text-textMain flex items-center gap-1.5">
                        <i class="fa-solid fa-circle-info text-primary"></i> Data Fields Included in Export:
                    </div>
                    <p>
                        Company Name, Role Title, Location, Job Posted Date, Scraped Date, Applied Date, Job Description / Requirements, AI Fit Score (0-100), Scoring Breakdown, AI Evaluator & Model, Reason for Match / Strengths, Reason for Rejection / Missing Skills, and Direct Application Link.
                    </p>
                </div>
            </div>

            <!-- Modal Footer -->
            <div class="px-6 py-4 border-t border-border bg-background/50 flex flex-col sm:flex-row items-center justify-between gap-3">
                <div class="text-xs text-textMuted text-center sm:text-left flex items-center gap-1.5">
                    <i class="fa-solid fa-shield-halved text-success"></i> Instant streaming download
                </div>
                <div class="flex items-center gap-2.5 w-full sm:w-auto">
                    <button type="button" onclick="closeExportModal()" class="flex-1 sm:flex-none px-4 py-2 text-xs font-semibold text-textMuted hover:text-textMain bg-surface hover:bg-surfaceHover border border-border rounded-xl transition-colors">
                        Cancel
                    </button>
                    <button type="button" id="triggerExportBtn" onclick="executeExportDownload()" class="flex-1 sm:flex-none px-5 py-2 text-xs font-bold text-white bg-primary hover:bg-primaryHover rounded-xl shadow-lg shadow-primary/25 transition-all flex items-center justify-center gap-2">
                        <i class="fa-solid fa-download"></i>
                        <span>Download Export</span>
                    </button>
                </div>
            </div>

        </div>
    </div>
</div>

<script>
    function openExportModal(defaultScope = 'all', defaultFormat = 'excel') {
        const modal = document.getElementById('exportJobsModal');
        const backdrop = document.getElementById('exportModalBackdrop');
        const panel = document.getElementById('exportModalPanel');
        if (!modal) return;

        // Set default scope
        const scopeRadio = modal.querySelector(`input[name="exportScope"][value="${defaultScope}"]`);
        if (scopeRadio) scopeRadio.checked = true;

        // Set default format
        const formatRadio = modal.querySelector(`input[name="exportFormat"][value="${defaultFormat}"]`);
        if (formatRadio) formatRadio.checked = true;

        updateFormatCardStyles();

        modal.classList.remove('hidden');
        setTimeout(() => {
            backdrop.classList.remove('opacity-0');
            panel.classList.remove('opacity-0', 'scale-95');
            panel.classList.add('opacity-100', 'scale-100');
        }, 10);
    }

    function closeExportModal() {
        const modal = document.getElementById('exportJobsModal');
        const backdrop = document.getElementById('exportModalBackdrop');
        const panel = document.getElementById('exportModalPanel');
        if (!modal) return;

        backdrop.classList.add('opacity-0');
        panel.classList.remove('opacity-100', 'scale-100');
        panel.classList.add('opacity-0', 'scale-95');
        setTimeout(() => {
            modal.classList.add('hidden');
        }, 200);
    }

    function updateFormatCardStyles() {
        document.querySelectorAll('.export-format-card').forEach(card => {
            const radio = card.querySelector('input[type="radio"]');
            if (radio && radio.checked) {
                card.classList.add('border-primary', 'bg-primary/5');
                card.classList.remove('border-border', 'bg-background/50');
            } else if (card) {
                card.classList.remove('border-primary', 'bg-primary/5');
                card.classList.add('border-border', 'bg-background/50');
            }
        });
    }

    document.addEventListener('DOMContentLoaded', () => {
        document.querySelectorAll('input[name="exportFormat"]').forEach(radio => {
            radio.addEventListener('change', updateFormatCardStyles);
        });
    });

    async function executeExportDownload() {
        const btn = document.getElementById('triggerExportBtn');
        const selectedScope = document.querySelector('input[name="exportScope"]:checked')?.value || 'all';
        const selectedFormat = document.querySelector('input[name="exportFormat"]:checked')?.value || 'excel';

        const originalHtml = btn.innerHTML;
        btn.disabled = true;
        btn.innerHTML = `<i class="fa-solid fa-spinner fa-spin"></i> Generating ${selectedFormat.toUpperCase()}...`;

        try {
            const url = `/api/jobs/export/${selectedFormat}?scope=${encodeURIComponent(selectedScope)}`;
            
            // Trigger browser download via invisible link
            const a = document.createElement('a');
            a.href = url;
            a.download = `RoleNova_${selectedScope}_jobs_${new Date().toISOString().slice(0, 10)}.${selectedFormat === 'excel' ? 'xlsx' : 'pdf'}`;
            document.body.appendChild(a);
            a.click();
            document.body.removeChild(a);

            setTimeout(() => {
                btn.disabled = false;
                btn.innerHTML = originalHtml;
                closeExportModal();
            }, 1200);
        } catch (e) {
            alert('Export failed: ' + e.message);
            btn.disabled = false;
            btn.innerHTML = originalHtml;
        }
    }

    // Direct helper functions for page buttons
    function quickExport(scope, format) {
        openExportModal(scope, format);
    }
</script>
