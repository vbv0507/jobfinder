<%- include('partials/header', { title: 'Analytics' }) %>

<div class="mb-6">
    <h2 class="text-2xl font-bold text-gray-900">Platform Analytics</h2>
    <p class="text-gray-500 text-sm mt-1">Visualize job matching metrics and pipeline performance.</p>
</div>

<div class="grid grid-cols-1 lg:grid-cols-2 gap-6 mb-8">
    <!-- Daily Scraping Trend -->
    <div class="bg-white rounded-xl shadow-sm border border-gray-100 p-6 lg:col-span-2">
        <h3 class="text-lg font-semibold text-gray-900 mb-4">Daily Pipeline Activity (Last 7 Days)</h3>
        <div class="relative w-full">
            <canvas id="trendChart"></canvas>
        </div>
    </div>

    <!-- Jobs Evaluated per Company -->
    <div class="bg-white rounded-xl shadow-sm border border-gray-100 p-6">
        <h3 class="text-lg font-semibold text-gray-900 mb-4">Jobs by Company</h3>
        <div class="relative w-full">
            <canvas id="companyChart"></canvas>
        </div>
    </div>
    
    <!-- AI Provider Statistics -->
    <div class="bg-white rounded-xl shadow-sm border border-gray-100 p-6 lg:col-span-2">
        <h3 class="text-lg font-semibold text-gray-900 mb-4"><i class="fas fa-robot text-primary mr-2"></i> AI Provider Statistics</h3>
        <div class="grid grid-cols-2 md:grid-cols-5 gap-4" id="aiStatsContainer">
            <!-- Populated by JS -->
            <div class="animate-pulse h-16 bg-gray-100 rounded"></div>
        </div>
    </div>
    
    <!-- Match Score Distribution -->
    <div class="bg-white rounded-xl shadow-sm border border-gray-100 p-6">
        <h3 class="text-lg font-semibold text-gray-900 mb-4">Match Score Distribution</h3>
        <div class="relative w-full flex justify-center">
            <canvas id="scoreChart"></canvas>
        </div>
    </div>
    
    <!-- Jobs by Domain -->
    <div class="bg-white rounded-xl shadow-sm border border-gray-100 p-6">
        <h3 class="text-lg font-semibold text-gray-900 mb-4">Jobs by Domain</h3>
        <div class="relative w-full">
            <canvas id="domainChart"></canvas>
        </div>
    </div>
    
    <!-- Application Status Distribution -->
    <div class="bg-white rounded-xl shadow-sm border border-gray-100 p-6">
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
            <div>
                <h3 class="text-sm font-semibold text-gray-900 mb-2 text-center">Status</h3>
                <div class="relative w-full flex justify-center">
                    <canvas id="statusChart"></canvas>
                </div>
            </div>
            <div>
                <h3 class="text-sm font-semibold text-gray-900 mb-2 text-center">AI vs Local</h3>
                <div class="relative w-full flex justify-center">
                    <canvas id="evalChart"></canvas>
                </div>
            </div>
        </div>
    </div>
</div>

<script>
    async function loadAnalytics() {
        try {
            const res = await apiCall("/api/jobs/analytics");
            const data = res;
            
            if(data.success && data.charts) {
                // Common options
                const commonOptions = { responsive: true, maintainAspectRatio: true };
                
                // 1. Daily Trend (Line Chart)
                const tCtx = document.getElementById('trendChart').getContext('2d');
                new Chart(tCtx, {
                    type: 'line',
                    data: {
                        labels: data.charts.dailyTrend.map(d => d._id),
                        datasets: [
                            {
                                label: 'Jobs Found',
                                data: data.charts.dailyTrend.map(d => d.jobsFound),
                                borderColor: 'rgba(107, 114, 128, 1)',
                                backgroundColor: 'rgba(107, 114, 128, 0.1)',
                                fill: true,
                                tension: 0.4
                            },
                            {
                                label: 'Jobs Matched',
                                data: data.charts.dailyTrend.map(d => d.jobsMatched),
                                borderColor: 'rgba(79, 70, 229, 1)',
                                backgroundColor: 'rgba(79, 70, 229, 0.1)',
                                fill: true,
                                tension: 0.4
                            }
                        ]
                    },
                    options: commonOptions
                });

                // 2. Company Distribution (Bar Chart)
                const cCtx = document.getElementById('companyChart').getContext('2d');
                new Chart(cCtx, {
                    type: 'bar',
                    data: {
                        labels: data.charts.companyDistribution.map(c => c._id.substring(0, 15)),
                        datasets: [{
                            label: 'Jobs Matched',
                            data: data.charts.companyDistribution.map(c => c.count),
                            backgroundColor: 'rgba(79, 70, 229, 0.8)',
                            borderRadius: 4
                        }]
                    },
                    options: commonOptions
                });

                // 3. Score Distribution (Doughnut Chart)
                const sCtx = document.getElementById('scoreChart').getContext('2d');
                const scoreLabels = data.charts.scoreDistribution.map(b => b._id === 'Other' ? 'Other' : `${b._id} - ${b._id + 19}`);
                new Chart(sCtx, {
                    type: 'doughnut',
                    data: {
                        labels: scoreLabels,
                        datasets: [{
                            data: data.charts.scoreDistribution.map(b => b.count),
                            backgroundColor: [
                                'rgba(239, 68, 68, 0.8)',   // <40 Red
                                'rgba(245, 158, 11, 0.8)', // 40-59 Yellow
                                'rgba(16, 185, 129, 0.8)', // 60-79 Green
                                'rgba(79, 70, 229, 0.8)'    // 80+ Indigo
                            ]
                        }]
                    },
                    options: { ...commonOptions, cutout: '65%' }
                });
                
                // 4. Domain Distribution (Bar Chart)
                const dCtx = document.getElementById('domainChart').getContext('2d');
                new Chart(dCtx, {
                    type: 'bar',
                    data: {
                        labels: data.charts.domainDistribution.map(d => d._id),
                        datasets: [{
                            label: 'Jobs',
                            data: data.charts.domainDistribution.map(d => d.count),
                            backgroundColor: 'rgba(59, 130, 246, 0.8)',
                            borderRadius: 4
                        }]
                    },
                    options: { ...commonOptions, indexAxis: 'y' }
                });
                
                // 5. Status Distribution (Pie Chart)
                const stCtx = document.getElementById('statusChart').getContext('2d');
                new Chart(stCtx, {
                    type: 'pie',
                    data: {
                        labels: data.charts.statusDistribution.map(s => s._id),
                        datasets: [{
                            data: data.charts.statusDistribution.map(s => s.count),
                            backgroundColor: ['#f3f4f6', '#fef08a', '#86efac', '#fca5a5']
                        }]
                    },
                    options: { ...commonOptions, plugins: { legend: { position: 'bottom' } } }
                });

                // 6. Eval Distribution (Pie Chart)
                const evCtx = document.getElementById('evalChart').getContext('2d');
                new Chart(evCtx, {
                    type: 'pie',
                    data: {
                        labels: data.charts.evaluationDistribution.map(e => e._id),
                        datasets: [{
                            data: data.charts.evaluationDistribution.map(e => e.count),
                            backgroundColor: ['#818cf8', '#cbd5e1']
                        }]
                    },
                    options: { ...commonOptions, plugins: { legend: { position: 'bottom' } } }
                });

                // 7. AI Metrics UI
                if (data.aiMetrics) {
                    const ai = data.aiMetrics;
                    document.getElementById('aiStatsContainer').innerHTML = `
                        <div class="bg-gray-50 p-4 rounded-lg border border-gray-100 text-center">
                            <p class="text-xs text-gray-500 uppercase tracking-wider font-semibold">🟢 Gemini</p>
                            <p class="text-xl font-bold text-gray-800 mt-1">${ai.geminiUsage}</p>
                        </div>
                        <div class="bg-gray-50 p-4 rounded-lg border border-gray-100 text-center">
                            <p class="text-xs text-gray-500 uppercase tracking-wider font-semibold">🟠 Groq</p>
                            <p class="text-xl font-bold text-gray-800 mt-1">${ai.groqUsage}</p>
                        </div>
                        <div class="bg-gray-50 p-4 rounded-lg border border-gray-100 text-center">
                            <p class="text-xs text-gray-500 uppercase tracking-wider font-semibold">⚪ Local</p>
                            <p class="text-xl font-bold text-gray-800 mt-1">${ai.localUsage}</p>
                        </div>
                        <div class="bg-gray-50 p-4 rounded-lg border border-gray-100 text-center">
                            <p class="text-xs text-gray-500 uppercase tracking-wider font-semibold">Avg Time</p>
                            <p class="text-xl font-bold text-blue-600 mt-1">${ai.averageEvaluationTimeMs}ms</p>
                        </div>
                        <div class="bg-gray-50 p-4 rounded-lg border border-gray-100 text-center">
                            <p class="text-xs text-gray-500 uppercase tracking-wider font-semibold">Fallbacks</p>
                            <p class="text-xl font-bold ${ai.fallbackPercentage > 10 ? 'text-red-600' : 'text-gray-800'} mt-1">${ai.fallbackPercentage}%</p>
                        </div>
                    `;
                }
            }
        } catch(e) {
            console.error("Error loading analytics", e);
        }
    }

    document.addEventListener("DOMContentLoaded", loadAnalytics);
</script>

<%- include('partials/footer') %>
