<%- include('partials/header', { title: 'Job Details' }) %>

<div class="mb-6 flex flex-col md:flex-row md:items-center justify-between gap-4">
    <a href="javascript:history.back()" class="text-gray-500 hover:text-primary transition flex items-center gap-2 w-fit">
        <i class="fas fa-arrow-left"></i> Back to list
    </a>
    <div class="flex flex-col sm:flex-row gap-2 w-full md:w-auto">
        <% if(job.status !== 'applied') { %>
            <button onclick="updateStatus('<%= job._id %>', 'applied')" class="bg-primary hover:bg-primaryHover text-white px-4 py-2 min-h-[44px] rounded-md transition shadow-sm flex items-center justify-center gap-2 w-full sm:w-auto">
                <i class="fas fa-paper-plane"></i> Mark Applied
            </button>
        <% } %>
        <a href="<%= job.url %>" target="_blank" class="bg-gray-100 hover:bg-gray-200 text-gray-800 px-4 py-2 min-h-[44px] rounded-md transition shadow-sm border border-gray-200 flex items-center justify-center gap-2 w-full sm:w-auto">
            <i class="fas fa-external-link-alt"></i> Apply Externally
        </a>
    </div>
</div>

<div class="grid grid-cols-1 lg:grid-cols-3 gap-6 mb-8">
    
    <!-- Main Description Column -->
    <div class="lg:col-span-2 space-y-6">
        <div class="bg-white rounded-xl shadow-sm border border-gray-100 p-6">
            <div class="flex items-start justify-between border-b border-gray-100 pb-4 mb-4">
                <div class="flex items-center gap-4">
                    <div class="flex-shrink-0 h-14 w-14 bg-white rounded-lg flex items-center justify-center border border-gray-200 overflow-hidden">
                        <img src="<%= getCompanyLogo(job.company && job.company.name ? job.company.name : 'Unknown') %>" 
                             class="h-8 w-8 object-contain" alt="Logo" loading="lazy" width="56" height="56">
                    </div>
                    <div>
                        <h1 class="text-2xl font-bold text-gray-900"><%= job.role %></h1>
                        <p class="text-lg text-gray-600 mt-1"><i class="fas fa-building mr-2 text-gray-400"></i> <%= (job.company && job.company.name) ? job.company.name : 'Unknown Company' %></p>
                    </div>
                </div>
                <div class="text-right">
                    <span class="inline-block bg-primary text-white text-2xl font-bold px-4 py-2 rounded-lg shadow-sm"><%= job.score %></span>
                    <p class="text-xs text-gray-500 mt-1 uppercase tracking-wider font-semibold">Match Score</p>
                </div>
            </div>

            <div class="flex flex-wrap gap-4 text-sm text-gray-600 mb-6">
                <div class="flex items-center gap-2 bg-gray-50 px-3 py-1.5 rounded-md border border-gray-100">
                    <i class="fas fa-map-marker-alt text-gray-400"></i> <%= job.location || 'Remote' %>
                </div>
                <div class="flex items-center gap-2 bg-gray-50 px-3 py-1.5 rounded-md border border-gray-100">
                    <i class="fas fa-clock text-gray-400"></i> <%= new Date(job.postedAt || job.createdAt).toLocaleDateString() %>
                </div>
                <div class="flex items-center gap-2 bg-gray-50 px-3 py-1.5 rounded-md border border-gray-100">
                    <i class="fas fa-briefcase text-gray-400"></i> <%= job.employmentType || 'Full-time' %>
                </div>
                <div class="flex items-center gap-2 bg-indigo-50 text-indigo-700 px-3 py-1.5 rounded-md border border-indigo-100 font-medium">
                    <i class="fas fa-robot"></i> Evaluated by <%= job.evaluatedBy || 'AI' %>
                </div>
            </div>

            <h3 class="text-lg font-semibold text-gray-900 mb-3">AI Evaluation Breakdown</h3>
            
            <div class="grid grid-cols-2 md:grid-cols-4 gap-4 mb-6">
                <div class="bg-gray-50 p-4 rounded-lg border border-gray-100 text-center">
                    <p class="text-xs text-gray-500 uppercase tracking-wider font-semibold">Confidence</p>
                    <p class="text-lg font-bold text-gray-800 mt-1"><%= job.confidence || 'Medium' %></p>
                </div>
                <div class="bg-gray-50 p-4 rounded-lg border border-gray-100 text-center">
                    <p class="text-xs text-gray-500 uppercase tracking-wider font-semibold">Domain</p>
                    <p class="text-lg font-bold <%= job.domainMismatch ? 'text-red-600' : 'text-green-600' %> mt-1"><%= job.jobDomain || 'Unknown' %></p>
                </div>
                <div class="bg-gray-50 p-4 rounded-lg border border-gray-100 text-center">
                    <p class="text-xs text-gray-500 uppercase tracking-wider font-semibold">Role Match</p>
                    <p class="text-lg font-bold text-gray-800 mt-1"><%= job.roleMatch || 'Moderate' %></p>
                </div>
                <div class="bg-gray-50 p-4 rounded-lg border border-gray-100 text-center">
                    <p class="text-xs text-gray-500 uppercase tracking-wider font-semibold">Experience</p>
                    <p class="text-lg font-bold <%= job.experienceMismatch ? 'text-red-600' : 'text-green-600' %> mt-1"><%= job.experienceMatch || 'Match' %></p>
                </div>
            </div>

            <div class="bg-gray-50 rounded-lg p-5 border border-gray-100 mb-6 space-y-5">
                <div>
                    <h4 class="text-sm font-semibold text-gray-700 uppercase tracking-wider mb-2 flex items-center gap-2"><i class="fas fa-align-left text-gray-400"></i> Domain Alignment</h4>
                    <p class="text-gray-700 text-sm leading-relaxed"><%= job.domainExplanation || 'No domain explanation provided.' %></p>
                </div>
                <div>
                    <h4 class="text-sm font-semibold text-gray-700 uppercase tracking-wider mb-2 flex items-center gap-2"><i class="fas fa-list-ul text-gray-400"></i> Primary Reasons</h4>
                    <ul class="list-disc list-inside text-gray-700 space-y-1 text-sm">
                        <% if(job.primaryReasons && job.primaryReasons.length > 0) { %>
                            <% job.primaryReasons.forEach(function(r) { %>
                                <li><%= r %></li>
                            <% }) %>
                        <% } else { %>
                            <li><%= job.reason %></li>
                        <% } %>
                    </ul>
                </div>
                <% if(job.missingSkills && job.missingSkills.length > 0) { %>
                <div class="pt-2 border-t border-gray-200">
                    <h4 class="text-sm font-semibold text-red-700 uppercase tracking-wider mb-2 flex items-center gap-2"><i class="fas fa-exclamation-triangle"></i> Missing Required Skills</h4>
                    <ul class="list-disc list-inside text-red-600 space-y-1 text-sm">
                        <% job.missingSkills.forEach(function(s) { %>
                            <li><%= s %></li>
                        <% }) %>
                    </ul>
                </div>
                <% } %>
            </div>

            <h3 class="text-lg font-semibold text-gray-900 mb-3">Job Description</h3>
            <div class="prose max-w-none text-gray-700" style="white-space: pre-wrap; font-size: 0.95rem; line-height: 1.6;">
                <%= job.description %>
            </div>
        </div>
    </div>

    <!-- Sidebar Analytics -->
    <div class="lg:col-span-1 space-y-6">
        <div class="bg-white rounded-xl shadow-sm border border-gray-100 p-6">
            <h3 class="text-lg font-semibold text-gray-900 mb-4">Scoring Radar</h3>
            
            <% if(job.scoringBreakdown && job.scoringBreakdown.roleMatch !== undefined) { %>
                <canvas id="scoreRadar" width="400" height="400"></canvas>
                <script>
                    document.addEventListener("DOMContentLoaded", () => {
                        const ctx = document.getElementById('scoreRadar').getContext('2d');
                        new Chart(ctx, {
                            type: 'radar',
                            data: {
                                labels: ['Role', 'Skills', 'Experience', 'Domain', 'Location'],
                                datasets: [{
                                    label: 'Match Axis',
                                    data: [
                                        <%= job.scoringBreakdown.roleMatch || 0 %>,
                                        <%= job.scoringBreakdown.skillsMatch || 0 %>,
                                        <%= job.scoringBreakdown.experienceMatch || 0 %>,
                                        <%= job.scoringBreakdown.domainMatch || 0 %>,
                                        <%= job.scoringBreakdown.locationMatch || 0 %>
                                    ],
                                    backgroundColor: 'rgba(79, 70, 229, 0.2)',
                                    borderColor: 'rgba(79, 70, 229, 1)',
                                    pointBackgroundColor: 'rgba(79, 70, 229, 1)',
                                    pointBorderColor: '#fff',
                                    pointHoverBackgroundColor: '#fff',
                                    pointHoverBorderColor: 'rgba(79, 70, 229, 1)'
                                }]
                            },
                            options: {
                                scales: {
                                    r: {
                                        angleLines: { display: false },
                                        suggestedMin: 0,
                                        suggestedMax: 100,
                                        ticks: { display: false }
                                    }
                                },
                                plugins: { legend: { display: false } }
                            }
                        });
                    });
                </script>
            <% } else { %>
                <p class="text-sm text-gray-500 italic text-center py-8">Radar data unavailable. Missing scoringBreakdown in schema.</p>
            <% } %>
        </div>

        <div class="bg-white rounded-xl shadow-sm border border-gray-100 p-6">
            <h3 class="text-lg font-semibold text-gray-900 mb-4">Timeline</h3>
            <div class="relative border-l border-gray-200 ml-3 space-y-6">
                <% if(job.timeline && job.timeline.length > 0) { %>
                    <% job.timeline.forEach(function(event) { %>
                        <div class="mb-8 ml-6">
                            <span class="absolute flex items-center justify-center w-6 h-6 bg-primary rounded-full -left-3 ring-8 ring-white">
                                <i class="fas fa-circle text-white text-xs"></i>
                            </span>
                            <h3 class="flex items-center mb-1 text-sm font-semibold text-gray-900 capitalize"><%= event.status %></h3>
                            <time class="block mb-2 text-xs font-normal leading-none text-gray-400"><%= new Date(event.date).toLocaleString() %></time>
                        </div>
                    <% }) %>
                <% } else { %>
                    <div class="mb-8 ml-6">
                        <span class="absolute flex items-center justify-center w-6 h-6 bg-gray-200 rounded-full -left-3 ring-8 ring-white">
                            <i class="fas fa-plus text-gray-500 text-xs"></i>
                        </span>
                        <h3 class="flex items-center mb-1 text-sm font-semibold text-gray-900 capitalize">Found</h3>
                        <time class="block mb-2 text-xs font-normal leading-none text-gray-400"><%= new Date(job.createdAt).toLocaleString() %></time>
                    </div>
                <% } %>
            </div>
        </div>

        <div class="bg-white rounded-xl shadow-sm border border-gray-100 p-6">
            <h3 class="text-lg font-semibold text-gray-900 mb-4">Notes</h3>
            <textarea id="jobNotes" rows="4" class="w-full border border-gray-300 rounded-md shadow-sm p-3 min-h-[44px] text-sm focus:ring-primary focus:border-primary transition" placeholder="Add personal notes here..."><%= job.notes || '' %></textarea>
            <button onclick="saveNotes('<%= job._id %>')" class="mt-3 w-full bg-gray-800 hover:bg-gray-900 text-white font-medium py-2 min-h-[44px] rounded-md transition shadow-sm">
                Save Notes
            </button>
        </div>
    </div>
</div>

<script>
    async function updateStatus(id, status) {
        try {
            const res = await fetch(`/api/jobs/${id}/status`, {
                method: "PATCH",
                headers: { "Content-Type": "application/json" },
                body: JSON.stringify({ status })
            });
            const data = await res.json();
            if (data.success) {
                window.location.reload();
            }
        } catch (e) {
            alert("Error updating status");
        }
    }

    async function saveNotes(id) {
        const notes = document.getElementById('jobNotes').value;
        try {
            const res = await fetch(`/api/jobs/${id}/status`, {
                method: "PATCH",
                headers: { "Content-Type": "application/json" },
                body: JSON.stringify({ notes })
            });
            const data = await res.json();
            if (data.success) {
                alert("Notes saved successfully!");
            }
        } catch (e) {
            alert("Error saving notes");
        }
    }
</script>

<%- include('partials/footer') %>
