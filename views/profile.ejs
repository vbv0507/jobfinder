<%- include('partials/header', { title: 'Candidate Profile' }) %>

<div class="mb-6">
    <h2 class="text-2xl font-bold text-gray-900">Your Profile</h2>
    <p class="text-gray-500 text-sm mt-1">Configure your AI recruiting agent. The matching engine uses these parameters to evaluate incoming jobs.</p>
</div>

<div class="bg-white rounded-xl shadow-sm border border-gray-100 p-8 max-w-4xl">
    <form id="profileForm" onsubmit="saveProfile(event)" class="space-y-8">
        
        <!-- Basic Info -->
        <div>
            <h3 class="text-lg font-semibold text-gray-800 border-b pb-2 mb-4">Basic Information</h3>
            <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                <div>
                    <label class="block text-sm font-medium text-gray-700 mb-1">Name</label>
                    <input type="text" id="name" class="w-full border border-gray-300 rounded-md p-2.5 focus:ring-primary focus:border-primary">
                </div>
                <div>
                    <label class="block text-sm font-medium text-gray-700 mb-1">Graduation Year</label>
                    <input type="number" id="graduationYear" class="w-full border border-gray-300 rounded-md p-2.5 focus:ring-primary focus:border-primary">
                </div>
                <div>
                    <label class="block text-sm font-medium text-gray-700 mb-1">Career Stage</label>
                    <input type="text" id="careerStage" class="w-full border border-gray-300 rounded-md p-2.5 focus:ring-primary focus:border-primary" placeholder="e.g. Entry Level / New Grad">
                </div>
                <div>
                    <label class="block text-sm font-medium text-gray-700 mb-1">Years of Experience</label>
                    <input type="number" id="yearsOfExperience" class="w-full border border-gray-300 rounded-md p-2.5 focus:ring-primary focus:border-primary">
                </div>
            </div>
        </div>

        <!-- Domains & Matching -->
        <div>
            <h3 class="text-lg font-semibold text-gray-800 border-b pb-2 mb-4">Domain Preferences</h3>
            <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                <div>
                    <label class="block text-sm font-medium text-gray-700 mb-1">Preferred Domains (comma separated)</label>
                    <textarea id="preferredDomains" rows="3" class="w-full border border-gray-300 rounded-md p-2.5 focus:ring-primary focus:border-primary text-sm"></textarea>
                    <p class="text-xs text-gray-500 mt-1">e.g. BACKEND, PLATFORM</p>
                </div>
                <div>
                    <label class="block text-sm font-medium text-gray-700 mb-1">Excluded Domains (comma separated)</label>
                    <textarea id="excludedDomains" rows="3" class="w-full border border-gray-300 rounded-md p-2.5 focus:ring-primary focus:border-primary text-sm"></textarea>
                    <p class="text-xs text-red-500 mt-1">Jobs matching these domains will be instantly rejected.</p>
                </div>
                <div>
                    <label class="block text-sm font-medium text-gray-700 mb-1">Preferred Employment Levels</label>
                    <textarea id="preferredEmploymentLevels" rows="2" class="w-full border border-gray-300 rounded-md p-2.5 focus:ring-primary focus:border-primary text-sm"></textarea>
                </div>
                <div>
                    <label class="block text-sm font-medium text-gray-700 mb-1">Preferred Job Types</label>
                    <textarea id="preferredJobTypes" rows="2" class="w-full border border-gray-300 rounded-md p-2.5 focus:ring-primary focus:border-primary text-sm"></textarea>
                </div>
            </div>
        </div>

        <!-- Core Competencies -->
        <div>
            <h3 class="text-lg font-semibold text-gray-800 border-b pb-2 mb-4">Core Competencies</h3>
            <div class="space-y-6">
                <div>
                    <label class="block text-sm font-medium text-gray-700 mb-1">Skills (comma separated)</label>
                    <textarea id="skills" rows="4" class="w-full border border-gray-300 rounded-md p-2.5 focus:ring-primary focus:border-primary font-mono text-sm"></textarea>
                </div>
                <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                    <div>
                        <label class="block text-sm font-medium text-gray-700 mb-1">Preferred Roles (comma separated)</label>
                        <textarea id="preferredRoles" rows="2" class="w-full border border-gray-300 rounded-md p-2.5 focus:ring-primary focus:border-primary text-sm"></textarea>
                    </div>
                    <div>
                        <label class="block text-sm font-medium text-gray-700 mb-1">Preferred Locations (comma separated)</label>
                        <textarea id="preferredLocations" rows="2" class="w-full border border-gray-300 rounded-md p-2.5 focus:ring-primary focus:border-primary text-sm"></textarea>
                    </div>
                </div>
            </div>
        </div>
        
        <div class="flex justify-end pt-4 border-t">
            <button type="submit" class="bg-primary hover:bg-primaryHover text-white font-medium py-2 px-6 rounded-lg transition shadow-sm">
                Save Profile Configuration
            </button>
        </div>
    </form>
</div>

<script>
    async function loadProfile() {
        try {
            const res = await fetch("/api/profile");
            const data = await res.json();
            if(data.success && data.profile) {
                const p = data.profile;
                document.getElementById('name').value = p.name || '';
                document.getElementById('graduationYear').value = p.graduationYear || '';
                document.getElementById('careerStage').value = p.careerStage || '';
                document.getElementById('yearsOfExperience').value = p.yearsOfExperience || 0;
                
                document.getElementById('preferredDomains').value = (p.preferredDomains || []).join(', ');
                document.getElementById('excludedDomains').value = (p.excludedDomains || []).join(', ');
                document.getElementById('preferredEmploymentLevels').value = (p.preferredEmploymentLevels || []).join(', ');
                document.getElementById('preferredJobTypes').value = (p.preferredJobTypes || []).join(', ');
                
                document.getElementById('skills').value = (p.skills || []).join(', ');
                document.getElementById('preferredRoles').value = (p.preferredRoles || []).join(', ');
                document.getElementById('preferredLocations').value = (p.preferredLocations || []).join(', ');
            }
        } catch(e) {
            console.error("Failed to load profile", e);
        }
    }

    async function saveProfile(e) {
        e.preventDefault();
        
        const splitString = (str) => str.split(',').map(s => s.trim()).filter(Boolean);
        
        const profile = {
            name: document.getElementById('name').value,
            graduationYear: parseInt(document.getElementById('graduationYear').value),
            careerStage: document.getElementById('careerStage').value,
            yearsOfExperience: parseInt(document.getElementById('yearsOfExperience').value),
            
            preferredDomains: splitString(document.getElementById('preferredDomains').value),
            excludedDomains: splitString(document.getElementById('excludedDomains').value),
            preferredEmploymentLevels: splitString(document.getElementById('preferredEmploymentLevels').value),
            preferredJobTypes: splitString(document.getElementById('preferredJobTypes').value),
            
            skills: splitString(document.getElementById('skills').value),
            preferredRoles: splitString(document.getElementById('preferredRoles').value),
            preferredLocations: splitString(document.getElementById('preferredLocations').value),
        };

        try {
            const res = await fetch("/api/profile", {
                method: "POST",
                headers: { "Content-Type": "application/json" },
                body: JSON.stringify(profile)
            });
            const data = await res.json();
            if(data.success) {
                alert("Profile successfully updated. Next AI evaluation will use these settings.");
            } else {
                alert("Error updating profile.");
            }
        } catch(err) {
            alert("Network error.");
        }
    }

    document.addEventListener("DOMContentLoaded", loadProfile);
</script>

<%- include('partials/footer') %>
