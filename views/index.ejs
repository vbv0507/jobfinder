<%- include('partials/header') %>

<!-- Dashboard Content -->
<div class="mb-8 flex flex-col md:flex-row md:justify-between md:items-end gap-4">
    <div>
        <h2 class="text-2xl font-bold text-gray-900">Platform Overview</h2>
        <p class="text-gray-500 text-sm mt-1">Real-time statistics of your Job Intelligence Engine.</p>
    </div>
    
    <div class="flex flex-col sm:flex-row gap-4">
        <!-- AI Status Widget -->
        <div class="bg-white px-4 py-2 rounded-lg shadow-sm border border-gray-100 flex flex-wrap items-start gap-4 overflow-x-auto w-full md:w-auto">
            <!-- Gemini -->
            <div class="border-r border-gray-100 pr-4 min-w-[100px]">
                <p id="gemini-title" class="text-gray-500 text-xs font-medium uppercase">🟢 Gemini</p>
                <p id="gemini-status" class="text-gray-800 font-semibold leading-none mt-1">Ready</p>
                <div class="text-[10px] mt-2 space-y-0.5 text-gray-500">
                    <p>Reqs: <span id="gemini-reqs" class="font-medium text-gray-700">0</span></p>
                    <p>Success: <span id="gemini-success" class="font-medium text-green-600">0</span></p>
                    <p>Failed: <span id="gemini-failed" class="font-medium text-red-500">0</span></p>
                    <p>Fallbacks: <span id="gemini-fallbacks" class="font-medium text-gray-700">0</span></p>
                    <p id="gemini-disabled" class="text-red-500 hidden">Disabled: <span></span></p>
                </div>
                <p id="gemini-reason" class="text-red-500 text-[10px] mt-1 hidden max-w-[120px] truncate" title=""></p>
            </div>
            
            <!-- Groq -->
            <div class="border-r border-gray-100 pr-4 min-w-[100px]">
                <p id="groq-title" class="text-gray-500 text-xs font-medium uppercase">🟠 Groq</p>
                <p id="groq-status" class="text-gray-800 font-semibold leading-none mt-1">Ready</p>
                <div class="text-[10px] mt-2 space-y-0.5 text-gray-500">
                    <p>Reqs: <span id="groq-reqs" class="font-medium text-gray-700">0</span></p>
                    <p>Success: <span id="groq-success" class="font-medium text-green-600">0</span></p>
                    <p>Failed: <span id="groq-failed" class="font-medium text-red-500">0</span></p>
                    <p>Fallbacks: <span id="groq-fallbacks" class="font-medium text-gray-700">0</span></p>
                    <p id="groq-disabled" class="text-red-500 hidden">Disabled: <span></span></p>
                </div>
                <p id="groq-reason" class="text-red-500 text-[10px] mt-1 hidden max-w-[120px] truncate" title=""></p>
            </div>
            
            <!-- Z.ai -->
            <div class="border-r border-gray-100 pr-4 min-w-[100px]">
                <p id="zai-title" class="text-gray-500 text-xs font-medium uppercase">🔵 Z.ai</p>
                <p id="zai-status" class="text-gray-800 font-semibold leading-none mt-1">Ready</p>
                <div class="text-[10px] mt-2 space-y-0.5 text-gray-500">
                    <p>Reqs: <span id="zai-reqs" class="font-medium text-gray-700">0</span></p>
                    <p>Success: <span id="zai-success" class="font-medium text-green-600">0</span></p>
                    <p>Failed: <span id="zai-failed" class="font-medium text-red-500">0</span></p>
                    <p>Fallbacks: <span id="zai-fallbacks" class="font-medium text-gray-700">0</span></p>
                    <p id="zai-disabled" class="text-red-500 hidden">Disabled: <span></span></p>
                </div>
                <p id="zai-reason" class="text-red-500 text-[10px] mt-1 hidden max-w-[120px] truncate" title=""></p>
            </div>
            
            <!-- Local -->
            <div class="min-w-[100px]">
                <p class="text-gray-500 text-xs font-medium uppercase">⚪ Local</p>
                <p id="local-status" class="text-gray-800 font-semibold leading-none mt-1">Ready</p>
                <div class="text-[10px] mt-2 space-y-0.5 text-gray-500">
                    <p>Reqs: <span id="local-reqs" class="font-medium text-gray-700">0</span></p>
                    <p>Success: <span id="local-success" class="font-medium text-green-600">0</span></p>
                    <p>Failed: <span id="local-failed" class="font-medium text-red-500">0</span></p>
                </div>
            </div>
        </div>

        <!-- Pipeline Status Widget -->
        <div id="pipeline-widget" class="bg-white px-4 py-2 rounded-lg shadow-sm border border-gray-100 flex items-center gap-3">
            <div class="relative flex h-3 w-3">
                <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-gray-400 opacity-75"></span>
                <span class="relative inline-flex rounded-full h-3 w-3 bg-gray-500"></span>
            </div>
            <div class="text-sm">
                <p class="text-gray-800 font-medium leading-none">Status: Loading...</p>
                <p class="text-gray-500 text-xs mt-1 leading-none" id="pipeline-msg">Connecting to engine</p>
            </div>
        </div>
    </div>
</div>

<!-- Stats Grid with Skeletons -->
<div class="grid grid-cols-1 md:grid-cols-2 2xl:grid-cols-4 gap-4 md:gap-6 mb-8" id="stats-container">
    <!-- Skeleton Loaders -->
    <% for(let i=0; i<8; i++) { %>
    <div class="bg-white p-6 rounded-xl shadow-sm border border-gray-100 animate-pulse">
        <div class="h-4 bg-gray-200 rounded w-1/2 mb-4"></div>
        <div class="h-8 bg-gray-300 rounded w-1/3"></div>
    </div>
    <% } %>
</div>

<!-- Quick Actions & Activity -->
<div class="grid grid-cols-1 xl:grid-cols-3 gap-6 md:gap-8">
    
    <!-- Action Cards -->
    <div class="lg:col-span-1 space-y-6">
        <div class="bg-white p-6 rounded-xl shadow-sm border border-gray-100">
            <h3 class="text-lg font-semibold text-gray-800 mb-2">Manual Trigger</h3>
            <p class="text-gray-500 text-sm mb-4">Start the scraping and matching pipeline immediately.</p>
            <button onclick="triggerJobSearch()" class="w-full bg-primary hover:bg-primaryHover text-white py-2 px-4 min-h-[44px] rounded-lg font-medium transition shadow-sm flex items-center justify-center">
                <i class="fas fa-play mr-2"></i> Start Pipeline
            </button>
        </div>

        <div class="bg-white p-6 rounded-xl shadow-sm border border-gray-100 border-l-4 border-l-red-500">
            <h3 class="text-lg font-semibold text-gray-800 mb-2">Maintenance</h3>
            <p class="text-gray-500 text-sm mb-4">Clear raw un-matched scraped jobs to free up database space.</p>
            <button onclick="clearRawJobs()" class="w-full bg-white border border-gray-300 text-gray-700 hover:bg-gray-50 py-2 px-4 min-h-[44px] rounded-lg font-medium transition flex items-center justify-center">
                <i class="fas fa-trash-alt mr-2 text-red-500"></i> Clear Raw DB
            </button>
        </div>
    </div>

    <!-- Recent Logs -->
    <div class="xl:col-span-2 bg-white rounded-xl shadow-sm border border-gray-100 overflow-hidden flex flex-col h-96">
        <div class="p-4 border-b border-gray-100 flex justify-between items-center bg-gray-50 shrink-0">
            <h3 class="text-lg font-semibold text-gray-800"><i class="fas fa-terminal mr-2 text-gray-400"></i> System Logs</h3>
            <button onclick="fetchLogs()" class="text-gray-400 hover:text-primary transition" title="Refresh Logs"><i class="fas fa-sync-alt"></i></button>
        </div>
        <div class="p-4 overflow-y-auto flex-1 bg-gray-900" id="logs-container">
            <span class="text-gray-500 block">Loading logs...</span>
        </div>
    </div>

</div>

<script>
    let allLogs = [];
    let renderedCount = 20;
    const expandedLogs = new Set();
    const logNodes = new Map();

    function toggleLog(id) {
        if (expandedLogs.has(id)) {
            expandedLogs.delete(id);
        } else {
            expandedLogs.add(id);
        }
        
        const row = logNodes.get(id);
        if (row) {
            const log = allLogs.find(l => (l._id || l.pipelineId || id) === id);
            if (log) updateLogRow(row, log, id);
        }
    }

    function loadMoreLogs() {
        renderedCount += 20;
        renderLogs();
    }

    async function fetchLogs() {
        try {
            const res = await fetch("/api/jobs/logs");
            const data = await res.json();
            if(data.success && data.logs) {
                allLogs = data.logs;
                renderLogs();
            }
        } catch (e) {
            console.error("Failed to fetch logs", e);
        }
    }

    function renderLogs() {
        const container = document.getElementById('logs-container');
        if (allLogs.length === 0) {
            container.innerHTML = '<span class="text-gray-500 p-4 block">No logs found.</span>';
            logNodes.clear();
            return;
        }

        if (container.querySelector('span.text-gray-500.block')) {
            container.innerHTML = '';
        }

        const logsToRender = allLogs.slice(0, renderedCount);
        
        let loadMoreBtn = document.getElementById('load-more-btn');
        if (!loadMoreBtn) {
            loadMoreBtn = document.createElement('div');
            loadMoreBtn.id = 'load-more-btn';
            loadMoreBtn.className = 'text-center mt-4 mb-2';
            loadMoreBtn.innerHTML = `<button onclick="event.stopPropagation(); loadMoreLogs()" class="px-4 py-2 bg-gray-800 hover:bg-gray-700 text-gray-300 rounded text-xs font-medium transition-colors border border-gray-700"></button>`;
            container.appendChild(loadMoreBtn);
        }
        
        let previousNode = null;

        for (let i = 0; i < logsToRender.length; i++) {
            const log = logsToRender[i];
            const logId = log._id || log.pipelineId || `idx-${i}`;
            
            let row = logNodes.get(logId);
            if (!row) {
                row = createLogRow(log, logId);
                logNodes.set(logId, row);
                
                if (previousNode) {
                    previousNode.after(row);
                } else {
                    container.insertBefore(row, container.firstChild);
                }
            } else {
                updateLogRow(row, log, logId);
                
                if (previousNode && previousNode.nextSibling !== row) {
                    previousNode.after(row);
                } else if (!previousNode && container.firstChild !== row) {
                    container.insertBefore(row, container.firstChild);
                }
            }
            previousNode = row;
        }
        
        const btn = loadMoreBtn.querySelector('button');
        if (renderedCount < allLogs.length) {
            btn.textContent = `Load More (${allLogs.length - renderedCount} remaining)`;
            loadMoreBtn.style.display = 'block';
        } else {
            loadMoreBtn.style.display = 'none';
        }
    }

    function createLogRow(log, logId) {
        const div = document.createElement('div');
        div.onclick = () => toggleLog(logId);
        updateLogRow(div, log, logId);
        return div;
    }

    function updateLogRow(row, log, logId) {
        logId = logId || log._id || log.pipelineId;
        const isExpanded = expandedLogs.has(logId);
        
        const dateObj = new Date(log.startedAt || log.createdAt);
        const d = `${dateObj.toLocaleDateString('en-GB', {day:'numeric', month:'short', year:'numeric'})} ${dateObj.toLocaleTimeString('en-GB', {hour: '2-digit', minute:'2-digit', second:'2-digit'})}`;
        
        const source = log.triggerSource || "Manual";
        
        let badgeColor = 'text-green-500';
        let badgeIcon = '🟢';
        let statusText = 'SUCCESS';
        let borderColor = 'border-l-green-500';
        
        if (log.status === 'Failed') { 
            badgeColor = 'text-red-500'; badgeIcon = '🔴'; statusText = 'FAILED'; borderColor = 'border-l-red-500';
        } else if (log.status === 'Running') { 
            badgeColor = 'text-blue-500'; badgeIcon = '🔵'; statusText = 'RUNNING'; borderColor = 'border-l-blue-500';
        } else if (log.status === 'Partial Success' || log.status === 'Completed with Warnings') { 
            badgeColor = 'text-yellow-500'; badgeIcon = '🟡'; statusText = 'WARNING'; borderColor = 'border-l-yellow-500';
        } else if (log.status === 'Skipped') { 
            badgeColor = 'text-gray-400'; badgeIcon = '⚪'; statusText = 'SKIPPED'; borderColor = 'border-l-gray-400';
        } else if (log.status === 'Locked') {
            badgeColor = 'text-purple-500'; badgeIcon = '🟣'; statusText = 'LOCKED'; borderColor = 'border-l-purple-500';
        }
        
        row.className = `mb-3 bg-gray-800 rounded-lg border-l-4 ${borderColor} shadow-sm border-y border-r border-gray-700 hover:bg-gray-700 transition-colors cursor-pointer select-none`;
        
        const totalC = log.totalCompanies !== undefined ? log.totalCompanies : (log.companiesScanned !== undefined ? log.companiesScanned : 0);
        const totalJ = log.totalJobs !== undefined ? log.totalJobs : (log.jobsFound !== undefined ? log.jobsFound : 0);
        const durationSecs = log.durationMs ? Math.round(log.durationMs/1000) + 's' : '0s';
        const matchedJobs = log.jobsMatched !== undefined ? log.jobsMatched : 0;
        
        const geminiCount = log.geminiCount !== undefined ? log.geminiCount : 0;
        const groqCount = log.groqCount !== undefined ? log.groqCount : 0;
        const zaiCount = log.zaiCount !== undefined ? log.zaiCount : 0;
        const localCount = log.localCount !== undefined ? log.localCount : 0;
        
        const pipelineIdDisplay = log.pipelineId ? log.pipelineId.substring(0,8) + '...' : 'N/A';
        
        let expandedContent = '';
        if (isExpanded) {
            if (log.status === 'Skipped' || log.status === 'Locked') {
                expandedContent = `
                    <div class="mt-4 pt-3 border-t border-gray-700 grid grid-cols-1 md:grid-cols-2 gap-4 text-xs cursor-text select-text" onclick="event.stopPropagation()">
                        <div><span class="text-gray-500 block mb-1">Reason</span><span class="text-gray-200">${log.skipReason || log.message || 'Unknown'}</span></div>
                        <div><span class="text-gray-500 block mb-1">Current Runner</span><span class="text-gray-200">${log.currentRunner || log.runnerId || 'N/A'}</span></div>
                        <div><span class="text-gray-500 block mb-1">Expected Unlock</span><span class="text-gray-200">${log.expectedUnlock ? new Date(log.expectedUnlock).toLocaleTimeString() : 'N/A'}</span></div>
                    </div>
                `;
            } else if (log.status === 'Failed') {
                expandedContent = `
                    <div class="mt-4 pt-3 border-t border-gray-700 grid grid-cols-1 gap-4 text-xs cursor-text select-text" onclick="event.stopPropagation()">
                        <div class="grid grid-cols-2 md:grid-cols-4 gap-4">
                            <div><span class="text-gray-500 block mb-1">Pipeline ID</span><span class="text-gray-200 font-mono">${log.pipelineId || 'N/A'}</span></div>
                            <div><span class="text-gray-500 block mb-1">Runner</span><span class="text-gray-200">${log.runnerId || 'N/A'}</span></div>
                            <div><span class="text-gray-500 block mb-1">Error Type</span><span class="text-red-400">${log.errorType || 'Error'}</span></div>
                            <div><span class="text-gray-500 block mb-1">Company</span><span class="text-gray-200">${log.companyBeingProcessed || 'N/A'}</span></div>
                        </div>
                        <div><span class="text-gray-500 block mb-1">Current Stage</span><span class="text-gray-200">${log.currentStage || 'N/A'}</span></div>
                        <div><span class="text-gray-500 block mb-1">Message</span><span class="text-red-400">${log.message || 'N/A'}</span></div>
                        ${log.stackTrace ? `<div><span class="text-gray-500 block mb-1">Stack Trace</span><pre class="text-[10px] text-gray-400 bg-gray-900 p-2 rounded overflow-x-auto max-h-32 whitespace-pre-wrap">${log.stackTrace}</pre></div>` : ''}
                    </div>
                `;
            } else if (log.status === 'Running') {
                expandedContent = `
                    <div class="mt-4 pt-3 border-t border-gray-700 grid grid-cols-2 md:grid-cols-4 gap-4 text-xs cursor-text select-text" onclick="event.stopPropagation()">
                        <div><span class="text-gray-500 block mb-1">Pipeline ID</span><span class="text-gray-200 font-mono">${log.pipelineId || 'N/A'}</span></div>
                        <div><span class="text-gray-500 block mb-1">Runner</span><span class="text-gray-200">${log.runnerId || 'N/A'}</span></div>
                        <div><span class="text-gray-500 block mb-1">Start Time</span><span class="text-gray-200">${log.startedAt ? new Date(log.startedAt).toLocaleTimeString() : 'N/A'}</span></div>
                        <div><span class="text-gray-500 block mb-1">Current Stage</span><span class="text-gray-200">${log.currentStage || 'N/A'}</span></div>
                        
                        <div><span class="text-gray-500 block mb-1">Current Company</span><span class="text-blue-400">${log.currentCompany || 'N/A'}</span></div>
                        <div><span class="text-gray-500 block mb-1">Progress</span><span class="text-gray-200">${log.currentCompanyIndex !== undefined ? log.currentCompanyIndex + ' / ' + (log.totalCompanies || '?') : 'N/A'}</span></div>
                        
                        <div><span class="text-gray-500 block mb-1">Jobs Found</span><span class="text-gray-200">${totalJ}</span></div>
                        <div><span class="text-gray-500 block mb-1">Matched Jobs</span><span class="text-green-400">${matchedJobs}</span></div>
                    </div>
                `;
            } else {
                expandedContent = `
                    <div class="mt-4 pt-3 border-t border-gray-700 grid grid-cols-2 md:grid-cols-4 gap-4 text-xs cursor-text select-text" onclick="event.stopPropagation()">
                        <div><span class="text-gray-500 block mb-1">Pipeline ID</span><span class="text-gray-200 font-mono">${log.pipelineId || 'N/A'}</span></div>
                        <div><span class="text-gray-500 block mb-1">Runner</span><span class="text-gray-200">${log.runnerId || 'N/A'}</span></div>
                        <div><span class="text-gray-500 block mb-1">Trigger</span><span class="text-gray-200">${log.triggerSource || 'Manual'}</span></div>
                        <div><span class="text-gray-500 block mb-1">Started</span><span class="text-gray-200">${log.startedAt ? new Date(log.startedAt).toLocaleTimeString() : 'N/A'}</span></div>
                        
                        <div><span class="text-gray-500 block mb-1">Finished</span><span class="text-gray-200">${log.completedAt ? new Date(log.completedAt).toLocaleTimeString() : 'N/A'}</span></div>
                        <div><span class="text-gray-500 block mb-1">Duration</span><span class="text-gray-200">${durationSecs}</span></div>
                        <div><span class="text-gray-500 block mb-1">Companies Successful</span><span class="text-green-400">${log.successfulCompanies !== undefined ? log.successfulCompanies : 0}</span></div>
                        <div><span class="text-gray-500 block mb-1">Companies Failed</span><span class="text-red-400">${log.failedCompanies !== undefined ? log.failedCompanies : 0}</span></div>
                        
                        <div><span class="text-gray-500 block mb-1">Duplicate Jobs</span><span class="text-gray-200">${log.duplicateJobs !== undefined ? log.duplicateJobs : (log.duplicatesRemoved !== undefined ? log.duplicatesRemoved : 0)}</span></div>
                        <div><span class="text-gray-500 block mb-1">Jobs Evaluated</span><span class="text-gray-200">${log.jobsEvaluated !== undefined ? log.jobsEvaluated : 0}</span></div>
                        <div><span class="text-gray-500 block mb-1">Matched Jobs</span><span class="text-gray-200">${matchedJobs}</span></div>
                        <div><span class="text-gray-500 block mb-1">Provider Used</span><span class="text-gray-200">${log.provider || 'None'}</span></div>
                        
                        <div><span class="text-gray-500 block mb-1">Gemini (R/S/F)</span><span class="text-purple-400">${geminiCount}/${log.geminiSuccess||0}/${log.geminiFailed||0}</span></div>
                        <div><span class="text-gray-500 block mb-1">Groq (R/S/F)</span><span class="text-orange-400">${groqCount}/${log.groqSuccess||0}/${log.groqFailed||0}</span></div>
                        <div><span class="text-gray-500 block mb-1">Z.ai (R/S/F)</span><span class="text-blue-400">${zaiCount}/${log.zaiSuccess||0}/${log.zaiFailed||0}</span></div>
                        <div><span class="text-gray-500 block mb-1">Local (R/S/F)</span><span class="text-gray-200">${localCount}/${log.localSuccess||0}/${log.localFailed||0}</span></div>
                        
                        <div><span class="text-gray-500 block mb-1">Gemini Fallbacks</span><span class="text-purple-400">${log.geminiFallbacks || 0}</span></div>
                        <div><span class="text-gray-500 block mb-1">Groq Fallbacks</span><span class="text-orange-400">${log.groqFallbacks || 0}</span></div>
                        <div><span class="text-gray-500 block mb-1">Z.ai Fallbacks</span><span class="text-blue-400">${log.zaiFallbacks || 0}</span></div>
                        <div><span class="text-gray-500 block mb-1">Avg Company Time</span><span class="text-gray-200">${log.avgCompanyTimeMs !== undefined ? Math.round(log.avgCompanyTimeMs) + 'ms' : '0ms'}</span></div>
                        
                        <div><span class="text-gray-500 block mb-1">Avg AI Time</span><span class="text-gray-200">${log.avgAiTimeMs !== undefined ? Math.round(log.avgAiTimeMs) + 'ms' : '0ms'}</span></div>
                        <div><span class="text-gray-500 block mb-1">Failure Reason</span><span class="text-red-400">${log.message || log.errorType || 'None'}</span></div>
                        <div><span class="text-gray-500 block mb-1">Current Stage</span><span class="text-gray-200">${log.currentStage || 'Finished'}</span></div>
                        <div><span class="text-gray-500 block mb-1">Company Being Processed</span><span class="text-gray-200">${log.companyBeingProcessed || 'None'}</span></div>

                        ${log.stackTrace ? `<div class="col-span-full"><span class="text-gray-500 block mb-1">Stack Trace</span><pre class="text-[10px] text-gray-400 bg-gray-900 p-2 rounded overflow-x-auto max-h-32 whitespace-pre-wrap">${log.stackTrace}</pre></div>` : ''}
                        ${log.warnings && log.warnings.length > 0 ? `<div class="col-span-full"><span class="text-gray-500 block mb-1">Warnings</span><ul class="text-yellow-400 list-disc pl-4 space-y-1">${log.warnings.map(w => `<li>${w}</li>`).join('')}</ul></div>` : ''}
                        ${log.errors && log.errors.length > 0 ? `<div class="col-span-full"><span class="text-gray-500 block mb-1">Errors</span><ul class="text-red-400 list-disc pl-4 space-y-1">${log.errors.map(e => `<li>${e}</li>`).join('')}</ul></div>` : ''}
                    </div>
                `;
            }
        }
        
        let liveUpdateBadge = '';
        if (log.status === 'Running' && !isExpanded) {
            liveUpdateBadge = `
                <div class="hidden md:flex items-center gap-2 bg-blue-900/30 px-2 py-1 rounded border border-blue-500/30 text-[10px]">
                    <span class="text-blue-400 animate-pulse">●</span>
                    <span class="text-gray-300 truncate max-w-[150px]">${log.currentCompany || 'Initializing...'}</span>
                    <span class="text-gray-500">${log.currentStage || ''}</span>
                </div>
            `;
        }

        row.innerHTML = `
            <div class="p-3">
                <div class="flex flex-col xl:flex-row xl:items-center justify-between gap-3">
                    <div class="flex flex-1 items-center gap-4 min-w-0">
                        <div class="w-24 shrink-0 font-bold text-xs tracking-wider uppercase ${badgeColor}">
                            ${badgeIcon} ${statusText}
                        </div>
                        <div class="flex flex-wrap items-center gap-x-3 gap-y-1 text-[11px] text-gray-400">
                            <span>${d}</span>
                            <span class="hidden sm:inline">&bull;</span>
                            <span class="text-gray-200 font-medium">${source}</span>
                            <span class="hidden sm:inline">&bull;</span>
                            <span class="text-gray-300" title="Runner"><i class="fas fa-server mr-1 text-gray-500"></i>${log.runnerId || 'N/A'}</span>
                            <span class="hidden sm:inline">&bull;</span>
                            <span><i class="fas fa-clock mr-1"></i>${durationSecs}</span>
                            <span class="hidden md:inline">&bull;</span>
                            <span class="hidden md:inline font-mono text-gray-500">${pipelineIdDisplay}</span>
                        </div>
                        ${liveUpdateBadge}
                    </div>
                    
                    <div class="flex shrink-0 flex-wrap items-center justify-end gap-3 text-[11px]">
                        ${totalC !== 'N/A' || totalJ !== 'N/A' ? `
                        <div class="flex gap-3 bg-gray-900/50 rounded px-3 py-1.5 border border-gray-700/50">
                            <div title="Companies"><i class="fas fa-building text-gray-500 mr-1"></i><span class="text-gray-200 font-medium">${totalC}</span></div>
                            <div title="Jobs Found"><i class="fas fa-search text-gray-500 mr-1"></i><span class="text-gray-200 font-medium">${totalJ}</span></div>
                            <div title="Jobs Evaluated"><i class="fas fa-robot text-gray-500 mr-1"></i><span class="text-gray-200 font-medium">${log.jobsEvaluated !== undefined ? log.jobsEvaluated : 'N/A'}</span></div>
                            <div title="Matched Jobs"><i class="fas fa-check-double text-green-500/70 mr-1"></i><span class="text-green-400 font-medium">${matchedJobs}</span></div>
                        </div>
                        ` : ''}
                        
                        <div class="flex gap-2 bg-gray-900/50 rounded px-2 py-1.5 border border-gray-700/50" title="AI Usage">
                            <span class="text-purple-400">🟣 Gemini: ${geminiCount}</span>
                            <span class="text-orange-400">🟠 Groq: ${groqCount}</span>
                            <span class="text-blue-400">🔵 Z.ai: ${zaiCount}</span>
                            <span class="text-gray-300">⚪ Local: ${localCount}</span>
                        </div>
                        
                        <div class="text-gray-400 hover:text-white font-medium ml-2 w-16 text-right transition-colors">
                            ${isExpanded ? '▲ Hide' : '▼ Details'}
                        </div>
                    </div>
                </div>
                ${expandedContent}
            </div>
        `;
    }

