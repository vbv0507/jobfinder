<%- include('partials/header') %>

<!-- Dashboard Content -->
<div class="mb-8 flex flex-col md:flex-row md:justify-between md:items-end gap-4">
    <div>
        <h2 class="text-2xl font-bold text-gray-900">Platform Overview</h2>
        <p class="text-gray-500 text-sm mt-1">Real-time statistics of your Job Intelligence Engine.</p>
    </div>
    
    <div class="flex flex-col sm:flex-row gap-4">
        <!-- AI Status Widget -->
        <div class="bg-white px-4 py-2 rounded-lg shadow-sm border border-gray-100 flex items-center gap-3">
            <div class="text-sm border-r border-gray-100 pr-3">
                <p id="gemini-title" class="text-gray-500 text-xs font-medium uppercase">🟢 Gemini</p>
                <div class="flex flex-col">
                    <p id="gemini-status" class="text-gray-800 font-semibold leading-none mt-1">Ready</p>
                    <p id="gemini-reason" class="text-red-500 text-[10px] mt-1 hidden max-w-[100px] truncate" title=""></p>
                </div>
            </div>
            <div class="text-sm border-r border-gray-100 pr-3">
                <p id="groq-title" class="text-gray-500 text-xs font-medium uppercase">🟠 Groq</p>
                <div class="flex flex-col">
                    <p id="groq-status" class="text-gray-800 font-semibold leading-none mt-1">Ready</p>
                    <p id="groq-reason" class="text-red-500 text-[10px] mt-1 hidden max-w-[100px] truncate" title=""></p>
                </div>
            </div>
            <div class="text-sm">
                <p class="text-gray-500 text-xs font-medium uppercase">⚪ Local</p>
                <p id="local-status" class="text-gray-800 font-semibold leading-none mt-1">Ready</p>
            </div>
        </div>

        <!-- Pipeline Status Widget -->
        <div id="pipeline-widget" class="bg-white px-4 py-2 rounded-lg shadow-sm border border-gray-100 flex items-center gap-3">
            <div class="relative flex h-3 w-3">
                <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-gray-400 opacity-75"></span>
                <span class="relative inline-flex rounded-full h-3 w-3 bg-gray-500"></span>
            </div>
            <div class="text-sm">
                <p class="text-gray-800 font-medium leading-none">Status: Loading...</p>
                <p class="text-gray-500 text-xs mt-1 leading-none" id="pipeline-msg">Connecting to engine</p>
            </div>
        </div>
    </div>
</div>

<!-- Stats Grid with Skeletons -->
<div class="grid grid-cols-1 md:grid-cols-2 2xl:grid-cols-4 gap-4 md:gap-6 mb-8" id="stats-container">
    <!-- Skeleton Loaders -->
    <% for(let i=0; i<8; i++) { %>
    <div class="bg-white p-6 rounded-xl shadow-sm border border-gray-100 animate-pulse">
        <div class="h-4 bg-gray-200 rounded w-1/2 mb-4"></div>
        <div class="h-8 bg-gray-300 rounded w-1/3"></div>
    </div>
    <% } %>
</div>

<!-- Quick Actions & Activity -->
<div class="grid grid-cols-1 xl:grid-cols-3 gap-6 md:gap-8">
    
    <!-- Action Cards -->
    <div class="lg:col-span-1 space-y-6">
        <div class="bg-white p-6 rounded-xl shadow-sm border border-gray-100">
            <h3 class="text-lg font-semibold text-gray-800 mb-2">Manual Trigger</h3>
            <p class="text-gray-500 text-sm mb-4">Start the scraping and matching pipeline immediately.</p>
            <button onclick="triggerJobSearch()" class="w-full bg-primary hover:bg-primaryHover text-white py-2 px-4 min-h-[44px] rounded-lg font-medium transition shadow-sm flex items-center justify-center">
                <i class="fas fa-play mr-2"></i> Start Pipeline
            </button>
        </div>

        <div class="bg-white p-6 rounded-xl shadow-sm border border-gray-100 border-l-4 border-l-red-500">
            <h3 class="text-lg font-semibold text-gray-800 mb-2">Maintenance</h3>
            <p class="text-gray-500 text-sm mb-4">Clear raw un-matched scraped jobs to free up database space.</p>
            <button onclick="clearRawJobs()" class="w-full bg-white border border-gray-300 text-gray-700 hover:bg-gray-50 py-2 px-4 min-h-[44px] rounded-lg font-medium transition flex items-center justify-center">
                <i class="fas fa-trash-alt mr-2 text-red-500"></i> Clear Raw DB
            </button>
        </div>
    </div>

    <!-- Recent Logs -->
    <div class="xl:col-span-2 bg-white rounded-xl shadow-sm border border-gray-100 overflow-hidden flex flex-col h-96">
        <div class="p-4 border-b border-gray-100 flex justify-between items-center bg-gray-50 shrink-0">
            <h3 class="text-lg font-semibold text-gray-800"><i class="fas fa-terminal mr-2 text-gray-400"></i> System Logs</h3>
            <button onclick="fetchLogs()" class="text-gray-400 hover:text-primary transition" title="Refresh Logs"><i class="fas fa-sync-alt"></i></button>
        </div>
        <div class="p-4 overflow-y-auto flex-1 bg-gray-900 text-green-400 font-mono text-sm space-y-2 break-words whitespace-pre-wrap" id="logs-container">
            Loading logs...
        </div>
    </div>

</div>

<script>
    async function loadDashboard() {
        try {
            const res = await fetch("/api/jobs/analytics");
            const data = await res.json();
            
            if(data.success) {
                const s = data.stats;
                document.getElementById('stats-container').innerHTML = `
                    <!-- Row 1 -->
                    <div class="bg-white p-6 rounded-xl shadow-sm border border-gray-100 relative overflow-hidden group">
                        <div class="absolute right-0 top-0 mt-4 mr-4 text-blue-100 group-hover:scale-110 transition-transform"><i class="fas fa-building text-4xl"></i></div>
                        <h4 class="text-gray-500 text-sm font-medium uppercase tracking-wider">Companies</h4>
                        <p class="text-3xl font-bold text-gray-800 mt-2">${s.companiesMonitored}</p>
                    </div>
                    <div class="bg-white p-6 rounded-xl shadow-sm border border-gray-100 relative overflow-hidden group">
                        <div class="absolute right-0 top-0 mt-4 mr-4 text-indigo-100 group-hover:scale-110 transition-transform"><i class="fas fa-search text-4xl"></i></div>
                        <h4 class="text-gray-500 text-sm font-medium uppercase tracking-wider">Scraped Today</h4>
                        <p class="text-3xl font-bold text-gray-800 mt-2">${s.rawJobsToday}</p>
                    </div>
                    <div class="bg-white p-6 rounded-xl shadow-sm border border-gray-100 relative overflow-hidden group">
                        <div class="absolute right-0 top-0 mt-4 mr-4 text-purple-100 group-hover:scale-110 transition-transform"><i class="fas fa-brain text-4xl"></i></div>
                        <h4 class="text-gray-500 text-sm font-medium uppercase tracking-wider">AI Evaluated</h4>
                        <p class="text-3xl font-bold text-gray-800 mt-2">${s.aiEvaluatedCount}</p>
                    </div>
                    <div class="bg-white p-6 rounded-xl shadow-sm border border-gray-100 relative overflow-hidden group border-l-4 border-l-green-500">
                        <div class="absolute right-0 top-0 mt-4 mr-4 text-green-100 group-hover:scale-110 transition-transform"><i class="fas fa-check-double text-4xl"></i></div>
                        <h4 class="text-gray-500 text-sm font-medium uppercase tracking-wider">Matched</h4>
                        <p class="text-3xl font-bold text-gray-800 mt-2">${s.matchedJobsCount}</p>
                    </div>
                    
                    <!-- Row 2 -->
                    <div class="bg-white p-6 rounded-xl shadow-sm border border-gray-100 relative overflow-hidden group border-l-4 border-l-yellow-400">
                        <div class="absolute right-0 top-0 mt-4 mr-4 text-yellow-100 group-hover:scale-110 transition-transform"><i class="fas fa-bookmark text-4xl"></i></div>
                        <h4 class="text-gray-500 text-sm font-medium uppercase tracking-wider">Saved</h4>
                        <p class="text-3xl font-bold text-gray-800 mt-2">${s.savedJobsCount}</p>
                    </div>
                    <div class="bg-white p-6 rounded-xl shadow-sm border border-gray-100 relative overflow-hidden group border-l-4 border-l-primary">
                        <div class="absolute right-0 top-0 mt-4 mr-4 text-primary opacity-10 group-hover:scale-110 transition-transform"><i class="fas fa-paper-plane text-4xl"></i></div>
                        <h4 class="text-gray-500 text-sm font-medium uppercase tracking-wider">Applied</h4>
                        <p class="text-3xl font-bold text-gray-800 mt-2">${s.appliedJobsCount}</p>
                    </div>
                    <div class="bg-white p-6 rounded-xl shadow-sm border border-gray-100 relative overflow-hidden group border-l-4 border-l-red-500">
                        <div class="absolute right-0 top-0 mt-4 mr-4 text-red-100 group-hover:scale-110 transition-transform"><i class="fas fa-times-circle text-4xl"></i></div>
                        <h4 class="text-gray-500 text-sm font-medium uppercase tracking-wider">Rejected</h4>
                        <p class="text-3xl font-bold text-gray-800 mt-2">${s.rejectedJobsCount}</p>
                    </div>
                    <div class="bg-white p-6 rounded-xl shadow-sm border border-gray-100 flex flex-col justify-center">
                        <h4 class="text-gray-500 text-xs font-medium uppercase tracking-wider">Next Run</h4>
                        <p class="text-sm font-bold text-gray-800 mt-1">${s.nextScheduledRun || 'Unknown'}</p>
                        <h4 class="text-gray-500 text-xs font-medium uppercase tracking-wider mt-3">Last Success</h4>
                        <p class="text-sm font-bold text-gray-800 mt-1">${s.lastSuccessfulRun ? new Date(s.lastSuccessfulRun).toLocaleString() : 'Never'}</p>
                    </div>
                    
                    <!-- Row 3: Historical Statistics -->
                    <div class="bg-white p-4 rounded-xl shadow-sm border border-gray-100 relative overflow-hidden group">
                        <h4 class="text-gray-500 text-xs font-medium uppercase tracking-wider">Avg Runtime</h4>
                        <p class="text-xl font-bold text-gray-800 mt-1">${s.avgRuntimeMs ? (s.avgRuntimeMs/1000).toFixed(1) + 's' : '0s'}</p>
                    </div>
                    <div class="bg-white p-4 rounded-xl shadow-sm border border-gray-100 relative overflow-hidden group">
                        <h4 class="text-gray-500 text-xs font-medium uppercase tracking-wider">Success Rate</h4>
                        <p class="text-xl font-bold text-green-600 mt-1">${s.successRate}%</p>
                    </div>
                    <div class="bg-white p-4 rounded-xl shadow-sm border border-gray-100 relative overflow-hidden group">
                        <h4 class="text-gray-500 text-xs font-medium uppercase tracking-wider">Failure Rate</h4>
                        <p class="text-xl font-bold text-red-500 mt-1">${s.failureRate}%</p>
                    </div>
                    <div class="bg-white p-4 rounded-xl shadow-sm border border-gray-100 relative overflow-hidden group">
                        <h4 class="text-gray-500 text-xs font-medium uppercase tracking-wider">Avg Jobs / Match</h4>
                        <p class="text-xl font-bold text-gray-800 mt-1">${s.avgJobsFound} / ${s.avgMatches}</p>
                    </div>
                `;
            }
        } catch(e) {
            console.error(e);
        }
    }

    async function fetchLogs() {
        const container = document.getElementById('logs-container');
        container.innerHTML = '<span class="text-gray-500">Fetching logs...</span>';
        try {
            const res = await fetch("/api/jobs/logs");
            const data = await res.json();
            if(data.success && data.logs.length > 0) {
                container.innerHTML = data.logs.map(log => {
                    const dateObj = new Date(log.startedAt || log.createdAt);
                    
                    const d = `[${dateObj.toLocaleDateString('en-GB')} ${dateObj.toLocaleTimeString('en-GB', {hour: '2-digit', minute:'2-digit'})}]`;
                    
                    const source = log.triggerSource || "Manual";
                    
                    let badgeColor = 'bg-green-500/20 text-green-400 border border-green-500/30';
                    if (log.status === 'Failed') { badgeColor = 'bg-red-500/20 text-red-400 border border-red-500/30'; }
                    else if (log.status === 'Running' || log.status === 'Partial Success') { badgeColor = 'bg-yellow-500/20 text-yellow-400 border border-yellow-500/30'; }
                    else if (log.status === 'Skipped') { badgeColor = 'bg-gray-500/20 text-gray-400 border border-gray-500/30'; }
                    
                    let contentHTML = '';
                    if (log.status === 'Skipped') {
                        contentHTML = `
                            <div class="text-gray-400 mb-2">Reason: ${log.skipReason || 'Unknown'}</div>
                            <div class="grid grid-cols-2 gap-1 text-xs">
                                <div class="text-gray-500">Current Runner:</div>
                                <div class="text-gray-300">${log.currentRunner || '-'}</div>
                                <div class="text-gray-500">Expected Unlock:</div>
                                <div class="text-gray-300">${log.expectedUnlock ? new Date(log.expectedUnlock).toLocaleTimeString() : '-'}</div>
                            </div>
                        `;
                    } else if (log.status === 'Failed') {
                        contentHTML = `
                            <div class="text-red-400 mb-2">${log.errorType || 'Error'}: ${log.message}</div>
                            <div class="grid grid-cols-2 gap-1 text-xs">
                                <div class="text-gray-500">Company:</div>
                                <div class="text-gray-300">${log.companyBeingProcessed || '-'}</div>
                                <div class="text-gray-500">Stage:</div>
                                <div class="text-gray-300">${log.currentStage || '-'}</div>
                            </div>
                        `;
                    } else if (log.status === 'Running') {
                        contentHTML = `<div class="text-yellow-400">Pipeline is currently executing...</div>`;
                    } else if (log.totalCompanies !== undefined || log.companiesScanned !== undefined) {
                        const totalC = log.totalCompanies !== undefined ? log.totalCompanies : log.companiesScanned;
                        const totalJ = log.totalJobs !== undefined ? log.totalJobs : log.jobsFound;
                        const durationSecs = log.durationMs ? Math.round(log.durationMs/1000) : 0;
                        contentHTML = `
                            <div class="grid grid-cols-2 gap-y-1 gap-x-4 text-xs mb-2">
                                <div class="text-gray-500">Duration:</div>
                                <div class="text-gray-300">${durationSecs}s</div>
                                <div class="text-gray-500">Companies:</div>
                                <div class="text-gray-300">${totalC}</div>
                                <div class="text-gray-500">Jobs Found:</div>
                                <div class="text-gray-300">${totalJ}</div>
                                <div class="text-gray-500">Matched Jobs:</div>
                                <div class="text-green-400 font-medium">${log.jobsMatched || 0}</div>
                            </div>
                            <div class="border-t border-gray-700 pt-1 mt-1">
                                <div class="text-gray-400 text-[10px] uppercase tracking-wider mb-1">AI Provider Stats</div>
                                <div class="grid grid-cols-3 gap-1 text-xs">
                                    <div><span class="text-gray-500">Gemini:</span> <span class="text-gray-300">${log.geminiCount || 0}</span></div>
                                    <div><span class="text-gray-500">Groq:</span> <span class="text-gray-300">${log.groqCount || 0}</span></div>
                                    <div><span class="text-gray-500">Local:</span> <span class="text-gray-300">${log.localCount || 0}</span></div>
                                </div>
                            </div>
                        `;
                    } else {
                        contentHTML = `<div class="text-gray-400">${log.message || 'Legacy Log'}</div>`;
                    }
                    
                    return `
                    <div class="mb-4 bg-gray-800 rounded-lg p-3 border border-gray-700">
                        <div class="flex justify-between items-start mb-2">
                            <div class="inline-block px-2 py-0.5 rounded text-[10px] font-bold uppercase tracking-wider ${badgeColor}">${log.status || 'Success'}</div>
                            <div class="text-gray-500 text-[10px]">${d}</div>
                        </div>
                        <div class="text-xs text-gray-400 mb-2">
                            <div>ID: <span class="text-gray-300 font-mono">${log.pipelineId || 'N/A'}</span></div>
                            <div>Source: <span class="text-white">${source}</span></div>
                        </div>
                        <div class="space-y-1">
                            ${contentHTML}
                        </div>
                    </div>`;
                }).join("");
            } else {
                container.innerHTML = '<span class="text-gray-500">No logs found.</span>';
            }
        } catch (e) {
            container.innerHTML = '<span class="text-red-400">Failed to load logs.</span>';
        }
    }
    
    async function fetchPipelineStatus() {
        try {
            const res = await fetch("/api/jobs/status");
            const data = await res.json();
            if(data.success) {
                const s = data.state;
                const widget = document.getElementById('pipeline-widget');
                
                // Update AI provider statuses
                const geminiStatusEl = document.getElementById('gemini-status');
                const geminiTitleEl = document.getElementById('gemini-title');
                const geminiReasonEl = document.getElementById('gemini-reason');
                
                if (geminiStatusEl && s.geminiStatus) {
                    geminiStatusEl.innerText = s.geminiStatus;
                    if (s.geminiStatus === 'Unavailable') {
                        geminiStatusEl.className = "text-red-500 font-semibold leading-none mt-1";
                        if (geminiTitleEl) geminiTitleEl.innerText = "🔴 Gemini";
                        if (geminiReasonEl && s.geminiReason) {
                            geminiReasonEl.innerText = s.geminiReason;
                            geminiReasonEl.title = s.geminiReason;
                            geminiReasonEl.classList.remove('hidden');
                        }
                    } else {
                        geminiStatusEl.className = "text-gray-800 font-semibold leading-none mt-1";
                        if (geminiTitleEl) geminiTitleEl.innerText = "🟢 Gemini";
                        if (geminiReasonEl) geminiReasonEl.classList.add('hidden');
                    }
                }

                const groqStatusEl = document.getElementById('groq-status');
                const groqTitleEl = document.getElementById('groq-title');
                const groqReasonEl = document.getElementById('groq-reason');

                if (groqStatusEl && s.groqStatus) {
                    groqStatusEl.innerText = s.groqStatus;
                    if (s.groqStatus === 'Unavailable') {
                        groqStatusEl.className = "text-red-500 font-semibold leading-none mt-1";
                        if (groqTitleEl) groqTitleEl.innerText = "🔴 Groq";
                        if (groqReasonEl && s.groqReason) {
                            groqReasonEl.innerText = s.groqReason;
                            groqReasonEl.title = s.groqReason;
                            groqReasonEl.classList.remove('hidden');
                        }
                    } else {
                        groqStatusEl.className = "text-gray-800 font-semibold leading-none mt-1";
                        if (groqTitleEl) groqTitleEl.innerText = "🟠 Groq";
                        if (groqReasonEl) groqReasonEl.classList.add('hidden');
                    }
                }
                
                let dotColor = 'bg-gray-400';
                let pingColor = 'bg-gray-400';
                
                if (s.status === 'Running') {
                    dotColor = 'bg-primary';
                    pingColor = 'bg-primary';
                    
                    let extraInfo = '';
                    if (s.currentCompany || s.currentStage) {
                        extraInfo = `
                            <div class="mt-3 text-xs border-t border-gray-100 pt-2 space-y-1">
                                <div class="flex justify-between">
                                    <span class="text-gray-500">Stage:</span>
                                    <span class="font-medium text-gray-800">${s.currentStage || '-'}</span>
                                </div>
                                <div class="flex justify-between">
                                    <span class="text-gray-500">Target:</span>
                                    <span class="font-medium text-primary truncate max-w-[120px] text-right" title="${s.currentCompany || '-'}">${s.currentCompany || '-'}</span>
                                </div>
                                <div class="flex justify-between">
                                    <span class="text-gray-500">Progress:</span>
                                    <span class="font-medium text-gray-800">${s.progress || '-'}</span>
                                </div>
                                <div class="flex justify-between">
                                    <span class="text-gray-500">ETA:</span>
                                    <span class="font-medium text-gray-800">${s.estimatedRemainingTime ? Math.round(s.estimatedRemainingTime/1000) + 's' : '-'}</span>
                                </div>
                                <div class="flex justify-between">
                                    <span class="text-gray-500">AI Engine:</span>
                                    <span class="font-medium text-gray-800">${s.currentAiProvider || '-'}</span>
                                </div>
                            </div>
                        `;
                    }
                    
                    widget.innerHTML = `
                        <div class="flex items-start gap-3 w-full min-w-[240px]">
                            <div class="relative flex h-3 w-3 mt-1 shrink-0">
                                <span class="animate-ping absolute inline-flex h-full w-full rounded-full ${pingColor} opacity-75"></span>
                                <span class="relative inline-flex rounded-full h-3 w-3 ${dotColor}"></span>
                            </div>
                            <div class="text-sm w-full">
                                <p class="text-gray-800 font-medium leading-none">Pipeline: ${s.status}</p>
                                <p class="text-gray-500 text-xs mt-1 leading-none" title="${s.message}">${s.message.length > 30 ? s.message.substring(0,30) + '...' : s.message}</p>
                                ${extraInfo}
                            </div>
                        </div>
                    `;
                } else {
                    if (s.status === 'Completed' || s.status === 'Idle') {
                        dotColor = 'bg-green-500';
                    } else if (s.status === 'Completed with Warnings') {
                        dotColor = 'bg-yellow-500';
                    } else if (s.status === 'Failed') {
                        dotColor = 'bg-red-500';
                    }
                    widget.innerHTML = `
                        <div class="relative flex h-3 w-3">
                            <span class="relative inline-flex rounded-full h-3 w-3 ${dotColor}"></span>
                        </div>
                        <div class="text-sm">
                            <p class="text-gray-800 font-medium leading-none">Pipeline: ${s.status}</p>
                            <p class="text-gray-500 text-xs mt-1 leading-none" title="${s.message}">${s.message.length > 30 ? s.message.substring(0,30) + '...' : s.message}</p>
                        </div>
                    `;
                }
            }
        } catch (e) {}
    }

    async function clearRawJobs() {
        if(!confirm("Are you sure you want to delete all raw job data?")) return;
        try {
            const res = await fetch("/api/jobs/raw", { method: "DELETE" });
            const data = await res.json();
            if(data.success) alert(data.message);
        } catch(e) {
            alert("Error clearing raw jobs");
        }
    }

    document.addEventListener("DOMContentLoaded", () => {
        loadDashboard();
        fetchLogs();
        fetchPipelineStatus();
        
        // Poll pipeline status every 5 seconds
        setInterval(fetchPipelineStatus, 5000);
    });
</script>

<%- include('partials/footer') %>
