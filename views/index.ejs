    async function fetchPipelineStatus() {
        try {
            const res = await fetch("/api/jobs/status");
            const data = await res.json();
            if(data.success) {
                const s = data.state;
                const widget = document.getElementById('pipeline-widget');
                
                // Update AI provider statuses
                const geminiStatusEl = document.getElementById('gemini-status');
                const geminiTitleEl = document.getElementById('gemini-title');
                const geminiReasonEl = document.getElementById('gemini-reason');
                
                if (geminiStatusEl && s.geminiStatus) {
                    geminiStatusEl.innerText = s.geminiStatus;
                    document.getElementById('gemini-reqs').innerText = s.geminiRequests || 0;
                    document.getElementById('gemini-success').innerText = s.geminiSuccess || 0;
                    document.getElementById('gemini-failed').innerText = s.geminiFailed || 0;
                    document.getElementById('gemini-fallbacks').innerText = s.geminiFallbacks || 0;
                    if (s.geminiStatus === 'Unavailable') {
                        geminiStatusEl.className = "text-red-500 font-semibold leading-none mt-1";
                        if (geminiTitleEl) geminiTitleEl.innerText = "🔴 Gemini";
                        if (geminiReasonEl && s.geminiReason) {
                            geminiReasonEl.innerText = 'Reason: ' + s.geminiReason;
                            geminiReasonEl.title = s.geminiReason;
                            geminiReasonEl.classList.remove('hidden');
                        }
                        if (s.geminiDisabledAt) {
                            const disabledEl = document.getElementById('gemini-disabled');
                            disabledEl.querySelector('span').innerText = new Date(s.geminiDisabledAt).toLocaleTimeString([], {hour: '2-digit', minute:'2-digit'});
                            disabledEl.classList.remove('hidden');
                        }
                    } else {
                        geminiStatusEl.className = "text-gray-800 font-semibold leading-none mt-1";
                        if (geminiTitleEl) geminiTitleEl.innerText = "🟢 Gemini";
                        if (geminiReasonEl) geminiReasonEl.classList.add('hidden');
                        document.getElementById('gemini-disabled').classList.add('hidden');
                    }
                }

                const groqStatusEl = document.getElementById('groq-status');
                const groqTitleEl = document.getElementById('groq-title');
                const groqReasonEl = document.getElementById('groq-reason');

                if (groqStatusEl && s.groqStatus) {
                    groqStatusEl.innerText = s.groqStatus;
                    document.getElementById('groq-reqs').innerText = s.groqRequests || 0;
                    document.getElementById('groq-success').innerText = s.groqSuccess || 0;
                    document.getElementById('groq-failed').innerText = s.groqFailed || 0;
                    document.getElementById('groq-fallbacks').innerText = s.groqFallbacks || 0;
                    if (s.groqStatus === 'Unavailable') {
                        groqStatusEl.className = "text-red-500 font-semibold leading-none mt-1";
                        if (groqTitleEl) groqTitleEl.innerText = "🔴 Groq";
                        if (groqReasonEl && s.groqReason) {
                            groqReasonEl.innerText = 'Reason: ' + s.groqReason;
                            groqReasonEl.title = s.groqReason;
                            groqReasonEl.classList.remove('hidden');
                        }
                        if (s.groqDisabledAt) {
                            const disabledEl = document.getElementById('groq-disabled');
                            disabledEl.querySelector('span').innerText = new Date(s.groqDisabledAt).toLocaleTimeString([], {hour: '2-digit', minute:'2-digit'});
                            disabledEl.classList.remove('hidden');
                        }
                    } else {
                        groqStatusEl.className = "text-gray-800 font-semibold leading-none mt-1";
                        if (groqTitleEl) groqTitleEl.innerText = "🟠 Groq";
                        if (groqReasonEl) groqReasonEl.classList.add('hidden');
                        document.getElementById('groq-disabled').classList.add('hidden');
                    }
                }
                
                const zaiStatusEl = document.getElementById('zai-status');
                const zaiTitleEl = document.getElementById('zai-title');
                const zaiReasonEl = document.getElementById('zai-reason');

                if (zaiStatusEl && s.zaiStatus) {
                    zaiStatusEl.innerText = s.zaiStatus;
                    document.getElementById('zai-reqs').innerText = s.zaiRequests || 0;
                    document.getElementById('zai-success').innerText = s.zaiSuccess || 0;
                    document.getElementById('zai-failed').innerText = s.zaiFailed || 0;
                    document.getElementById('zai-fallbacks').innerText = s.zaiFallbacks || 0;
                    if (s.zaiStatus === 'Unavailable') {
                        zaiStatusEl.className = "text-red-500 font-semibold leading-none mt-1";
                        if (zaiTitleEl) zaiTitleEl.innerText = "🔴 Z.ai";
                        if (zaiReasonEl && s.zaiReason) {
                            zaiReasonEl.innerText = 'Reason: ' + s.zaiReason;
                            zaiReasonEl.title = s.zaiReason;
                            zaiReasonEl.classList.remove('hidden');
                        }
                        if (s.zaiDisabledAt) {
                            const disabledEl = document.getElementById('zai-disabled');
                            disabledEl.querySelector('span').innerText = new Date(s.zaiDisabledAt).toLocaleTimeString([], {hour: '2-digit', minute:'2-digit'});
                            disabledEl.classList.remove('hidden');
                        }
                    } else {
                        zaiStatusEl.className = "text-gray-800 font-semibold leading-none mt-1";
                        if (zaiTitleEl) zaiTitleEl.innerText = "🔵 Z.ai";
                        if (zaiReasonEl) zaiReasonEl.classList.add('hidden');
                        document.getElementById('zai-disabled').classList.add('hidden');
                    }
                }
                
                const localReqsEl = document.getElementById('local-reqs');
                if (localReqsEl) localReqsEl.innerText = s.localRequests || 0;
                const localSuccessEl = document.getElementById('local-success');
                if (localSuccessEl) localSuccessEl.innerText = s.localSuccess || 0;
                const localFailedEl = document.getElementById('local-failed');
                if (localFailedEl) localFailedEl.innerText = s.localFailed || 0;
                
                let dotColor = 'bg-gray-400';
                let pingColor = 'bg-gray-400';
                
                if (s.status === 'Running') {
                    dotColor = 'bg-primary';
                    pingColor = 'bg-primary';
                    
                    let extraInfo = '';
                    if (s.currentCompany || s.currentStage) {
                        extraInfo = `
                            <div class="mt-3 text-xs border-t border-gray-100 pt-2 space-y-1">
                                <div class="flex justify-between">
                                    <span class="text-gray-500">Stage:</span>
                                    <span class="font-medium text-gray-800">${s.currentStage || '-'}</span>
                                </div>
                                <div class="flex justify-between">
                                    <span class="text-gray-500">Target:</span>
                                    <span class="font-medium text-primary truncate max-w-[120px] text-right" title="${s.currentCompany || '-'}">${s.currentCompany || '-'}</span>
                                </div>
                                <div class="flex justify-between">
                                    <span class="text-gray-500">Progress:</span>
                                    <span class="font-medium text-gray-800">${s.progress || '-'}</span>
                                </div>
                                <div class="flex justify-between">
                                    <span class="text-gray-500">ETA:</span>
                                    <span class="font-medium text-gray-800">${s.estimatedRemainingTime ? Math.round(s.estimatedRemainingTime/1000) + 's' : '-'}</span>
                                </div>
                                <div class="flex justify-between">
                                    <span class="text-gray-500">AI Engine:</span>
                                    <span class="font-medium text-gray-800">${s.currentAiProvider || '-'}</span>
                                </div>
                            </div>
                        `;
                    }
                    
                    widget.innerHTML = `
                        <div class="flex items-start gap-3 w-full min-w-[240px]">
                            <div class="relative flex h-3 w-3 mt-1 shrink-0">
                                <span class="animate-ping absolute inline-flex h-full w-full rounded-full ${pingColor} opacity-75"></span>
                                <span class="relative inline-flex rounded-full h-3 w-3 ${dotColor}"></span>
                            </div>
                            <div class="text-sm w-full">
                                <p class="text-gray-800 font-medium leading-none">Pipeline: ${s.status}</p>
                                <p class="text-gray-500 text-xs mt-1 leading-none" title="${s.message}">${s.message.length > 30 ? s.message.substring(0,30) + '...' : s.message}</p>
                                ${extraInfo}
                            </div>
                        </div>
                    `;
                } else {
                    if (s.status === 'Completed' || s.status === 'Idle') {
                        dotColor = 'bg-green-500';
                    } else if (s.status === 'Completed with Warnings') {
                        dotColor = 'bg-yellow-500';
                    } else if (s.status === 'Failed') {
                        dotColor = 'bg-red-500';
                    }
                    widget.innerHTML = `
                        <div class="relative flex h-3 w-3">
                            <span class="relative inline-flex rounded-full h-3 w-3 ${dotColor}"></span>
                        </div>
                        <div class="text-sm">
                            <p class="text-gray-800 font-medium leading-none">Pipeline: ${s.status}</p>
                            <p class="text-gray-500 text-xs mt-1 leading-none" title="${s.message}">${s.message.length > 30 ? s.message.substring(0,30) + '...' : s.message}</p>
                        </div>
                    `;
                }
            }
        } catch (e) {}
    }

    async function clearRawJobs() {
        if(!confirm("Are you sure you want to delete all raw job data?")) return;
        try {
            const res = await fetch("/api/jobs/raw", { method: "DELETE" });
            const data = await res.json();
            if(data.success) alert(data.message);
        } catch(e) {
            alert("Error clearing raw jobs");
        }
    }

    document.addEventListener("DOMContentLoaded", () => {
        loadDashboard();
        fetchLogs();
        fetchPipelineStatus();
        
        // Poll pipeline status and logs every 5 seconds
        setInterval(() => {
            fetchPipelineStatus();
            fetchLogs();
        }, 5000);
    });
</script>

