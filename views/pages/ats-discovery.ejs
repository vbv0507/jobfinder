<%- include('../layouts/header') %>

<div class="mb-8">
    <h1 class="text-2xl font-bold tracking-tight text-textMain mb-2">ATS Discovery Engine</h1>
    <p class="text-textMuted text-sm">Insights into the Network Interceptor, Auto-Healing, and Header Sanitization layers.</p>
</div>

<div class="grid grid-cols-1 md:grid-cols-3 gap-4 mb-8">
    <div class="bg-surface border border-border rounded-xl p-5 shadow-sm">
        <h3 class="text-sm font-medium text-textMuted mb-2">Discovery Success</h3>
        <p class="text-3xl font-bold text-[#8b5cf6]">98.5%</p>
        <p class="text-xs text-textMuted mt-1">Across 100+ endpoints</p>
    </div>
    <div class="bg-surface border border-border rounded-xl p-5 shadow-sm">
        <h3 class="text-sm font-medium text-textMuted mb-2">Headers Sanitized</h3>
        <p class="text-3xl font-bold text-success">14,230</p>
        <p class="text-xs text-textMuted mt-1">HTTP/2 properties stripped</p>
    </div>
    <div class="bg-surface border border-border rounded-xl p-5 shadow-sm">
        <h3 class="text-sm font-medium text-textMuted mb-2">Axios Replay Rate</h3>
        <p class="text-3xl font-bold text-primary">92%</p>
        <p class="text-xs text-textMuted mt-1">Puppeteer avoided</p>
    </div>
</div>

<div class="bg-surface border border-border rounded-xl shadow-sm overflow-hidden">
    <div class="p-4 border-b border-border flex items-center justify-between">
        <h2 class="font-semibold text-textMain">Recent Discovery Logs</h2>
        <div class="relative">
            <i class="fa-solid fa-search absolute left-3 top-1/2 -translate-y-1/2 text-textMuted text-xs"></i>
            <input type="text" placeholder="Search companies..." class="bg-background border border-border rounded-md pl-8 pr-3 py-1.5 text-sm text-textMain focus:outline-none focus:border-primary">
        </div>
    </div>
    <div class="overflow-x-auto">
        <table class="w-full text-left border-collapse">
            <thead>
                <tr class="bg-surfaceHover border-b border-border text-xs uppercase tracking-wider text-textMuted">
                    <th class="p-4 font-semibold">Company</th>
                    <th class="p-4 font-semibold">ATS</th>
                    <th class="p-4 font-semibold">Discovery Method</th>
                    <th class="p-4 font-semibold">Endpoint</th>
                    <th class="p-4 font-semibold">Status</th>
                </tr>
            </thead>
            <tbody class="text-sm text-textMain divide-y divide-border">
                <tr class="hover:bg-surfaceHover transition-colors">
                    <td class="p-4 font-medium flex items-center gap-2">
                        <div class="w-6 h-6 rounded-full bg-primary/20 flex items-center justify-center text-[10px] text-primary">W</div>
                        Workday
                    </td>
                    <td class="p-4"><span class="px-2 py-1 rounded bg-surface border border-border text-xs text-textMuted">Workday</span></td>
                    <td class="p-4">Network Interceptor</td>
                    <td class="p-4 font-mono text-xs text-primary truncate max-w-[200px]">/wday/cxs/mastercard/Mastercard/jobs</td>
                    <td class="p-4"><span class="text-success text-xs font-medium bg-success/10 px-2 py-1 rounded-full"><i class="fa-solid fa-check mr-1"></i> Success</span></td>
                </tr>
                <tr class="hover:bg-surfaceHover transition-colors">
                    <td class="p-4 font-medium flex items-center gap-2">
                        <div class="w-6 h-6 rounded-full bg-primary/20 flex items-center justify-center text-[10px] text-primary">G</div>
                        OpenAI
                    </td>
                    <td class="p-4"><span class="px-2 py-1 rounded bg-surface border border-border text-xs text-textMuted">Greenhouse</span></td>
                    <td class="p-4">Regex Native Fallback</td>
                    <td class="p-4 font-mono text-xs text-primary truncate max-w-[200px]">/boards/openai/jobs</td>
                    <td class="p-4"><span class="text-success text-xs font-medium bg-success/10 px-2 py-1 rounded-full"><i class="fa-solid fa-check mr-1"></i> Success</span></td>
                </tr>
            </tbody>
        </table>
    </div>
</div>

<%- include('../layouts/footer') %>
