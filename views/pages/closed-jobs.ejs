<%- include('../layouts/header') %>

<div class="mb-8 flex flex-col md:flex-row md:items-center justify-between gap-4">
    <div>
        <div class="flex items-center gap-2 mb-1">
            <span class="px-2.5 py-0.5 rounded-full text-xs font-semibold bg-error/10 text-error border border-error/20 flex items-center gap-1.5">
                <span class="w-1.5 h-1.5 rounded-full bg-error animate-pulse"></span>
                Archived Postings
            </span>
            <span class="text-xs text-textMuted font-mono">(<%= jobs.length %> roles)</span>
        </div>
        <h1 class="text-2xl font-bold tracking-tight text-textMain mb-1"><%= title %></h1>
        <p class="text-textMuted text-sm">Review historical AI-matched opportunities with complete lifecycle timestamps (Posted, Scraped & Expired dates).</p>
    </div>
    
    <div class="relative min-w-[300px]">
        <i class="fa-solid fa-search absolute left-3 top-1/2 -translate-y-1/2 text-textMuted text-xs"></i>
        <input type="text" id="searchInput" onkeyup="filterJobs()" placeholder="Search expired roles or companies..." class="w-full bg-background border border-border rounded-md pl-8 pr-3 py-2 text-sm text-textMain focus:outline-none focus:border-primary transition-colors">
    </div>
</div>

<div class="bg-surface border border-border rounded-xl shadow-sm overflow-hidden min-h-[400px]">
    <% if (jobs.length === 0) { %>
        <div class="p-16 text-center text-textMuted flex flex-col items-center justify-center h-full">
            <div class="w-16 h-16 rounded-full bg-surfaceHover flex items-center justify-center mb-4 border border-border">
                <i class="fa-regular fa-clock text-2xl text-textMuted"></i>
            </div>
            <p class="text-lg font-medium text-textMain mb-1">No Expired Jobs Found</p>
            <p class="text-sm">All currently matched opportunities are active and open for applications.</p>
        </div>
    <% } else { %>
        <div class="overflow-x-auto w-full">
            <table class="min-w-full text-left border-collapse">
                <thead class="bg-surfaceHover border-b border-border hidden md:table-header-group sticky top-0 z-10">
                    <tr>
                        <th class="px-6 py-4 text-xs font-semibold text-textMuted uppercase tracking-wider">Role & Company</th>
                        <th class="px-6 py-4 text-xs font-semibold text-textMuted uppercase tracking-wider">AI Score</th>
                        <th class="px-6 py-4 text-xs font-semibold text-textMuted uppercase tracking-wider">Lifecycle Timestamps</th>
                        <th class="px-6 py-4 text-xs font-semibold text-textMuted uppercase tracking-wider">Location</th>
                        <th class="px-6 py-4 text-xs font-semibold text-textMuted uppercase tracking-wider text-right">Actions</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-border text-sm" id="jobsTableBody">
                    <% jobs.forEach(function(job) { %>
                        <%
                            const postedDateStr = job.postedAt ? new Date(job.postedAt).toLocaleDateString("en-US", { month: "short", day: "numeric", year: "numeric" }) : "N/A";
                            const scrapedDateStr = (job.rawJob?.scrapedAt || job.scrapedAt || job.createdAt) ? new Date(job.rawJob?.scrapedAt || job.scrapedAt || job.createdAt).toLocaleDateString("en-US", { month: "short", day: "numeric", year: "numeric", hour: "2-digit", minute: "2-digit" }) : "N/A";
                            const closedDateStr = (job.closedAt || job.updatedAt) ? new Date(job.closedAt || job.updatedAt).toLocaleDateString("en-US", { month: "short", day: "numeric", year: "numeric" }) : "N/A";
                        %>
                        <tr class="hover:bg-surfaceHover transition-colors job-row flex flex-col md:table-row border-b md:border-b-0 border-border p-4 md:p-0">
                            <!-- Role & Company -->
                            <td class="md:px-6 md:py-4 flex items-center justify-between md:table-cell mb-3 md:mb-0">
                                <div class="flex items-center gap-3">
                                    <div class="w-10 h-10 rounded-md bg-background border border-border flex items-center justify-center overflow-hidden shrink-0">
                                        <img src="<%= getCompanyLogo(job.company && job.company.name ? job.company.name : 'Unknown') %>" class="w-6 h-6 object-contain" alt="Logo" loading="lazy">
                                    </div>
                                    <div>
                                        <div class="font-semibold text-textMain job-title flex items-center gap-2">
                                            <%= job.role %>
                                            <span class="px-2 py-0.5 rounded text-[10px] font-bold bg-error/10 text-error border border-error/20 uppercase">
                                                Expired
                                            </span>
                                        </div>
                                        <div class="text-xs text-textMuted job-company mt-0.5"><%= (job.company && job.company.name) ? job.company.name : 'Unknown' %></div>
                                    </div>
                                </div>
                            </td>

                            <!-- AI Score -->
                            <td class="md:px-6 md:py-4 flex items-center justify-between md:table-cell mb-2 md:mb-0">
                                <span class="md:hidden text-xs font-medium text-textMuted uppercase">AI Score</span>
                                <div class="flex items-center gap-2">
                                    <% 
                                        let scoreColor = "text-success bg-success/10 border-success/20";
                                        if (job.score < 70) scoreColor = "text-warning bg-warning/10 border-warning/20";
                                        if (job.score < 40) scoreColor = "text-error bg-error/10 border-error/20";
                                    %>
                                    <span class="px-2.5 py-0.5 inline-flex text-xs font-bold rounded-full border <%= scoreColor %>">
                                        <%= job.score %>/100
                                    </span>
                                    
                                    <% 
                                        let aiColor = "text-success bg-success/10";
                                        let aiName = job.provider ? (job.provider.charAt(0).toUpperCase() + job.provider.slice(1)) : (job.evaluatedBy || 'Gemini');
                                        if (job.provider === 'groq' || job.evaluatedBy === 'Groq') aiColor = "text-warning bg-warning/10";
                                        if (job.provider === 'local' || job.provider === 'unknown' || job.evaluatedBy === 'Local') aiColor = "text-textMuted bg-surfaceHover";
                                    %>
                                    <span class="px-2 py-0.5 inline-flex text-[10px] font-semibold rounded-full <%= aiColor %>">
                                        <%= aiName %>
                                    </span>
                                </div>
                            </td>

                            <!-- Lifecycle Timestamps -->
                            <td class="md:px-6 md:py-4 flex flex-col justify-center md:table-cell mb-3 md:mb-0">
                                <div class="space-y-1 text-xs">
                                    <div class="flex items-center gap-2 text-textMuted">
                                        <span class="w-20 font-medium text-[11px] text-textMuted uppercase">📅 Posted:</span>
                                        <span class="font-mono text-textMain"><%= postedDateStr %></span>
                                    </div>
                                    <div class="flex items-center gap-2 text-textMuted">
                                        <span class="w-20 font-medium text-[11px] text-primary uppercase">🚀 Scraped:</span>
                                        <span class="font-mono text-textMain"><%= scrapedDateStr %></span>
                                    </div>
                                    <div class="flex items-center gap-2 text-textMuted">
                                        <span class="w-20 font-medium text-[11px] text-error uppercase">🛑 Expired:</span>
                                        <span class="font-mono text-error font-medium"><%= closedDateStr %></span>
                                    </div>
                                </div>
                            </td>

                            <!-- Location -->
                            <td class="md:px-6 md:py-4 text-textMuted flex items-center justify-between md:table-cell mb-4 md:mb-0">
                                <span class="md:hidden text-xs font-medium uppercase">Location</span>
                                <span><%= job.location || 'Remote' %></span>
                            </td>

                            <!-- Actions -->
                            <td class="md:px-6 md:py-4 text-right flex justify-end gap-2 md:table-cell">
                                <div class="flex justify-end gap-2">
                                    <button onclick="toggleRow('row-<%= job._id %>')" class="bg-surface hover:bg-surfaceHover text-textMuted border border-border px-3 py-1.5 rounded-md transition-colors" title="Quick View">
                                        <i class="fa-solid fa-chevron-down text-xs"></i>
                                    </button>
                                    <a href="/job/<%= job._id %>" class="bg-primary/10 text-primary hover:bg-primary hover:text-white px-3 py-1.5 rounded-md text-sm font-medium transition-colors">Details</a>
                                    <% if (job.applyLink) { %>
                                        <a href="<%= job.applyLink %>" target="_blank" rel="noopener noreferrer" class="bg-surface hover:bg-surfaceHover text-textMuted border border-border px-3 py-1.5 rounded-md text-sm transition-colors" title="Original Posting Link">
                                            <i class="fa-solid fa-arrow-up-right-from-square"></i>
                                        </a>
                                    <% } %>
                                </div>
                            </td>
                        </tr>

                        <!-- Expanded Row -->
                        <tr id="row-<%= job._id %>" class="hidden bg-surfaceHover border-b border-border text-sm">
                            <td colspan="5" class="p-4">
                                <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
                                    <div>
                                        <p class="text-xs font-semibold text-success uppercase mb-2"><i class="fa-solid fa-thumbs-up"></i> Strengths</p>
                                        <ul class="text-xs text-textMain space-y-1">
                                            <% if (job.strengths && job.strengths.length > 0) { %>
                                                <% job.strengths.slice(0, 3).forEach(s => { %>
                                                    <li>• <%= s %></li>
                                                <% }) %>
                                            <% } else { %>
                                                <li class="text-textMuted italic">None specified</li>
                                            <% } %>
                                        </ul>
                                    </div>
                                    <div>
                                        <p class="text-xs font-semibold text-warning uppercase mb-2"><i class="fa-solid fa-thumbs-down"></i> Missing Skills</p>
                                        <div class="flex flex-wrap gap-1 mb-2">
                                            <% if (job.missingSkills && job.missingSkills.length > 0) { %>
                                                <% job.missingSkills.slice(0, 4).forEach(skill => { %>
                                                    <span class="px-2 py-0.5 bg-warning/10 text-warning text-[10px] rounded border border-warning/20 whitespace-nowrap"><%= skill %></span>
                                                <% }) %>
                                            <% } else { %>
                                                <span class="text-xs italic text-textMuted">None specified</span>
                                            <% } %>
                                        </div>
                                    </div>
                                    <div>
                                        <p class="text-xs font-semibold text-textMuted uppercase mb-2"><i class="fa-solid fa-brain"></i> AI Evaluation Rationale</p>
                                        <p class="text-xs text-textMuted line-clamp-3"><%= job.reason || job.recommendation || 'No detailed reason provided.' %></p>
                                    </div>
                                </div>
                            </td>
                        </tr>
                    <% }); %>
                </tbody>
            </table>
        </div>
    <% } %>
</div>

<script>
function filterJobs() {
    let input = document.getElementById("searchInput").value.toLowerCase();
    let rows = document.querySelectorAll(".job-row");
    
    rows.forEach(row => {
        let title = row.querySelector(".job-title") ? row.querySelector(".job-title").innerText.toLowerCase() : "";
        let company = row.querySelector(".job-company") ? row.querySelector(".job-company").innerText.toLowerCase() : "";
        
        if (title.includes(input) || company.includes(input)) {
            row.style.display = "";
        } else {
            row.style.display = "none";
        }
    });
}

function toggleRow(rowId) {
    const row = document.getElementById(rowId);
    if (row) {
        row.classList.toggle("hidden");
    }
}
</script>

<%- include('../layouts/footer') %>
