<%- include('../layouts/header') %>

<div class="mb-8 flex flex-col md:flex-row md:items-center justify-between gap-4">
    <div>
        <h1 class="text-2xl font-bold tracking-tight text-textMain mb-2"><%= title %></h1>
        <p class="text-textMuted text-sm">Review AI-matched roles and their evaluation scores.</p>
    </div>
    
    <div class="relative min-w-[300px] flex items-center gap-3">
        <div class="relative w-full">
            <i class="fa-solid fa-search absolute left-3 top-1/2 -translate-y-1/2 text-textMuted text-xs"></i>
            <input type="text" id="searchInput" onkeyup="filterJobs()" placeholder="Search roles or companies..." class="w-full bg-background border border-border rounded-md pl-8 pr-3 py-2 text-sm text-textMain focus:outline-none focus:border-primary transition-colors">
        </div>
        <button id="btnVerifyLocal" onclick="triggerLocalVerification()" class="whitespace-nowrap bg-primary hover:bg-primaryHover text-white px-4 py-2 rounded-md text-sm font-medium transition-colors shadow-sm disabled:opacity-50 flex items-center gap-2">
            <i class="fa-solid fa-brain"></i> Verify All Local
        </button>
    </div>
</div>

<div class="bg-surface border border-border rounded-xl shadow-sm overflow-hidden min-h-[400px]">
    <% if (jobs.length === 0) { %>
        <div class="p-16 text-center text-textMuted flex flex-col items-center justify-center h-full">
            <div class="w-16 h-16 rounded-full bg-surfaceHover flex items-center justify-center mb-4 border border-border">
                <i class="fa-regular fa-folder-open text-2xl text-textMuted"></i>
            </div>
            <p class="text-lg font-medium text-textMain mb-1">No jobs found</p>
            <p class="text-sm">Try running the job search pipeline or checking back later.</p>
        </div>
    <% } else { %>
        <div class="overflow-x-auto w-full">
            <table class="min-w-full text-left border-collapse">
                <thead class="bg-surfaceHover border-b border-border hidden md:table-header-group sticky top-0 z-10">
                    <tr>
                        <th class="px-6 py-4 text-xs font-semibold text-textMuted uppercase tracking-wider">Role & Company</th>
                        <th class="px-6 py-4 text-xs font-semibold text-textMuted uppercase tracking-wider">Score</th>
                        <th class="px-6 py-4 text-xs font-semibold text-textMuted uppercase tracking-wider">Location</th>
                        <th class="px-6 py-4 text-xs font-semibold text-textMuted uppercase tracking-wider text-right">Actions</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-border text-sm" id="jobsTableBody">
                    <% jobs.forEach(function(job) { %>
                        <tr class="hover:bg-surfaceHover transition-colors job-row flex flex-col md:table-row border-b md:border-b-0 border-border p-4 md:p-0">
                            <td class="md:px-6 md:py-4 flex items-center justify-between md:table-cell mb-3 md:mb-0">
                                <div class="flex items-center gap-3">
                                    <div class="w-10 h-10 rounded-md bg-background border border-border flex items-center justify-center overflow-hidden shrink-0">
                                        <img src="<%= getCompanyLogo(job.company && job.company.name ? job.company.name : 'Unknown') %>" class="w-6 h-6 object-contain" alt="Logo" loading="lazy">
                                    </div>
                                    <div>
                                        <div class="font-semibold text-textMain job-title"><%= job.role %></div>
                                        <div class="text-xs text-textMuted job-company mt-0.5"><%= (job.company && job.company.name) ? job.company.name : 'Unknown' %></div>
                                    </div>
                                </div>
                            </td>
                            <td class="md:px-6 md:py-4 flex items-center justify-between md:table-cell mb-2 md:mb-0">
                                <span class="md:hidden text-xs font-medium text-textMuted uppercase">Score</span>
                                <div class="flex items-center gap-2">
                                    <% 
                                        let scoreColor = "text-success bg-success/10 border-success/20";
                                        if (job.score < 70) scoreColor = "text-warning bg-warning/10 border-warning/20";
                                        if (job.score < 40) scoreColor = "text-error bg-error/10 border-error/20";
                                    %>
                                    <span class="px-2.5 py-0.5 inline-flex text-xs font-bold rounded-full border <%= scoreColor %>">
                                        <%= job.score %>/100
                                    </span>
                                    
                                    <% 
                                        let aiColor = "text-success bg-success/10";
                                        let aiName = job.provider ? (job.provider.charAt(0).toUpperCase() + job.provider.slice(1)) : (job.evaluatedBy || 'Gemini');
                                        if (job.provider === 'groq' || job.evaluatedBy === 'Groq') aiColor = "text-warning bg-warning/10";
                                        if (job.provider === 'local' || job.provider === 'unknown' || job.evaluatedBy === 'Local') aiColor = "text-textMuted bg-surfaceHover";
                                    %>
                                    <span class="px-2 py-0.5 inline-flex text-[10px] font-semibold rounded-full <%= aiColor %>">
                                        <%= aiName %>
                                    </span>
                                </div>
                            </td>
                            <td class="md:px-6 md:py-4 text-textMuted flex items-center justify-between md:table-cell mb-4 md:mb-0">
                                <span class="md:hidden text-xs font-medium uppercase">Location</span>
                                <span><%= job.location || 'Remote' %></span>
                            </td>
                            <td class="md:px-6 md:py-4 text-right flex justify-end gap-2 md:table-cell">
                                <div class="flex justify-end gap-2">
                                    <button onclick="toggleRow('row-<%= job._id %>')" class="bg-surface hover:bg-surfaceHover text-textMuted border border-border px-3 py-1.5 rounded-md transition-colors" title="Quick View">
                                        <i class="fa-solid fa-chevron-down text-xs"></i>
                                    </button>
                                    <a href="/job/<%= job._id %>" class="bg-primary/10 text-primary hover:bg-primary hover:text-white px-3 py-1.5 rounded-md text-sm font-medium transition-colors">Details</a>
                                    
                                    <% if(job.status !== 'saved') { %>
                                        <button onclick="updateStatus('<%= job._id %>', 'saved')" class="bg-surface hover:bg-primary/20 hover:text-primary text-textMuted border border-border px-3 py-1.5 rounded-md transition-colors" title="Save for later">
                                            <i class="fa-regular fa-bookmark"></i>
                                        </button>
                                    <% } %>
                                    
                                    <% if(job.status !== 'applied') { %>
                                        <button onclick="updateStatus('<%= job._id %>', 'applied')" class="bg-surface hover:bg-success/20 hover:text-success text-textMuted border border-border px-3 py-1.5 rounded-md transition-colors" title="Mark as applied">
                                            <i class="fa-solid fa-check"></i>
                                        </button>
                                    <% } %>
                                    
                                    <% if(job.status !== 'rejected') { %>
                                        <button onclick="updateStatus('<%= job._id %>', 'rejected')" class="bg-surface hover:bg-error/20 hover:text-error text-textMuted border border-border px-3 py-1.5 rounded-md transition-colors" title="Reject">
                                            <i class="fa-solid fa-times"></i>
                                        </button>
                                    <% } %>
                                </div>
                            </td>
                        </tr>
                        <!-- Expanded AI Reasoning Row -->
                        <tr id="row-<%= job._id %>" class="hidden bg-surfaceHover border-b border-border text-sm">
                            <td colspan="4" class="p-4">
                                <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                                    <div>
                                        <p class="text-xs font-semibold text-success uppercase mb-2"><i class="fa-solid fa-thumbs-up"></i> Strengths</p>
                                        <ul class="text-xs text-textMain space-y-1">
                                            <% if (job.strengths && job.strengths.length > 0) { %>
                                                <% job.strengths.slice(0, 3).forEach(s => { %>
                                                    <li>• <%= s %></li>
                                                <% }) %>
                                                <% if (job.strengths.length > 3) { %>
                                                    <li class="text-textMuted italic">...and <%= job.strengths.length - 3 %> more</li>
                                                <% } %>
                                            <% } else { %>
                                                <li class="text-textMuted italic">None specified</li>
                                            <% } %>
                                        </ul>
                                    </div>
                                    <div>
                                        <p class="text-xs font-semibold text-warning uppercase mb-2"><i class="fa-solid fa-thumbs-down"></i> Weaknesses / Missing</p>
                                        <div class="flex flex-wrap gap-1 mb-2">
                                            <% if (job.missingSkills && job.missingSkills.length > 0) { %>
                                                <% job.missingSkills.slice(0, 4).forEach(skill => { %>
                                                    <span class="px-2 py-0.5 bg-warning/10 text-warning text-[10px] rounded border border-warning/20 whitespace-nowrap"><%= skill %></span>
                                                <% }) %>
                                            <% } else { %>
                                                <span class="text-xs italic text-textMuted">None specified</span>
                                            <% } %>
                                        </div>
                                        <p class="text-xs text-textMuted line-clamp-2"><%= job.reason || job.recommendation || 'No detailed reason provided.' %></p>
                                    </div>
                                </div>
                            </td>
                        </tr>
                    <% }); %>
                </tbody>
            </table>
        </div>
    <% } %>
</div>

<script>
function filterJobs() {
    let input = document.getElementById("searchInput").value.toLowerCase();
    let rows = document.querySelectorAll(".job-row");
    
    rows.forEach(row => {
        let title = row.querySelector(".job-title").innerText.toLowerCase();
        let company = row.querySelector(".job-company").innerText.toLowerCase();
        
        if (title.includes(input) || company.includes(input)) {
            row.style.display = "";
        } else {
            row.style.display = "none";
        }
    });
}
async function updateStatus(id, status) {
    try {
        const res = await fetch(`/api/jobs/${id}/status`, {
            method: 'PATCH',
            headers: {'Content-Type': 'application/json'},
            body: JSON.stringify({ status })
        });
        if(res.ok) window.location.reload();
    } catch (e) {
        console.error(e);
    }
}
function toggleRow(rowId) {
    let row = document.getElementById(rowId);
    if (row.classList.contains("hidden")) {
        row.classList.remove("hidden");
        row.classList.add("table-row"); // or 'block' for flex cards
    } else {
        row.classList.add("hidden");
        row.classList.remove("table-row");
    }
}

async function triggerLocalVerification() {
    const btn = document.getElementById('btnVerifyLocal');
    const originalText = btn.innerHTML;
    try {
        btn.disabled = true;
        btn.innerHTML = '<i class="fa-solid fa-spinner fa-spin"></i> Starting...';
        
        const res = await fetch('/api/system/verify-local', { method: 'POST' });
        const data = await res.json();
        
        if (data.success) {
            btn.innerHTML = '<i class="fa-solid fa-check"></i> Started';
            btn.classList.replace('bg-primary', 'bg-success');
            btn.classList.replace('hover:bg-primaryHover', 'hover:bg-success/80');
            setTimeout(() => {
                btn.innerHTML = originalText;
                btn.disabled = false;
                btn.classList.replace('bg-success', 'bg-primary');
                btn.classList.replace('hover:bg-success/80', 'hover:bg-primaryHover');
            }, 3000);
        } else {
            alert('Failed to start verification: ' + data.error);
            btn.innerHTML = originalText;
            btn.disabled = false;
        }
    } catch (e) {
        console.error(e);
        alert('Error starting verification');
        btn.innerHTML = originalText;
        btn.disabled = false;
    }
}
</script>

<%- include('../layouts/footer') %>
