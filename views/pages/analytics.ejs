<%- include('../layouts/header') %>

<div class="mb-8">
    <h1 class="text-2xl font-bold tracking-tight text-textMain mb-2">Platform Analytics</h1>
    <p class="text-textMuted text-sm">Visualize job matching metrics and pipeline performance over time.</p>
</div>

<div class="grid grid-cols-1 lg:grid-cols-2 gap-6 mb-8">
    <div class="bg-surface border border-border rounded-xl shadow-sm p-6 lg:col-span-2">
        <h3 class="text-lg font-semibold text-textMain mb-4">Daily Pipeline Activity (Last 7 Days)</h3>
        <div class="relative w-full h-72">
            <canvas id="trendChart"></canvas>
        </div>
    </div>

    <div class="bg-surface border border-border rounded-xl shadow-sm p-6">
        <h3 class="text-lg font-semibold text-textMain mb-4">Jobs by Company</h3>
        <div class="relative w-full h-64">
            <canvas id="companyChart"></canvas>
        </div>
    </div>
    
    <div class="bg-surface border border-border rounded-xl shadow-sm p-6 lg:col-span-2">
        <h3 class="text-lg font-semibold text-textMain mb-4 flex items-center gap-2"><i class="fa-solid fa-microchip text-primary"></i> AI Provider Statistics</h3>
        <div class="grid grid-cols-2 md:grid-cols-5 gap-4" id="aiStatsContainer">
            <div class="animate-pulse h-16 bg-background rounded"></div>
        </div>
    </div>
    
    <div class="bg-surface border border-border rounded-xl shadow-sm p-6">
        <h3 class="text-lg font-semibold text-textMain mb-4">Match Score Distribution</h3>
        <div class="relative w-full flex justify-center h-64">
            <canvas id="scoreChart"></canvas>
        </div>
    </div>
    
    <div class="bg-surface border border-border rounded-xl shadow-sm p-6">
        <h3 class="text-lg font-semibold text-textMain mb-4">Jobs by Domain</h3>
        <div class="relative w-full h-64">
            <canvas id="domainChart"></canvas>
        </div>
    </div>
</div>

<script type="module">
    import { createSocket } from '/js/modules/socketClient.js';

    const charts = {};

    function renderProviderStats(aiMetrics = {}) {
        const container = document.getElementById('aiStatsContainer');
        if (!container) return;
        const providers = aiMetrics.providerStats || [];
        container.innerHTML = providers.length
            ? providers.map(provider => `
                <div class="bg-background border border-border rounded-lg p-4">
                    <p class="text-xs text-textMuted uppercase">${provider._id || 'unknown'}</p>
                    <p class="text-2xl font-bold text-textMain">${provider.count || 0}</p>
                    <p class="text-xs text-textMuted">${Math.round(provider.avgTime || 0)}ms avg</p>
                </div>
            `).join('')
            : '<p class="text-textMuted text-sm">No AI provider data yet.</p>';
    }

    function ensureCharts() {
        if (!window.Chart) return;
        const trend = document.getElementById('trendChart');
        const company = document.getElementById('companyChart');
        const score = document.getElementById('scoreChart');
        const domain = document.getElementById('domainChart');

        if (trend && !charts.trend) {
            charts.trend = new Chart(trend, { type: 'line', data: { labels: [], datasets: [{ label: 'Jobs Found', data: [], borderColor: '#3b82f6', tension: 0.35 }] }, options: { responsive: true, maintainAspectRatio: false } });
        }
        if (company && !charts.company) {
            charts.company = new Chart(company, { type: 'bar', data: { labels: [], datasets: [{ label: 'Matched Jobs', data: [], backgroundColor: '#22c55e' }] }, options: { responsive: true, maintainAspectRatio: false } });
        }
        if (score && !charts.score) {
            charts.score = new Chart(score, { type: 'doughnut', data: { labels: [], datasets: [{ data: [], backgroundColor: ['#ef4444', '#f59e0b', '#3b82f6', '#22c55e', '#a1a1aa'] }] }, options: { responsive: true, maintainAspectRatio: false } });
        }
        if (domain && !charts.domain) {
            charts.domain = new Chart(domain, { type: 'bar', data: { labels: [], datasets: [{ label: 'Jobs', data: [], backgroundColor: '#3b82f6' }] }, options: { responsive: true, maintainAspectRatio: false } });
        }
    }

    function updateChart(chart, labels, values) {
        if (!chart) return;
        chart.data.labels = labels;
        chart.data.datasets[0].data = values;
        chart.update();
    }

    function renderAnalytics(data) {
        ensureCharts();
        const chartsData = data.charts || {};
        updateChart(charts.trend, (chartsData.dailyTrend || []).map(item => item._id), (chartsData.dailyTrend || []).map(item => item.jobsFound || 0));
        updateChart(charts.company, (chartsData.companyDistribution || []).map(item => item._id), (chartsData.companyDistribution || []).map(item => item.count || 0));
        updateChart(charts.score, (chartsData.scoreDistribution || []).map(item => String(item._id)), (chartsData.scoreDistribution || []).map(item => item.count || 0));
        updateChart(charts.domain, (chartsData.domainDistribution || []).map(item => item._id), (chartsData.domainDistribution || []).map(item => item.count || 0));
        renderProviderStats(data.aiMetrics);
    }

    document.addEventListener("DOMContentLoaded", async () => {
        const socket = await createSocket();
        socket.on('dashboard:init', (payload) => renderAnalytics(payload.analytics || payload));
        socket.on('analytics:init', renderAnalytics);
        socket.on('analytics:update', renderAnalytics);
    });
</script>

<%- include('../layouts/footer') %>
