<%- include('../layouts/header') %>

<div class="mb-8">
    <h1 class="text-2xl font-bold tracking-tight text-textMain mb-2">Telegram Integration</h1>
    <p class="text-textMuted text-sm">Configure channels where RoleNova broadcasts matched job listings.</p>
</div>

<div class="bg-surface border border-border rounded-xl shadow-sm p-6 mb-8 max-w-4xl">
    <h2 class="text-lg font-semibold text-textMain mb-4">Linked Channels</h2>
    <div id="channelsList" class="space-y-4">
        <div class="animate-pulse h-12 bg-background rounded"></div>
    </div>
</div>

<script type="module">
    import { createSocket } from '/js/modules/socketClient.js';

    function renderChannels(data) {
        const list = document.getElementById('channelsList');
        const channels = data.channels || [];
        if (channels.length > 0) {
            list.innerHTML = channels.map(c => `
                <div class="flex items-center justify-between p-4 bg-background border border-border rounded-lg">
                    <div class="flex items-center gap-3">
                        <i class="fa-brands fa-telegram text-primary text-xl"></i>
                        <div>
                            <p class="font-medium text-textMain">${c.name || c.channelName || c.username}</p>
                            <p class="text-xs text-textMuted">Channel: ${c.username || c.chatId}</p>
                        </div>
                    </div>
                    <span class="bg-success/10 text-success text-xs font-bold px-2 py-1 rounded-full uppercase">${c.status || 'Active'}</span>
                </div>
            `).join('');
        } else {
            list.innerHTML = `<p class="text-textMuted text-sm">No channels connected.</p>`;
        }
    }

    document.addEventListener("DOMContentLoaded", async () => {
        const socket = await createSocket();
        socket.on('dashboard:init', (payload) => renderChannels(payload.telegram || {}));
        socket.on('telegram:init', renderChannels);
        socket.on('telegram:update', renderChannels);
    });
</script>

<%- include('../layouts/footer') %>
