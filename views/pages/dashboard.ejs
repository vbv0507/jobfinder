                    <span class="inline-flex items-center gap-1.5 px-2 py-1 rounded-md bg-success/10 text-success text-xs font-medium border border-success/20">
                        <i class="fa-solid fa-check"></i> Access Active
                    </span>
                </div>
            <% }) %>
        </div>
    </div>
    <% } %>
</div>
<% } %>
