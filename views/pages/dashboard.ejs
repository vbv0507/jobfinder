<%- include('../layouts/header') %>
<%
    const isSuperAdmin = locals.user && locals.user.email && (locals.user.email.toLowerCase().includes('vbvrai1407') || locals.user.email.toLowerCase() === 'vbvrai1407@gmail.com');
%>

<div class="mb-8 flex flex-col md:flex-row md:items-center justify-between gap-4">
    <div class="flex flex-col gap-2">
        <h1 class="text-3xl font-bold tracking-tight text-textMain">Welcome back, <%= locals.user ? (locals.user.fullName || locals.user.email) : 'User' %></h1>
        <p class="text-textMuted">Here's a detailed overview of the RoleNova ATS Pipeline and Engine health.</p>
    </div>
    <div class="flex flex-wrap items-center gap-3">
        <button id="btn-run" class="px-4 py-2 bg-primary hover:bg-primaryHover text-white rounded-md text-sm font-medium transition-colors shadow-sm disabled:opacity-50 disabled:cursor-not-allowed flex-1 sm:flex-none text-center">
            <i class="fa-solid fa-play mr-2"></i> Run Pipeline <%= isSuperAdmin ? '(Unlimited)' : '(1/Day)' %>
        </button>
        <button id="btn-force" class="px-4 py-2 bg-surface hover:bg-surfaceHover border border-border text-textMain rounded-md text-sm font-medium transition-colors disabled:opacity-50 disabled:cursor-not-allowed flex-1 sm:flex-none text-center whitespace-nowrap">
            <i class="fa-solid fa-bolt mr-2"></i> Force Refresh
        </button>
        <button id="btn-stop" class="px-4 py-2 bg-error/10 hover:bg-error/20 border border-error/20 text-error rounded-md text-sm font-medium transition-colors disabled:opacity-50 disabled:cursor-not-allowed flex-1 sm:flex-none text-center">
            <i class="fa-solid fa-stop mr-2"></i> Stop
        </button>
    </div>
</div>

<!-- User & Access Management (Super Admin only) -->
<% if (isSuperAdmin && locals.viewerStats) { %>
<div class="mb-8">
    <div class="flex items-center justify-between mb-4">
        <h2 class="text-lg font-semibold text-textMain">User Access Overview</h2>
        <a href="/admin/users" class="text-sm font-medium text-primary hover:text-primaryHover transition-colors flex items-center gap-2">
            Manage Users <i class="fa-solid fa-arrow-right"></i>
        </a>
    </div>
    
    <div class="grid grid-cols-1 md:grid-cols-3 gap-4 mb-4">
        <!-- Total Viewers -->
        <div class="bg-surface border border-border rounded-xl p-5 shadow-sm flex items-center gap-4">
            <div class="w-10 h-10 rounded-full bg-primary/10 flex items-center justify-center text-primary text-lg">
                <i class="fa-solid fa-users"></i>
            </div>
            <div>
                <p class="text-xs text-textMuted font-medium uppercase tracking-wider mb-1">Total Viewers</p>
                <p class="text-2xl font-bold text-textMain"><%= locals.viewerStats.total %></p>
            </div>
        </div>

        <!-- Pending Requests -->
        <div class="bg-surface border border-warning/30 rounded-xl p-5 shadow-sm flex items-center gap-4 relative overflow-hidden">
            <% if (locals.viewerStats.requested > 0) { %>
                <div class="absolute top-0 right-0 w-16 h-16 bg-warning/10 rounded-bl-full -mr-8 -mt-8"></div>
                <div class="absolute top-2 right-2 w-2 h-2 rounded-full bg-warning animate-pulse"></div>
            <% } %>
            <div class="w-10 h-10 rounded-full bg-warning/10 flex items-center justify-center text-warning text-lg">
                <i class="fa-solid fa-user-clock"></i>
            </div>
            <div>
                <p class="text-xs text-warning/80 font-medium uppercase tracking-wider mb-1">Pending Requests</p>
                <p class="text-2xl font-bold text-textMain"><%= locals.viewerStats.requested %></p>
            </div>
        </div>

        <!-- Granted Access -->
        <div class="bg-surface border border-success/30 rounded-xl p-5 shadow-sm flex items-center gap-4">
            <div class="w-10 h-10 rounded-full bg-success/10 flex items-center justify-center text-success text-lg">
                <i class="fa-solid fa-user-check"></i>
            </div>
            <div>
                <p class="text-xs text-success/80 font-medium uppercase tracking-wider mb-1">Granted Access</p>
                <p class="text-2xl font-bold text-textMain"><%= locals.viewerStats.granted.length %></p>
            </div>
        </div>
    </div>
    
    <!-- Granted Users List -->
    <% if (locals.viewerStats.granted.length > 0) { %>
    <div class="bg-surface border border-border rounded-xl shadow-sm overflow-hidden">
        <div class="px-5 py-3 border-b border-border bg-background/50">
            <h3 class="text-xs font-semibold text-textMuted uppercase tracking-wider">Active Extended Viewers</h3>
        </div>
        <div class="divide-y divide-border">
            <% locals.viewerStats.granted.forEach(user => { %>
                <div class="px-5 py-3 flex items-center justify-between hover:bg-background/30 transition-colors">
                    <div class="flex items-center gap-3">
                        <div class="w-8 h-8 rounded-full bg-primary/10 flex items-center justify-center text-primary text-sm font-bold">
                            <%= user.fullName ? user.fullName.charAt(0).toUpperCase() : 'U' %>
                        </div>
                        <div>
                            <p class="text-sm font-medium text-textMain"><%= user.fullName %></p>
                            <p class="text-xs text-textMuted"><%= user.email %></p>
                        </div>
                    </div>
                    <span class="inline-flex items-center gap-1.5 px-2 py-1 rounded-md bg-success/10 text-success text-xs font-medium border border-success/20">
                        <i class="fa-solid fa-check"></i> Access Active
                    </span>
                </div>
            <% }) %>
        </div>
    </div>
    <% } %>
</div>
<% } %>
<!-- Scheduler Overview -->
<div class="mb-8">
    <h2 class="text-lg font-semibold text-textMain mb-4">Scheduler Status (Azure Native)</h2>
    <div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-6 gap-3 md:gap-4">
        <%- include('../components/metric-card', { id: 'scheduler-status', title: 'Status', icon: 'fa-clock', color: 'text-primary' }) %>
        <%- include('../components/metric-card', { id: 'scheduler-trigger', title: 'Trigger Source', icon: 'fa-bolt', color: 'text-warning' }) %>
        <%- include('../components/metric-card', { id: 'scheduler-next', title: 'Next Scheduled Run', icon: 'fa-calendar-plus', color: 'text-[#8b5cf6]' }) %>
        <%- include('../components/metric-card', { id: 'scheduler-last', title: 'Last Scheduled Run', icon: 'fa-calendar-check', color: 'text-success' }) %>
        <%- include('../components/metric-card', { id: 'scheduler-success', title: 'Last Successful', icon: 'fa-check-circle', color: 'text-success' }) %>
        <%- include('../components/metric-card', { id: 'scheduler-failed', title: 'Last Failed', icon: 'fa-times-circle', color: 'text-error' }) %>
    </div>
</div>

<!-- Primary Stats Overview -->
<div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4 mb-8">
    
    <!-- Health Score -->
    <div class="bg-surface border border-border rounded-xl p-5 shadow-sm hover:border-border/80 transition-colors">
        <div class="flex items-center justify-between mb-4">
            <h3 class="text-sm font-medium text-textMuted">Platform Health Score</h3>
            <div class="w-8 h-8 rounded-full bg-success/10 flex items-center justify-center text-success">
                <i class="fa-solid fa-heart-pulse"></i>
            </div>
        </div>
        <div class="flex items-end justify-between">
            <div>
                <p class="text-3xl font-bold text-textMain" id="stat-health-score">--%</p>
                <p class="text-xs text-textMuted mt-1">Based on recent pipeline run</p>
            </div>
            <div class="flex items-center gap-1 text-xs font-medium text-success" id="stat-health-trend">
                <i class="fa-solid fa-arrow-up"></i>
                <span>--%</span>
            </div>
        </div>
    </div>

</div>


<!-- Lifetime Scraped & SDE Market Intelligence -->
<div class="mb-8">
    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-2 mb-4">
        <div>
            <h2 class="text-lg font-semibold text-textMain flex items-center gap-2">
                <i class="fa-solid fa-database text-primary"></i>
                All-Time Scraped & SDE Market Intelligence
            </h2>
            <p class="text-xs text-textMuted mt-0.5">Cumulative metrics since project creation — SDE fresher vs experienced opportunities and profile match conversion.</p>
        </div>
        <span class="text-xs font-semibold px-2.5 py-1 rounded-full bg-primary/10 text-primary border border-primary/20 flex items-center gap-1.5 self-start sm:self-auto">
            <i class="fa-solid fa-sparkles"></i> Lifetime DB Aggregate
        </span>
    </div>

    <!-- Lifetime Metric Cards Grid -->
    <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-6 gap-3 md:gap-4 mb-6">
        <%- include('../components/metric-card', { id: 'metric-lifetime-scraped', title: 'Total Jobs Scraped', icon: 'fa-globe', color: 'text-primary' }) %>
        <%- include('../components/metric-card', { id: 'metric-lifetime-matched', title: 'Matched to Profile', icon: 'fa-user-check', color: 'text-success' }) %>
        <%- include('../components/metric-card', { id: 'metric-lifetime-sde-fresher', title: 'SDE Fresher / 0 Exp', icon: 'fa-graduation-cap', color: 'text-[#8b5cf6]' }) %>
        <%- include('../components/metric-card', { id: 'metric-lifetime-sde-exp', title: 'SDE Experienced (2+y)', icon: 'fa-user-tie', color: 'text-warning' }) %>
        <%- include('../components/metric-card', { id: 'metric-lifetime-non-sde', title: 'Non-SDE / Other Roles', icon: 'fa-briefcase', color: 'text-textMuted' }) %>
        <%- include('../components/metric-card', { id: 'metric-lifetime-match-rate', title: 'Profile Match Rate', icon: 'fa-percent', color: 'text-success' }) %>
    </div>

    <!-- SDE Career Market Breakdown & Match Charts -->
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
        <div class="bg-surface border border-border rounded-xl p-5 shadow-sm">
            <div class="flex items-center justify-between mb-4">
                <h3 class="text-sm font-semibold text-textMain flex items-center gap-2">
                    <i class="fa-solid fa-chart-pie text-primary"></i> SDE vs Non-SDE Market Breakdown
                </h3>
                <span class="text-xs text-textMuted">All Scraped Jobs</span>
            </div>
            <div class="h-60 relative flex justify-center items-center">
                <canvas id="chart-sde-market"></canvas>
            </div>
        </div>

        <div class="bg-surface border border-border rounded-xl p-5 shadow-sm">
            <div class="flex items-center justify-between mb-4">
                <h3 class="text-sm font-semibold text-textMain flex items-center gap-2">
                    <i class="fa-solid fa-user-gear text-success"></i> Your Profile Matched Roles
                </h3>
                <span class="text-xs text-textMuted">95 Matched Jobs</span>
            </div>
            <div class="h-60 relative flex justify-center items-center">
                <canvas id="chart-user-matched-distribution"></canvas>
            </div>
        </div>
    </div>
</div>

<!-- Digest & Verification Overview -->
<div class="mb-8">
    <h2 class="text-lg font-semibold text-textMain mb-4">Daily Digest & Verification Status</h2>
    <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-4 gap-4">
        <%- include('../components/metric-card', { id: 'metric-ats-today', title: 'Today\'s ATS Matches', icon: 'fa-file-lines', color: 'text-primary' }) %>
        <%- include('../components/metric-card', { id: 'metric-telegram-today', title: 'Today\'s Telegram Matches', icon: 'fa-paper-plane', color: 'text-primary' }) %>
        <%- include('../components/metric-card', { id: 'metric-verified-gemini', title: 'Verified by Gemini', icon: 'fa-brain', color: 'text-[#8b5cf6]' }) %>
        <%- include('../components/metric-card', { id: 'metric-verified-groq', title: 'Verified by Groq', icon: 'fa-bolt', color: 'text-[#8b5cf6]' }) %>

        <%- include('../components/metric-card', { id: 'metric-pending-local', title: 'Pending Local Verification', icon: 'fa-clock', color: 'text-warning' }) %>
        <%- include('../components/metric-card', { id: 'metric-digest-sent', title: 'Daily Digest Sent', icon: 'fa-envelope-circle-check', color: 'text-success' }) %>
        <%- include('../components/metric-card', { id: 'metric-next-digest', title: 'Next Digest Time', icon: 'fa-calendar-alt', color: 'text-primary' }) %>
    </div>
</div>

<!-- Pipeline Metrics Grid -->
<div class="mb-8">
    <h2 class="text-lg font-semibold text-textMain mb-4">Pipeline Execution Metrics</h2>
    <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-4 lg:grid-cols-5 gap-4">
        
        <%- include('../components/metric-card', { id: 'metric-companies', title: 'Companies Monitored', icon: 'fa-building', color: 'text-primary' }) %>
        <%- include('../components/metric-card', { id: 'metric-jobs', title: 'Jobs Found Today', icon: 'fa-briefcase', color: 'text-success' }) %>
        <%- include('../components/metric-card', { id: 'metric-matched', title: 'Matched Jobs', icon: 'fa-check-double', color: 'text-success' }) %>
        <%- include('../components/metric-card', { id: 'metric-ai-eval', title: 'AI Evaluated', icon: 'fa-microchip', color: 'text-[#8b5cf6]' }) %>
        
        <%- include('../components/metric-card', { id: 'metric-healthy', title: 'Healthy Companies', icon: 'fa-check-circle', color: 'text-success' }) %>
        <%- include('../components/metric-card', { id: 'metric-failed', title: 'Failed Companies', icon: 'fa-times-circle', color: 'text-error' }) %>
        <%- include('../components/metric-card', { id: 'metric-parser-err', title: 'Parser Errors', icon: 'fa-code', color: 'text-warning' }) %>
        <%- include('../components/metric-card', { id: 'metric-ats-changed', title: 'ATS Changed', icon: 'fa-random', color: 'text-warning' }) %>
        
        <%- include('../components/metric-card', { id: 'metric-avg-run', title: 'Average Runtime', icon: 'fa-clock', color: 'text-primary' }) %>
        
    </div>
</div>

<!-- Charts Section -->
<div class="grid grid-cols-1 lg:grid-cols-3 gap-6 mb-8">
    <div class="bg-surface border border-border rounded-xl p-5 shadow-sm">
        <h3 class="text-sm font-medium text-textMain mb-4">Pipeline Runtime History</h3>
        <div class="h-64">
            <canvas id="chart-pipeline-runtime"></canvas>
        </div>
    </div>
    
    <div class="bg-surface border border-border rounded-xl p-5 shadow-sm">
        <h3 class="text-sm font-medium text-textMain mb-4">Cache Hit Rate vs Scraped</h3>
        <div class="h-64">
            <canvas id="chart-cache-hit"></canvas>
        </div>
    </div>

    <!-- Validation Funnel Widget -->
    <div class="bg-surface border border-border rounded-xl p-5 shadow-sm">
        <div class="flex items-center justify-between mb-4">
            <h3 class="text-sm font-medium text-textMain">Live Validation Funnel</h3>
            <span id="funnel-company-name" class="text-xs font-semibold text-primary px-2 py-1 bg-primary/10 rounded">Waiting...</span>
        </div>
        <div class="h-64 relative">
            <canvas id="chart-validation-funnel"></canvas>
        </div>
    </div>
</div>

<script type="module" src="/js/modules/dashboard.js"></script>

<%- include('../layouts/footer') %>
