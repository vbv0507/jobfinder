<%- include('../layouts/header') %>

<div class="mb-8">
    <h1 class="text-2xl font-bold tracking-tight text-textMain mb-2">AI Evaluation Dashboard</h1>
    <p class="text-textMuted text-sm">Monitor Gemini utilization, Groq fallback rates, and overall job matching precision.</p>
</div>

<div class="grid grid-cols-1 md:grid-cols-4 gap-4 mb-8">
    <div class="bg-surface border border-border rounded-xl p-5 shadow-sm">
        <h3 class="text-sm font-medium text-textMuted mb-2">Total Prompt Count</h3>
        <p id="ai-count" class="text-3xl font-bold text-primary">--</p>
        <p class="text-xs text-textMuted mt-1">Jobs evaluated</p>
    </div>
    <div class="bg-surface border border-border rounded-xl p-5 shadow-sm">
        <h3 class="text-sm font-medium text-textMuted mb-2">Average Match %</h3>
        <p id="ai-score" class="text-3xl font-bold text-success">--%</p>
        <p class="text-xs text-textMuted mt-1">Global relevance mean</p>
    </div>
    <div class="bg-surface border border-border rounded-xl p-5 shadow-sm">
        <h3 class="text-sm font-medium text-textMuted mb-2">Groq Fallback Rate</h3>
        <p id="ai-fallback" class="text-3xl font-bold text-warning">--%</p>
        <p class="text-xs text-textMuted mt-1">Due to Gemini rate limits</p>
    </div>
    <div class="bg-surface border border-border rounded-xl p-5 shadow-sm">
        <h3 class="text-sm font-medium text-textMuted mb-2">Avg Eval Time</h3>
        <p id="ai-time" class="text-3xl font-bold text-textMain">--s</p>
        <p class="text-xs text-textMuted mt-1">Per job description</p>
    </div>
</div>

<div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
    <div class="bg-surface border border-border rounded-xl p-5 shadow-sm">
        <h3 class="text-sm font-medium text-textMain mb-4">Provider Usage</h3>
        <div id="ai-provider-usage" class="space-y-3">
            <p class="text-textMuted text-sm">Waiting for analytics stream...</p>
        </div>
    </div>

    <div class="bg-surface border border-border rounded-xl p-5 shadow-sm">
        <h3 class="text-sm font-medium text-textMain mb-4">Model Usage Ratio</h3>
        <div id="ai-model-ratio" class="flex items-center gap-4 mt-6">
            <p class="text-textMuted text-sm">Waiting for analytics stream...</p>
        </div>
    </div>
</div>

<script type="module">
    import { createSocket } from '/js/modules/socketClient.js';

    function renderAiMetrics(data) {
        const metrics = data.metrics || {};
        const aiMetrics = data.aiMetrics || {};
        const providers = aiMetrics.providerStats || [];
        const totalProviders = providers.reduce((sum, provider) => sum + (provider.count || 0), 0);

        document.getElementById('ai-count').innerText = metrics["AI Evaluations"] || totalProviders || 0;

        const matchPct = metrics["AI Evaluations"] > 0 ? Math.round((metrics["Matched Jobs"] / metrics["AI Evaluations"]) * 100) : 0;
        document.getElementById('ai-score').innerText = matchPct + '%';
        document.getElementById('ai-time').innerText = ((aiMetrics.averageEvaluationTimeMs || metrics["Average AI Time"] || 0) / 1000).toFixed(1) + 's';
        document.getElementById('ai-fallback').innerText = (aiMetrics.fallbackPercentage || 0) + '%';

        document.getElementById('ai-provider-usage').innerHTML = providers.length
            ? providers.map((provider) => {
                const pct = totalProviders > 0 ? Math.round(((provider.count || 0) / totalProviders) * 100) : 0;
                return `
                    <div>
                        <div class="flex items-center justify-between text-sm">
                            <span class="text-textMuted">${provider._id || 'unknown'}</span>
                            <span class="text-textMain font-medium">${pct}% (${provider.count || 0})</span>
                        </div>
                        <div class="w-full bg-background rounded-full h-1.5 border border-border mt-2">
                            <div class="bg-primary h-1.5 rounded-full" style="width: ${pct}%"></div>
                        </div>
                    </div>`;
            }).join('')
            : '<p class="text-textMuted text-sm">No AI provider data yet.</p>';

        document.getElementById('ai-model-ratio').innerHTML = providers.length
            ? providers.map((provider) => `
                <div class="flex items-center gap-2">
                    <span class="w-3 h-3 rounded bg-primary"></span>
                    <span class="text-sm text-textMuted">${provider._id || 'unknown'} (${provider.count || 0})</span>
                </div>
            `).join('')
            : '<p class="text-textMuted text-sm">No model usage yet.</p>';
    }

    document.addEventListener("DOMContentLoaded", async () => {
        const socket = await createSocket();
        socket.on('dashboard:init', (payload) => renderAiMetrics(payload.analytics || payload));
        socket.on('analytics:update', renderAiMetrics);
    });
</script>

<%- include('../layouts/footer') %>
