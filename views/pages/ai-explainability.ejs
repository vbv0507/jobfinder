<%- include('../layouts/header', { title: 'AI Explainability' }) %>

<div class="mb-8">
    <h1 class="text-2xl font-bold tracking-tight text-textMain mb-2">AI Explainability</h1>
    <p class="text-textMuted text-sm">Understand how the AI Engine scored and evaluated candidates against job requirements.</p>
</div>

<div class="grid grid-cols-1 gap-6" id="explainability-grid">
    <div class="col-span-full py-16 text-center text-textMuted flex flex-col items-center">
        <i class="fa-solid fa-spinner fa-spin text-3xl mb-4 text-primary"></i>
        <p class="text-sm">Loading AI Decisions...</p>
    </div>
</div>

<script>
    async function loadExplainability() {
        try {
            // Just fetching from jobs api for demonstration, we can fetch all jobs or rejected jobs
            const res = await fetch('/api/jobs');
            const data = await res.json();
            
            if (!data.success || !data.jobs) throw new Error("Failed to load");
            
            const container = document.getElementById('explainability-grid');
            
            if (data.jobs.length === 0) {
                container.innerHTML = '<div class="p-12 text-center text-textMuted">No AI evaluation data available yet.</div>';
                return;
            }
            
            container.innerHTML = data.jobs.map(job => `
                <div class="bg-surface border border-border rounded-xl p-5 hover:border-border/80 transition-colors shadow-sm">
                    <div class="flex justify-between items-start mb-4">
                        <div>
                            <h3 class="font-bold text-textMain text-lg">${job.role || job.title}</h3>
                            <div class="text-sm text-textMuted mt-1">${job.company?.name || 'Unknown Company'}</div>
                        </div>
                        <div class="flex flex-col items-end">
                            <span class="text-xl font-bold ${job.score >= 60 ? 'text-success' : 'text-error'}">${job.score} / 100</span>
                            <span class="text-xs uppercase tracking-wider font-semibold text-textMuted">${job.recommendationLevel || 'Evaluated'}</span>
                        </div>
                    </div>
                    
                    <div class="grid grid-cols-1 md:grid-cols-2 gap-4 border-t border-border pt-4">
                        <div>
                            <h4 class="text-xs font-semibold text-success uppercase mb-2">Strengths & Matched Skills</h4>
                            <ul class="text-sm space-y-1 text-textMain">
                                ${job.strengths?.map(s => `<li><i class="fa-solid fa-check text-success mr-2 text-xs"></i>${s}</li>`).join('') || ''}
                                ${job.matchedSkills?.map(s => `<li><i class="fa-solid fa-check text-success mr-2 text-xs"></i>${s}</li>`).join('') || ''}
                                ${!job.strengths?.length && !job.matchedSkills?.length ? '<li class="text-textMuted">None recorded</li>' : ''}
                            </ul>
                        </div>
                        <div>
                            <h4 class="text-xs font-semibold text-error uppercase mb-2">Weaknesses & Missing Skills</h4>
                            <ul class="text-sm space-y-1 text-textMain">
                                ${job.weaknesses?.map(s => `<li><i class="fa-solid fa-xmark text-error mr-2 text-xs"></i>${s}</li>`).join('') || ''}
                                ${job.missingSkills?.map(s => `<li><i class="fa-solid fa-xmark text-error mr-2 text-xs"></i>${s}</li>`).join('') || ''}
                                ${!job.weaknesses?.length && !job.missingSkills?.length ? '<li class="text-textMuted">None recorded</li>' : ''}
                            </ul>
                        </div>
                    </div>
                    
                    ${job.reason ? `
                    <div class="mt-4 p-3 bg-background border border-border rounded-md">
                        <p class="text-sm italic text-textMuted">" ${job.reason} "</p>
                    </div>` : ''}
                </div>
            `).join('');
            
        } catch (err) {
            document.getElementById('explainability-grid').innerHTML = '<div class="p-12 text-center text-error">Failed to load AI explainability data.</div>';
        }
    }
    
    document.addEventListener("DOMContentLoaded", loadExplainability);
</script>

<%- include('../layouts/footer') %>
