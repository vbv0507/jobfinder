<%- include('../layouts/header') %>

<div class="mb-8">
    <h1 class="text-2xl font-bold tracking-tight text-textMain mb-2">Pipeline Execution</h1>
    <p class="text-textMuted text-sm">Live monitoring of the RoleNova Intelligence Engine.</p>
</div>

<!-- Live Progress Status -->
<div class="bg-surface border border-border rounded-xl p-6 shadow-sm mb-8">
    <div class="flex items-center justify-between mb-6">
        <div class="flex items-center gap-3">
            <div id="status-indicator" class="w-3 h-3 rounded-full bg-border shadow-[0_0_8px_rgba(39,39,42,0.6)]"></div>
            <h2 id="status-text" class="text-lg font-semibold text-textMain">Status: Idle</h2>
        </div>
        <div class="text-sm font-medium text-textMuted flex gap-4">
            <span>Elapsed: <span id="elapsed-time" class="text-textMain font-mono">0s</span></span>
            <span>Remaining: <span id="remaining-time" class="text-textMain font-mono">0s</span></span>
        </div>
    </div>
    
    <!-- Progress Bar -->
    <div class="w-full bg-background rounded-full h-2.5 mb-2 border border-border">
        <div id="progress-bar-fill" class="bg-primary h-2.5 rounded-full transition-all duration-500 relative overflow-hidden" style="width: 0%">
            <div class="absolute inset-0 bg-white/20 animate-[shimmer_2s_infinite]"></div>
        </div>
    </div>
    <div class="flex justify-between text-xs font-medium text-textMuted mb-6">
        <span id="progress-percent">0%</span>
        <span id="progress-text">Company 0 of 0</span>
        <span>100%</span>
    </div>

    <!-- Live Execution Metrics -->
    <div class="grid grid-cols-2 md:grid-cols-4 gap-4 pt-4 border-t border-border">
        <div>
            <p class="text-xs text-textMuted mb-1">Current Company</p>
            <p class="text-sm font-semibold text-textMain"><span id="current-company">None</span> <span id="current-ats" class="text-primary ml-1 text-xs px-1.5 py-0.5 rounded bg-primary/10 hidden"></span></p>
        </div>
        <div>
            <p class="text-xs text-textMuted mb-1">Current URL</p>
            <p id="current-url" class="text-sm font-semibold text-textMain truncate" title="N/A">N/A</p>
        </div>
        <div>
            <p class="text-xs text-textMuted mb-1">Current Stage</p>
            <p id="current-stage" class="text-sm font-semibold text-warning truncate">Idle</p>
        </div>
        <div>
            <p class="text-xs text-textMuted mb-1">AI Model</p>
            <p id="current-model" class="text-sm font-semibold text-textMain font-mono">N/A</p>
        </div>
        
        <!-- Row 2 -->
        <div>
            <p class="text-xs text-textMuted mb-1">Jobs Found</p>
            <p id="jobs-found" class="text-sm font-semibold text-textMain font-mono">0</p>
        </div>
        <div>
            <p class="text-xs text-textMuted mb-1">Jobs Saved</p>
            <p id="jobs-saved" class="text-sm font-semibold text-success font-mono">0</p>
        </div>
        <div>
            <p class="text-xs text-textMuted mb-1">Matched Jobs</p>
            <p id="matched-jobs" class="text-sm font-semibold text-primary font-mono">0</p>
        </div>
        <div>
            <p class="text-xs text-textMuted mb-1">Retry Count</p>
            <p id="retry-count" class="text-sm font-semibold text-error font-mono">0</p>
        </div>
    </div>
</div>

<!-- GitHub Actions Style Timeline -->
<div>
    <h3 class="text-lg font-semibold text-textMain mb-4">Execution Logs</h3>
    <div class="bg-surface border border-border rounded-xl p-0 shadow-sm font-mono text-sm overflow-hidden">
        <div id="timeline-container" class="flex flex-col h-[500px] overflow-y-auto bg-[#0d1117] text-[#c9d1d9] p-4 text-xs font-mono">
            <p class="p-4 text-textMuted text-center text-sm">Waiting for execution to start...</p>
        </div>
    </div>
</div>

<script type="module" src="/js/modules/pipeline.js"></script>

<style>
    @keyframes shimmer {
        0% { transform: translateX(-100%); }
        100% { transform: translateX(100%); }
    }
</style>

<%- include('../layouts/footer') %>
