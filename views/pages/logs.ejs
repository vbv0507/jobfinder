<%- include('../layouts/header') %>

<div class="mb-8 flex flex-col sm:flex-row sm:items-center justify-between gap-4">
    <div>
        <h1 class="text-2xl font-bold tracking-tight text-textMain mb-2">Runtime Logs Explorer</h1>
        <p class="text-textMuted text-sm">Real-time pipeline output with advanced filtering and grouping.</p>
    </div>
    
    <div class="flex items-center gap-2">
        <button class="bg-surface hover:bg-surfaceHover border border-border text-textMain px-3 py-1.5 rounded-md text-sm font-medium transition-colors">
            <i class="fa-solid fa-download mr-1.5"></i> Download
        </button>
        <button class="bg-surface hover:bg-surfaceHover border border-border text-textMain px-3 py-1.5 rounded-md text-sm font-medium transition-colors">
            <i class="fa-regular fa-copy mr-1.5"></i> Copy
        </button>
    </div>
</div>

<!-- Filters -->
<div class="bg-surface border border-border rounded-xl p-4 shadow-sm mb-4 flex flex-wrap items-center gap-4">
    <div class="relative flex-1 min-w-[200px]">
        <i class="fa-solid fa-search absolute left-3 top-1/2 -translate-y-1/2 text-textMuted text-xs"></i>
        <input type="text" placeholder="Search logs (e.g. 'Playwright failed')..." class="w-full bg-background border border-border rounded-md pl-8 pr-3 py-2 text-sm text-textMain focus:outline-none focus:border-primary transition-colors">
    </div>
    <div class="flex items-center gap-2">
        <select class="bg-background border border-border rounded-md px-3 py-2 text-sm text-textMain focus:outline-none focus:border-primary">
            <option>All Levels</option>
            <option>INFO</option>
            <option>WARN</option>
            <option>ERROR</option>
        </select>
        <select class="bg-background border border-border rounded-md px-3 py-2 text-sm text-textMain focus:outline-none focus:border-primary">
            <option>All Systems</option>
            <option>Pipeline</option>
            <option>RetryChain</option>
            <option>Discovery</option>
        </select>
    </div>
</div>

<!-- Terminal UI -->
<div class="bg-[#0c0c0c] border border-border rounded-xl shadow-lg overflow-hidden h-[600px] flex flex-col font-mono text-xs relative">
    <div class="flex items-center justify-between px-4 py-2 bg-surface border-b border-border text-textMuted">
        <div class="flex items-center gap-2">
            <span class="w-3 h-3 rounded-full bg-error/80"></span>
            <span class="w-3 h-3 rounded-full bg-warning/80"></span>
            <span class="w-3 h-3 rounded-full bg-success/80"></span>
        </div>
        <div class="flex items-center gap-4 text-[10px] uppercase tracking-wider">
            <label class="flex items-center gap-1.5 cursor-pointer hover:text-textMain">
                <input type="checkbox" checked class="accent-primary"> Auto-scroll
            </label>
        </div>
    </div>
    
    <div id="logs-container" class="flex-1 overflow-y-auto p-4 custom-scrollbar space-y-1">
        <!-- Log Lines injected by JS -->
        <p class="text-textMuted text-center p-4">Waiting for log stream...</p>
    </div>
</div>

<script type="module" src="/js/modules/logs.js"></script>

<%- include('../layouts/footer') %>
