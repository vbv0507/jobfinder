<%- include('../layouts/header', { title: pageTitle || 'Companies Monitored' }) %>

<div class="mb-8">
    <h1 class="text-2xl font-bold tracking-tight text-textMain mb-2"><%= pageTitle || 'Active Companies' %></h1>
    <p class="text-textMuted text-sm"><%= pageSubtitle || 'Companies currently monitored by the job pipeline.' %></p>
</div>

<div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-4 md:gap-6" id="companies-grid">
    <div class="col-span-full py-16 text-center text-textMuted flex flex-col items-center">
        <i class="fa-solid fa-spinner fa-spin text-3xl mb-4 text-primary"></i>
        <p class="text-sm">Loading companies from engine...</p>
    </div>
</div>

<script>
    const companiesApiUrl = <%- JSON.stringify(apiUrl || '/api/companies') %>;
    const enableRealtime = <%- JSON.stringify(enableRealtime !== false) %>;

    const timeAgo = (dateStr) => {
        if (!dateStr) return 'Never';
        const date = new Date(dateStr);
        const seconds = Math.floor((new Date() - date) / 1000);
        let interval = seconds / 31536000;
        if (interval > 1) return Math.floor(interval) + " years ago";
        interval = seconds / 2592000;
        if (interval > 1) return Math.floor(interval) + " months ago";
        interval = seconds / 86400;
        if (interval > 1) return Math.floor(interval) + " days ago";
        interval = seconds / 3600;
        if (interval > 1) return Math.floor(interval) + " hours ago";
        interval = seconds / 60;
        if (interval > 1) return Math.floor(interval) + " minutes ago";
        if (seconds < 0) return "Just now";
        return Math.floor(seconds) + " seconds ago";
    };

    function normalizeCompaniesPayload(data) {
        if (Array.isArray(data)) {
            return { success: true, count: data.length, companies: data };
        }
        return data || { success: true, count: 0, companies: [] };
    }

    function renderCompanies(data, state = null) {
            data = normalizeCompaniesPayload(data);
            const container = document.getElementById("companies-grid");
            
            if(data.success && data.companies.length > 0) {
                container.innerHTML = data.companies.map(c => {
                    let runBadge = '';
                    let dotColor = c.lastRunStatus === 'failed' ? 'bg-error' : 'bg-success';
                    let dotPing = false;
                    
                    if (state && state.running) {
                        const isRunning = state.activeCompanies && state.activeCompanies.includes(c.name);
                        const isSkipped = c.lastScrapedAt && new Date(c.lastScrapedAt) > new Date(state.startTime);
                        
                        if (isRunning) {
                            runBadge = '<span class="text-[10px] font-bold px-2 py-0.5 rounded bg-warning/10 text-warning uppercase border border-warning/20">Running</span>';
                            dotColor = 'bg-warning';
                            dotPing = true;
                        } else if (isSkipped) {
                            runBadge = '<span class="text-[10px] font-bold px-2 py-0.5 rounded bg-success/10 text-success uppercase border border-success/20">Completed</span>';
                        } else {
                            runBadge = '<span class="text-[10px] font-bold px-2 py-0.5 rounded bg-textMuted/10 text-textMuted uppercase border border-border">Queued</span>';
                            dotColor = 'bg-textMuted';
                        }
                    } else {
                        // Not running
                        if (c.lastRunStatus === 'failed') {
                            runBadge = '<span class="text-[10px] font-bold px-2 py-0.5 rounded bg-error/10 text-error uppercase border border-error/20">Failed</span>';
                        } else {
                            runBadge = '<span class="text-[10px] font-bold px-2 py-0.5 rounded bg-success/10 text-success uppercase border border-success/20">Idle</span>';
                        }
                    }
                    
                    return `
                    <div class="bg-surface border border-border rounded-xl p-5 hover:border-border/80 transition-colors shadow-sm flex flex-col ${c.active === false ? 'opacity-60 bg-surface/40' : ''}">
                        <div class="flex justify-between items-start mb-4">
                            <div class="flex items-center gap-4">
                                <div class="w-12 h-12 rounded-lg bg-background border border-border flex items-center justify-center shrink-0 overflow-hidden">
                                    <img src="${c.logoUrl}" class="w-8 h-8 object-contain" alt="Logo" loading="lazy">
                                </div>
                                <div>
                                    <h3 class="font-bold text-textMain text-lg truncate" title="${c.name}">${c.name}</h3>
                                    <div class="flex items-center gap-2 mt-1">
                                      <span class="text-[10px] font-bold px-2 py-0.5 rounded bg-primary/10 text-primary uppercase">${c.ats || 'Auto-Detect'}</span>
                                      ${runBadge}
                                    </div>
                                </div>
                            </div>
                            <div class="flex items-center gap-3">
                                <label class="relative inline-flex items-center cursor-pointer select-none" title="${c.active !== false ? 'Active (Monitored)' : 'Inactive (Paused)'}">
                                    <input type="checkbox" class="sr-only peer" ${c.active !== false ? 'checked' : ''} onchange="toggleCompanyStatus('${c._id}', '${c.name}', this.checked)">
                                    <div class="w-8 h-4 bg-border peer-focus:outline-none rounded-full peer peer-checked:after:translate-x-full peer-checked:after:border-white after:content-[''] after:absolute after:top-[2px] after:left-[2px] after:bg-white after:border-gray-300 after:border after:rounded-full after:h-3 after:w-3 after:transition-all peer-checked:bg-success"></div>
                                </label>
                                <span class="flex h-3 w-3 relative shrink-0">
                                  ${dotPing ? `<span class="animate-ping absolute inline-flex h-full w-full rounded-full ${dotColor} opacity-50"></span>` : ''}
                                  <span class="relative inline-flex rounded-full h-3 w-3 ${dotColor}"></span>
                                </span>
                            </div>
                        </div>
                        
                        <div class="mt-auto pt-4 border-t border-border">
                            <div class="flex justify-between text-sm text-textMuted mb-2">
                                <span>Jobs Found</span>
                                <span class="font-bold text-textMain">${c.jobsFound !== undefined ? c.jobsFound : 0}</span>
                            </div>
                            <div class="flex justify-between text-sm text-textMuted mb-2">
                                <span>Matched Jobs</span>
                                <span class="font-bold text-textMain">${c.matchedJobs !== undefined ? c.matchedJobs : 0}</span>
                            </div>
                            <div class="flex justify-between text-sm text-textMuted mb-4">
                                <span>Last Scan</span>
                                <span class="font-medium text-textMain">${timeAgo(c.lastScan)}</span>
                            </div>
                            <div class="grid grid-cols-3 gap-2 mt-2 mb-3">
                              <a href="${c.careerUrl}" target="_blank" class="flex items-center justify-center bg-surfaceHover hover:bg-border text-textMain font-medium py-2 rounded-md transition-colors text-xs border border-border truncate px-1">
                                  Careers <i class="fa-solid fa-arrow-up-right-from-square ml-1 text-[9px]"></i>
                              </a>
                              <a href="/jobs?company=${encodeURIComponent(c.name)}" class="flex items-center justify-center bg-primary/10 hover:bg-primary text-primary hover:text-white font-medium py-2 rounded-md transition-colors text-xs truncate px-1">
                                  Jobs <i class="fa-solid fa-search ml-1 text-[9px]"></i>
                              </a>
                              <button onclick="scrapeCompanySingle('${c._id}', '${c.name}', this)" class="flex items-center justify-center bg-emerald-500/10 hover:bg-emerald-500 text-emerald-400 hover:text-white font-medium py-2 rounded-md transition-colors text-xs truncate px-1 border border-emerald-500/20">
                                  <i class="fa-solid fa-play text-[9px] mr-1"></i> Scrape
                              </button>
                            </div>

                            <details class="mt-4 text-xs group">
                                <summary class="cursor-pointer text-textMuted hover:text-textMain font-medium select-none focus:outline-none transition-colors">
                                    <i class="fa-solid fa-chevron-right text-[10px] mr-1 transition-transform group-open:rotate-90"></i> Pipeline Logs
                                </summary>
                                <div class="mt-3 space-y-2 border-l border-border pl-3 ml-1 max-h-48 overflow-y-auto custom-scrollbar">
                                    ${c.latestExecutionTimeline && c.latestExecutionTimeline.length > 0 
                                      ? c.latestExecutionTimeline.map(t => {
                                          const color = t.severity === 'ERROR' ? 'text-error' : (t.severity === 'WARN' ? 'text-warning' : (t.severity === 'SUCCESS' ? 'text-success' : 'text-textMuted'));
                                          const time = new Date(t.timestamp).toLocaleTimeString([], { hour: '2-digit', minute: '2-digit', second: '2-digit' });
                                          return `<div class="relative">
                                              <div class="absolute -left-[17px] top-1.5 h-1.5 w-1.5 rounded-full bg-border ring-2 ring-surface"></div>
                                              <div class="flex flex-col">
                                                  <span class="font-mono text-[10px] text-textMuted">${time} &middot; ${t.stage}</span>
                                                  <span class="${color} break-words leading-relaxed mt-0.5">${t.message}</span>
                                              </div>
                                          </div>`;
                                      }).join('') 
                                      : '<p class="text-textMuted">No recent logs.</p>'}
                                </div>
                            </details>
                        </div>
                    </div>`;
                }).join('');
            } else {
                container.innerHTML = '<div class="col-span-full p-12 text-center text-textMuted">No companies monitored yet.</div>';
            }
    }

    async function toggleCompanyStatus(id, name, active) {
        try {
            const data = await apiCall(`/api/companies/${id}/toggle`, 'PATCH', { active });
            if (data.success) {
                console.log(`[Company] ${name} is now ${active ? 'Active' : 'Inactive'}`);
            } else {
                alert(`Failed to update ${name}: ` + (data.message || 'Unknown error'));
            }
        } catch (e) {
            console.error('Toggle error:', e);
            alert(`Error: ${e.message}`);
        }
    }

    async function scrapeCompanySingle(id, name, btn) {
        if (!btn) return;
        const originalHtml = btn.innerHTML;
        btn.disabled = true;
        btn.innerHTML = '<i class="fa-solid fa-spinner fa-spin text-[9px]"></i>';
        
        try {
            const data = await apiCall(`/api/companies/${id}/scrape`, 'POST');
            if (data.success) {
                alert(`✓ [${data.company}] Scraped ${data.rawJobsFound} jobs successfully in ${data.durationMs}ms!`);
                if (typeof loadCompaniesOnce === 'function') loadCompaniesOnce();
            } else {
                alert(`✗ Error scraping ${name}: ` + (data.message || 'Scraper failed'));
            }
        } catch (e) {
            console.error('Scrape error:', e);
            alert(`Scrape error for ${name}: ${e.message}`);
        } finally {
            btn.disabled = false;
            btn.innerHTML = originalHtml;
        }
    }

    async function loadCompaniesOnce() {
        try {
            const response = await fetch(companiesApiUrl);
            const data = await response.json();
            renderCompanies(data, null);
        } catch (e) {
            console.error('REST load failed:', e);
            document.getElementById("companies-grid").innerHTML = '<div class="col-span-full p-12 text-center text-error">Failed to load companies.</div>';
        }
    }

    async function initCompaniesSocket() {
        if (!enableRealtime) {
            await loadCompaniesOnce();
            return;
        }

        let latestCompanies = null;
        let latestPipeline = null;
        
        // Start fallback timer immediately, before any awaits
        const fallbackTimer = setTimeout(async () => {
            if (!latestCompanies) {
                try {
                    console.log("[Companies] Socket/Clerk took too long, falling back to REST " + companiesApiUrl + "...");
                    const response = await fetch(companiesApiUrl);
                    const data = await response.json();
                    if (data.success && data.companies && !latestCompanies) { // check again to avoid race condition
                        latestCompanies = data;
                        renderCompanies(latestCompanies, latestPipeline);
                    }
                } catch(e) {
                    console.error('REST fallback failed:', e);
                    if (!latestCompanies) {
                        document.getElementById("companies-grid").innerHTML = '<div class="col-span-full p-12 text-center text-error">Failed to load companies.</div>';
                    }
                }
            }
        }, 2000);

        try {
            const { createSocket } = await import('/js/modules/socketClient.js');
            const socket = await createSocket();

            socket.on('dashboard:init', (payload) => {
                latestPipeline = payload.pipeline || latestPipeline;
                if (payload.companies) {
                    latestCompanies = payload.companies;
                    renderCompanies(latestCompanies, latestPipeline);
                }
            });

            socket.on('companies:init', (payload) => {
                latestCompanies = payload;
                renderCompanies(latestCompanies, latestPipeline);
            });

            socket.on('companies:update', (payload) => {
                latestCompanies = payload;
                renderCompanies(latestCompanies, latestPipeline);
            });

            socket.on('company:update', (company) => {
                if (!latestCompanies || !Array.isArray(latestCompanies.companies)) return;
                latestCompanies.companies = latestCompanies.companies.map((item) => item._id === company._id ? company : item);
                renderCompanies(latestCompanies, latestPipeline);
            });

            socket.on('pipeline:update', (payload) => {
                latestPipeline = payload.pipeline || latestPipeline;
                if (latestCompanies) renderCompanies(latestCompanies, latestPipeline);
            });

            // Force a refresh immediately after binding listeners
            socket.emit('dashboard:refresh');
        } catch(e) {
            console.error("Socket initialization error:", e);
            // The REST fallback timer is already running and will handle data loading
        }
    }

    document.addEventListener("DOMContentLoaded", () => {
        initCompaniesSocket();
    });
</script>

<%- include('../layouts/footer') %>
