<%- include('../layouts/header') %>

<div class="mb-8 flex flex-col md:flex-row md:items-center justify-between gap-4">
    <div>
        <h1 class="text-2xl font-bold tracking-tight text-textMain mb-2"><%= title %></h1>
        <p class="text-textMuted text-sm">Review AI-matched roles and their evaluation scores.</p>
    </div>
    
    <div class="relative min-w-[300px]">
        <i class="fa-solid fa-search absolute left-3 top-1/2 -translate-y-1/2 text-textMuted text-xs"></i>
        <input type="text" id="searchInput" onkeyup="filterJobs()" placeholder="Search roles or companies..." class="w-full bg-background border border-border rounded-md pl-8 pr-3 py-2 text-sm text-textMain focus:outline-none focus:border-primary transition-colors">
    </div>
</div>

<div class="bg-surface border border-border rounded-xl shadow-sm overflow-hidden min-h-[400px]">
    <% if (jobs.length === 0) { %>
        <div class="p-16 text-center text-textMuted flex flex-col items-center justify-center h-full">
            <div class="w-16 h-16 rounded-full bg-surfaceHover flex items-center justify-center mb-4 border border-border">
                <i class="fa-regular fa-folder-open text-2xl text-textMuted"></i>
            </div>
            <p class="text-lg font-medium text-textMain mb-1">No jobs found</p>
            <p class="text-sm">Try running the job search pipeline or checking back later.</p>
        </div>
    <% } else { %>
        <div class="overflow-x-auto w-full">
            <table class="min-w-full text-left border-collapse">
                <thead class="bg-surfaceHover border-b border-border hidden md:table-header-group sticky top-0 z-10">
                    <tr>
                        <th class="px-6 py-4 text-xs font-semibold text-textMuted uppercase tracking-wider">Role & Company</th>
                        <th class="px-6 py-4 text-xs font-semibold text-textMuted uppercase tracking-wider">Score</th>
                        <th class="px-6 py-4 text-xs font-semibold text-textMuted uppercase tracking-wider">Missing Skills</th>
                        <th class="px-6 py-4 text-xs font-semibold text-textMuted uppercase tracking-wider text-right">Reason</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-border text-sm" id="jobsTableBody">
                    <% jobs.forEach(function(job) { %>
                        <tr class="hover:bg-surfaceHover transition-colors job-row flex flex-col md:table-row border-b md:border-b-0 border-border p-4 md:p-0">
                            <td class="md:px-6 md:py-4 flex items-center justify-between md:table-cell mb-3 md:mb-0">
                                <div class="flex items-center gap-3">
                                    <div class="w-10 h-10 rounded-md bg-background border border-border flex items-center justify-center overflow-hidden shrink-0">
                                        <img src="<%= getCompanyLogo(job.company && job.company.name ? job.company.name : 'Unknown') %>" class="w-6 h-6 object-contain" alt="Logo" loading="lazy">
                                    </div>
                                    <div>
                                        <div class="font-semibold text-textMain job-title"><%= job.role %></div>
                                        <div class="text-xs text-textMuted job-company mt-0.5"><%= (job.company && job.company.name) ? job.company.name : 'Unknown' %></div>
                                    </div>
                                </div>
                            </td>
                            <td class="md:px-6 md:py-4 flex items-center justify-between md:table-cell mb-2 md:mb-0">
                                <span class="md:hidden text-xs font-medium text-textMuted uppercase">Score</span>
                                <div class="flex items-center gap-2">
                                    <% 
                                        let scoreColor = "text-textMuted bg-surfaceHover border-border";
                                        let displayScore = "N/A";
                                        if (job.score != null) {
                                            displayScore = job.score + "/100";
                                            scoreColor = "text-success bg-success/10 border-success/20";
                                            if (job.score < 70) scoreColor = "text-warning bg-warning/10 border-warning/20";
                                            if (job.score < 40) scoreColor = "text-error bg-error/10 border-error/20";
                                        }
                                    %>
                                    <span class="px-2.5 py-0.5 inline-flex text-xs font-bold rounded-full border <%= scoreColor %>">
                                        <%= displayScore %>
                                    </span>
                                    
                                    <% 
                                        let aiColor = "text-success bg-success/10";
                                        let aiName = job.provider ? (job.provider.charAt(0).toUpperCase() + job.provider.slice(1)) : (job.evaluatedBy || 'Gemini');
                                        if (job.provider === 'groq' || job.evaluatedBy === 'Groq') aiColor = "text-warning bg-warning/10";
                                        if (job.provider === 'local' || job.provider === 'unknown' || job.evaluatedBy === 'Local') aiColor = "text-textMuted bg-surfaceHover";
                                    %>
                                    <span class="px-2 py-0.5 inline-flex text-[10px] font-semibold rounded-full <%= aiColor %>">
                                        <%= aiName %>
                                    </span>
                                </div>
                            </td>
                            <td class="md:px-6 md:py-4 text-textMuted flex flex-col md:table-cell mb-4 md:mb-0">
                                <span class="md:hidden text-xs font-medium uppercase mb-1">Missing Skills</span>
                                <div class="flex flex-wrap gap-1">
                                    <% if (job.missingSkills && job.missingSkills.length > 0) { %>
                                        <% job.missingSkills.slice(0, 3).forEach(skill => { %>
                                            <span class="px-2 py-0.5 bg-error/10 text-error text-[10px] rounded border border-error/20 whitespace-nowrap"><%= skill %></span>
                                        <% }) %>
                                        <% if (job.missingSkills.length > 3) { %>
                                            <span class="px-2 py-0.5 bg-surfaceHover text-textMuted text-[10px] rounded border border-border whitespace-nowrap">+<%= job.missingSkills.length - 3 %></span>
                                        <% } %>
                                    <% } else { %>
                                        <span class="text-xs italic text-textMuted">None specified</span>
                                    <% } %>
                                </div>
                            </td>
                            <td class="md:px-6 md:py-4 text-right flex flex-col md:table-cell md:text-right mb-2 md:mb-0 max-w-xs">
                                <span class="md:hidden text-xs font-medium uppercase mb-1 text-left">Reason</span>
                                <span class="text-xs text-textMuted md:truncate block" title="<%= job.reason || 'Not suitable' %>"><%= job.reason || 'Not suitable' %></span>
                            </td>
                        </tr>
                    <% }); %>
                </tbody>
            </table>
        </div>
    <% } %>
</div>

<script>
function filterJobs() {
    let input = document.getElementById("searchInput").value.toLowerCase();
    let rows = document.querySelectorAll(".job-row");
    
    rows.forEach(row => {
        let title = row.querySelector(".job-title").innerText.toLowerCase();
        let company = row.querySelector(".job-company").innerText.toLowerCase();
        
        if (title.includes(input) || company.includes(input)) {
            row.style.display = "";
        } else {
            row.style.display = "none";
        }
    });
}
async function updateStatus(id, status) {
    try {
        const res = await fetch(`/api/jobs/${id}/status`, {
            method: 'PATCH',
            headers: {'Content-Type': 'application/json'},
            body: JSON.stringify({ status })
        });
        if(res.ok) window.location.reload();
    } catch (e) {
        console.error(e);
    }
}
</script>

<%- include('../layouts/footer') %>
