# ==========================================
# RoleNova v2.0 Configuration
# ==========================================

# ------------------------------------------
# Server & Database
# ------------------------------------------
PORT=3000
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/jobfinder?retryWrites=true&w=majority

# ------------------------------------------
# Authentication (Clerk)
# ------------------------------------------
CLERK_SECRET_KEY=sk_test_...
CLERK_PUBLISHABLE_KEY=pk_test_...

# ------------------------------------------
# AI Evaluation Providers (Waterfall)
# ------------------------------------------
# Primary AI (Google Gemini)
GEMINI_API_KEY=AIzaSy...

# Secondary AI (Groq - for speed/fallback)
GROQ_API_KEY=gsk_...

# Tertiary AI (OpenAI / Zai - if needed)
OPENAI_API_KEY=sk-...

# ------------------------------------------
# Pipeline Configuration
# ------------------------------------------
MAX_JOBS_PER_COMPANY=10
MATCH_THRESHOLD=70
STRICT_LOCATION_MATCH=false

# ------------------------------------------
# Telegram Integration (Optional)
# ------------------------------------------
TELEGRAM_BOT_TOKEN=123456789:ABCDefghIJKLmnopQRSTuvwxYZ
TELEGRAM_CHAT_ID=-1001234567890
