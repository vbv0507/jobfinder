# RoleNova v2.0 - Environment Configuration
# Copy this file to .env and fill in the values

# ---------------------------------------------------------
# Server Configuration
# ---------------------------------------------------------
NODE_ENV=development
PORT=5000
SYSTEM_INTERNAL_SECRET=your_internal_secret_here

# ---------------------------------------------------------
# Redis (optional; required for shared cache and distributed locks)
# Use the TLS connection URL supplied by Upstash, Azure Cache for Redis, etc.
# REDIS_URL=rediss://default:password@your-redis-host:6379

# Rendered HTML fallback limits. These keep stalled career pages bounded.
RENDERED_PAGE_TIMEOUT_MS=20000
RENDERED_PAGE_SETTLE_MS=1200

# ---------------------------------------------------------
# Database
# ---------------------------------------------------------
MONGO_URI=mongodb+srv://user:pass@cluster.mongodb.net/roledb

# ---------------------------------------------------------
# Clerk Authentication
# ---------------------------------------------------------
CLERK_PUBLISHABLE_KEY=pk_test_your_clerk_key_here

# ---------------------------------------------------------
# AI Models (Gemini / Groq / Z.ai)
# ---------------------------------------------------------
GEMINI_API_KEY=your_gemini_key
GEMINI_MODEL=gemini-2.0-flash

GROQ_API_KEY=your_groq_key
GROQ_MODEL=llama-3.3-70b-versatile
ENABLE_GROQ_FALLBACK=true

ZAI_API_KEY=your_zai_key
ZAI_BASE_URL=https://api.z.ai/api/paas/v4/chat/completions
ZAI_MODEL=glm-4.5-air
ENABLE_ZAI_FALLBACK=true

DEEPSEEK_API_KEY=your_deepseek_key
DEEPSEEK_MODEL=deepseek-v4-flash
DEEPSEEK_BASE_URL=https://api.deepseek.com
ENABLE_DEEPSEEK_FALLBACK=true

ENABLE_LOCAL_MATCH_FALLBACK=true

# ---------------------------------------------------------
# Pipeline Configuration
# ---------------------------------------------------------
SEED_COMPANIES_ON_START=true
RUN_SEARCH_ON_START=false
# Set to false on Render: GitHub Actions will run pipeline, digest, and Telegram polling.
BACKGROUND_JOBS_ENABLED=true
MAX_JOBS_PER_COMPANY=10
MATCH_THRESHOLD=70
STRICT_LOCATION_MATCH=true

# ---------------------------------------------------------
# Email Notifications (Optional)
# ---------------------------------------------------------
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_app_password
EMAIL_TO=recipient@gmail.com

# ---------------------------------------------------------
# Telegram Bot & Diagnostics (Optional)
# ---------------------------------------------------------
TELEGRAM_API_ID=1234567
TELEGRAM_API_HASH=your_api_hash
TELEGRAM_SESSION=your_session_string

TELEGRAM_HEALTH_ENABLED=true
TELEGRAM_HEALTH_COMMAND=#RN_HEALTH
TELEGRAM_HEALTH_ALLOWED_USERS=your_telegram_username

TELEGRAM_TEST_MODE=false
TELEGRAM_TEST_CHANNEL=your_test_channel
# GitHub Actions polling limit per channel. TelegramSyncState prevents duplicates.
TELEGRAM_POLL_MESSAGE_LIMIT=200
