PORT=3000
MONGO_URI=mongodb://localhost:27017/jobfinder
GEMINI_API_KEY=your_gemini_api_key
GEMINI_MODEL=gemini-2.5-flash
GROQ_API_KEY=your_groq_api_key
GROQ_MODEL=llama-3.3-70b-versatile
ENABLE_GROQ_FALLBACK=true
ZAI_API_KEY=your_zai_api_key
ZAI_MODEL=glm-4-plus
ZAI_BASE_URL=https://api.z.ai/v1
ENABLE_ZAI_FALLBACK=true
ENABLE_LOCAL_MATCH_FALLBACK=true
TELEGRAM_API_ID=your_telegram_api_id
TELEGRAM_API_HASH=your_telegram_api_hash
TELEGRAM_SESSION=your_telegram_session_string

# Telegram Health Check Configuration
TELEGRAM_HEALTH_ENABLED=true
TELEGRAM_HEALTH_COMMAND=#RN_HEALTH
TELEGRAM_HEALTH_ALLOWED_USERS=123456789,987654321
